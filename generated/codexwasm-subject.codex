   in let st21 = st-append-code st20 (add-ri reg-rsi 1)
   in let st22 = st-append-code st21 (jmp (cmp-loop - (st21.code-len + 5)))
   in let st23 = patch-jcc-at st22 matched-pos (st22.code-len)
   in TextSplitHead {
    cg = st23,
    done-pos = scan-done-pos,
    nd1 = zero-pos,
    nd2 = over-pos,
    nd3 = mism-pos
   }

  emit-text-split-emit-seg : CodegenState, Integer -> CodegenState
  emit-text-split-emit-seg (st) (scan-loop) =
    let st0 = st-append-code st (mov-rr reg-rax reg-r11)
   in let st1 = st-append-code st0 (sub-rr reg-rax reg-rcx)
   in let st2 = st-append-code st1 (mov-rr reg-rdi reg-r10)
   in let st3 = st-append-code st2 (mov-store reg-rdi reg-rax 0)
   in let st4 = st-append-code st3 (push-r reg-rax)
   in let st5 = st-append-code st4 (add-ri reg-rax 15)
   in let st6 = st-append-code st5 (and-ri reg-rax (-8))
   in let st7 = heap-bump-reg st6 reg-rax
   in let st8 = st-append-code st7 (pop-r reg-rax)
   in let st9 = st-append-code st8 (push-r reg-r11)
   in st-append-code st9 (li reg-rsi 0)

  emit-text-split-seg-copy : CodegenState, Integer -> CodegenState
  emit-text-split-seg-copy (st) (scan-loop) =
    let seg-copy = st.code-len
   in let st0 = st-append-code st (cmp-rr reg-rsi reg-rax)
   in let seg-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-ge 0)
   in let st2 = st-append-code st1 (mov-rr reg-rdx reg-rbx)
   in let st3 = st-append-code st2 (add-rr reg-rdx reg-rcx)
   in let st4 = st-append-code st3 (add-rr reg-rdx reg-rsi)
   in let st5 = st-append-code st4 (movzx-byte reg-rdx reg-rdx 8)
   in let st6 = st-append-code st5 (mov-rr reg-r11 reg-rdi)
   in let st7 = st-append-code st6 (add-rr reg-r11 reg-rsi)
   in let st8 = st-append-code st7 (mov-store-byte reg-r11 reg-rdx 8)
   in let st9 = st-append-code st8 (add-ri reg-rsi 1)
   in let st10 = st-append-code st9 (jmp (seg-copy - (st9.code-len + 5)))
   in let st11 = patch-jcc-at st10 seg-done-pos (st10.code-len)
   in let st12 = st-append-code st11 (pop-r reg-r11)
   in let st13 = st-append-code st12 (mov-rr reg-rax reg-r15)
   in let st14 = st-append-code st13 (shl-ri reg-rax 3)
   in let st15 = st-append-code st14 (add-rr reg-rax reg-r14)
   in let st16 = st-append-code st15 (mov-store reg-rax reg-rdi 8)
   in let st17 = st-append-code st16 (add-ri reg-r15 1)
   in let st17a = st-append-code st17 (mov-load reg-rdx reg-r13 0)
   in let st18 = st-append-code st17a (add-rr reg-r11 reg-rdx)
   in st-append-code st18 (mov-rr reg-rcx reg-r11)

  emit-text-split-not-delim : CodegenState, TextSplitHead, Integer -> CodegenState
  emit-text-split-not-delim (st) (head) (scan-loop) =
    let st0 = st-append-code st (jmp (scan-loop - (st.code-len + 5)))
   in let st1 = patch-jcc-at (patch-jcc-at (patch-jcc-at st0 (head.nd1) (st0.code-len)) (head.nd2) (st0.code-len)) (head.nd3) (st0.code-len)
   in let st2 = st-append-code st1 (add-ri reg-r11 1)
   in st-append-code st2 (jmp (scan-loop - (st2.code-len + 5)))

  emit-text-split-final-seg : CodegenState, Integer -> CodegenState
  emit-text-split-final-seg (st) (scan-done-pos) =
    let st0 = patch-jcc-at st scan-done-pos (st.code-len)
   in let st1 = st-append-code st0 (mov-rr reg-rax reg-r12)
   in let st2 = st-append-code st1 (sub-rr reg-rax reg-rcx)
   in let st3 = st-append-code st2 (mov-rr reg-rdi reg-r10)
   in let st4 = st-append-code st3 (mov-store reg-rdi reg-rax 0)
   in let st5 = st-append-code st4 (push-r reg-rax)
   in let st6 = st-append-code st5 (add-ri reg-rax 15)
   in let st7 = st-append-code st6 (and-ri reg-rax (-8))
   in let st8 = heap-bump-reg st7 reg-rax
   in st-append-code st8 (pop-r reg-rax)

  emit-text-split-final-copy : CodegenState -> CodegenState
  emit-text-split-final-copy (st) =
    let st0 = st-append-code st (li reg-rsi 0)
   in let last-copy = st0.code-len
   in let st1 = st-append-code st0 (cmp-rr reg-rsi reg-rax)
   in let last-done-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-ge 0)
   in let st3 = st-append-code st2 (mov-rr reg-rdx reg-rbx)
   in let st4 = st-append-code st3 (add-rr reg-rdx reg-rcx)
   in let st5 = st-append-code st4 (add-rr reg-rdx reg-rsi)
   in let st6 = st-append-code st5 (movzx-byte reg-rdx reg-rdx 8)
   in let st7 = st-append-code st6 (mov-rr reg-r11 reg-rdi)
   in let st8 = st-append-code st7 (add-rr reg-r11 reg-rsi)
   in let st9 = st-append-code st8 (mov-store-byte reg-r11 reg-rdx 8)
   in let st10 = st-append-code st9 (add-ri reg-rsi 1)
   in let st11 = st-append-code st10 (jmp (last-copy - (st10.code-len + 5)))
   in patch-jcc-at st11 last-done-pos (st11.code-len)

  emit-text-split-epilogue : CodegenState -> CodegenState
  emit-text-split-epilogue (st) =
    let st0 = st-append-code st (mov-rr reg-rax reg-r15)
   in let st1 = st-append-code st0 (shl-ri reg-rax 3)
   in let st2 = st-append-code st1 (add-rr reg-rax reg-r14)
   in let st3 = st-append-code st2 (mov-store reg-rax reg-rdi 8)
   in let st4 = st-append-code st3 (add-ri reg-r15 1)
   in let st5 = st-append-code st4 (mov-store reg-r14 reg-r15 0)
   in let st6 = st-append-code st5 (mov-rr reg-rax reg-r14)
   in let st7 = st-append-code st6 (pop-r reg-r15)
   in let st8 = st-append-code st7 (pop-r reg-r14)
   in let st9 = st-append-code st8 (pop-r reg-r13)
   in let st10 = st-append-code st9 (pop-r reg-r12)
   in let st11 = st-append-code st10 (pop-r reg-rbx)
   in st-append-code st11 x86-ret

  emit-text-split : CodegenState -> CodegenState
  emit-text-split (st) =
    let st0 = emit-text-split-prologue st
   in let scan-loop = st0.code-len
   in let head = emit-text-split-scan-head st0
   in let st1 = emit-text-split-emit-seg (head.cg) scan-loop
   in let st2 = emit-text-split-seg-copy st1 scan-loop
   in let st3 = emit-text-split-not-delim st2 head scan-loop
   in let st4 = emit-text-split-final-seg st3 (head.done-pos)
   in let st5 = emit-text-split-final-copy st4
   in emit-text-split-epilogue st5

