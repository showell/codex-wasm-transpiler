Chapter: Parsmi--Severity

Section: Constants
  sev-error : Integer = 0

  sev-warning : Integer = 1

  sev-info : Integer = 2

  sev-hint : Integer = 3

  sev-deprecated : Integer = 4

Section: Display
  severity-label : Integer -> Text
  severity-label (s) =
   if s == sev-error then "error"
   else if s == sev-warning then "warning"
   else if s == sev-info then "info"
   else if s == sev-hint then "hint"
   else if s == sev-deprecated then "deprecated"
   else "unknown"

Page 1


Chapter: Parsmi--Source Text

Section: Provenance
  Provenance =
   | ProvParsed
   | ProvDesugared
   | ProvSynthetic

Section: Types
  SourcePosition = record {
   line : Integer between 0 and 131071,
   column : Integer between 0 and 4294967295,
   offset : Integer between 0 and 4294967295
  }

  SourceSpan = record {
   start : SourcePosition,
   end : SourcePosition,
   file-id : Integer between 0 and 65535,
   provenance : Provenance
  }

  FileTable = record {
   names : List Text
  }

Section: File Table
  empty-file-table : FileTable
  empty-file-table =
   FileTable {
    names = []
   }

  file-table-add : FileTable, Text -> FileTable
  file-table-add (table) (name) =
   FileTable {
    names = list-push (table.names) name
   }

  file-table-name : FileTable, Integer -> Text
  file-table-name (table) (id) =
   if id <= 0 then ""
   else if id > list-length (table.names) then ""
   else list-at (table.names) (id - 1)

  file-table-count : FileTable -> Integer
  file-table-count (table) =
   list-length (table.names)

Section: Positions and Spans
  make-position : Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295 -> SourcePosition
  make-position (line) (col) (offset) =
   deck-record (SourcePosition {
    line = line,
    column = col,
    offset = offset
   })

  make-span : SourcePosition, SourcePosition, Integer between 0 and 65535, Provenance -> SourceSpan
  make-span (s) (e) (fid) (prov) =
   deck-record (SourceSpan {
    start = s,
    end = e,
    file-id = fid,
    provenance = prov
   })

  span-length : SourceSpan -> Integer
  span-length (span) =
   span.end.offset - span.start.offset

  synthetic-span : SourceSpan
  synthetic-span =
   SourceSpan {
    start = SourcePosition { line = 0, column = 0, offset = 0 },
    end = SourcePosition { line = 0, column = 0, offset = 0 },
    file-id = 0,
    provenance = ProvSynthetic
   }

  is-synthetic-span : SourceSpan -> Boolean
  is-synthetic-span (span) =
   span.file-id == 0

  span-at : Integer between 0 and 131071, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 4294967295, Integer between 0 and 65535 -> SourceSpan
  span-at (line) (col) (offset) (len) (fid) =
   let start = make-position line col offset
   in let stop = make-position line (col + len) (offset + len)
   in make-span start stop fid ProvParsed

  span-with-provenance : SourceSpan, Provenance -> SourceSpan
  span-with-provenance (span) (prov) =
   deck-record (SourceSpan {
    start = span.start,
    end = span.end,
    file-id = span.file-id,
    provenance = prov
   })

Section: Display
  span-display : SourceSpan, FileTable -> Text
  span-display (span) (table) =
   if is-synthetic-span span then ""
   else let name = file-table-name table (span.file-id)
    in (if name == "" then "" else name & ":")
       & integer-to-text (span.start.line) & ":" & integer-to-text (span.start.column)

Page 1


Chapter: Parsmi--Name

Section: Types
  Name = record {
   value : Text
  }

Section: Functions
  make-name : Text -> Name
  make-name (s) =
   Name { value = s }

  name-value : Name -> Text
  name-value (n) =
   n.value

Section: Entry Point
  opening-entry-point : Text = "opening"

Page 1



Chapter: Parsmi--Diagnostics

Section: Type
  Diagnostic = record {
   code : Integer between 0 and 65535,
   message : Text,
   severity : Integer between 0 and 4,
   span : SourceSpan,
   related-spans : List SourceSpan
  }

Section: Constructors

 The `message` field is passed through `substring` so its bytes are
 freshly allocated inside the surrounding `deck-record` region. Many
 emit-time call sites build the message with `&` in a per-function
 bivy that is reclaimed by `__heap-restore` before the bag is merged;
 storing the bivy pointer would leave a dangling Text behind.

  make-diagnostic : Integer between 0 and 4, Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-diagnostic (sev) (code) (msg) (span) =
   deck-record (Diagnostic {
    code = code,
    message = substring msg 0 (text-length msg),
    severity = sev,
    span = span,
    related-spans = []
   })

  make-error : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-error (code) (msg) (span) = make-diagnostic sev-error code msg span

  make-warning : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-warning (code) (msg) (span) = make-diagnostic sev-warning code msg span

  make-info : Integer between 0 and 65535, Text, SourceSpan -> Diagnostic
  make-info (code) (msg) (span) = make-diagnostic sev-info code msg span

  make-error-related : Integer between 0 and 65535, Text, SourceSpan, List SourceSpan -> Diagnostic
  make-error-related (code) (msg) (span) (related) =
   deck-record (Diagnostic {
    code = code,
    message = substring msg 0 (text-length msg),
    severity = sev-error,
    span = span,
    related-spans = related
   })

Section: Display
  format-cdx-code : Integer -> Text
  format-cdx-code (n) = "CDX" & integer-to-text-padded n 4

  diagnostic-display : Diagnostic, FileTable -> Text
  diagnostic-display (d) (table) =
   let loc = span-display (d.span) table
   in let prefix = if loc == "" then "" else loc & ": "
   in prefix & severity-label (d.severity) & " " & format-cdx-code (d.code) & ": " & d.message

Page 1


Chapter: Parsmi--Diagnostic Bag
  cites Codex chapter Build Settings (max-errors)

Section: Type
  DiagnosticBag = record {
   diagnostics : List Diagnostic,
   error-count : Integer between 0 and 255,
   truncated : Boolean
  }

Section: Constructors
  empty-bag : DiagnosticBag
  empty-bag =
   DiagnosticBag {
    diagnostics = [],
    error-count = 0,
    truncated = False
   }

  bag-from-list : List Diagnostic -> DiagnosticBag
  bag-from-list (ds) =
   bag-from-list-loop empty-bag ds 0 (list-length ds)

  bag-from-list-loop : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
  bag-from-list-loop (bag) (ds) (i) (len) =
   if i == len then bag
   else bag-from-list-loop (bag-add bag (list-at ds i)) ds (i + 1) len

Section: Add

 The bag survives across phase compacts (per-function `__heap-restore`
 in the emitter, frontend phase compacts), so every cons cell in
 `diagnostics` and the bag record itself must live on the deck. The
 `deck-record` wraps below force the surrounding scope to allocate
 the new list cell + record into deck rather than the caller's bivy.

  bag-add : DiagnosticBag, Diagnostic -> DiagnosticBag
  bag-add (bag) (d) =
   if d.severity == sev-error then bag-add-error bag d
   else deck-record (DiagnosticBag {
    diagnostics = deck-record (list-push (bag.diagnostics) d),
    error-count = bag.error-count,
    truncated = bag.truncated
   })

  bag-add-error : DiagnosticBag, Diagnostic -> DiagnosticBag
  bag-add-error (bag) (d) =
   if bag.error-count >= max-errors then
    if bag.truncated then bag
    else deck-record (DiagnosticBag {
     diagnostics = deck-record (list-push (bag.diagnostics) (make-error cdx-too-many-errors "Too many errors. Further errors suppressed." synthetic-span)),
     error-count = bag.error-count + 1,
     truncated = True
    })
   else deck-record (DiagnosticBag {
    diagnostics = deck-record (list-push (bag.diagnostics) d),
    error-count = bag.error-count + 1,
    truncated = bag.truncated
   })

  bag-concat : DiagnosticBag, List Diagnostic -> DiagnosticBag
  bag-concat (bag) (ds) =
   bag-concat-loop bag ds 0 (list-length ds)

  bag-concat-loop : DiagnosticBag, List Diagnostic, Integer, Integer -> DiagnosticBag
  bag-concat-loop (bag) (ds) (i) (len) =
   if i == len then bag
   else bag-concat-loop (bag-add bag (list-at ds i)) ds (i + 1) len

  bag-merge : DiagnosticBag, DiagnosticBag -> DiagnosticBag
  bag-merge (bag) (other) =
   bag-concat bag (other.diagnostics)

  bag-merge-all : List DiagnosticBag -> DiagnosticBag
  bag-merge-all (bags) =
   bag-merge-all-loop empty-bag bags 0 (list-length bags)

  bag-merge-all-loop : DiagnosticBag, List DiagnosticBag, Integer, Integer -> DiagnosticBag
  bag-merge-all-loop (acc) (bags) (i) (len) =
   if i == len then acc
   else bag-merge-all-loop (bag-merge acc (list-at bags i)) bags (i + 1) len

Section: Queries
  bag-has-errors : DiagnosticBag -> Boolean
  bag-has-errors (bag) =
   bag.error-count > 0

  bag-diagnostics : DiagnosticBag -> List Diagnostic
  bag-diagnostics (bag) =
   bag.diagnostics

  bag-errors : DiagnosticBag -> List Diagnostic
  bag-errors (bag) =
   bag-errors-loop (bag.diagnostics) [] 0 (list-length (bag.diagnostics))

  bag-errors-loop : List Diagnostic, List Diagnostic, Integer, Integer -> List Diagnostic
  bag-errors-loop (ds) (acc) (i) (len) =
   if i == len then acc
   else let d = list-at ds i
    in if d.severity == sev-error
        then bag-errors-loop ds (list-push acc d) (i + 1) len
        else bag-errors-loop ds acc (i + 1) len

  bag-has-code : DiagnosticBag, Integer -> Boolean
  bag-has-code (bag) (code) =
   bag-has-code-loop (bag.diagnostics) code 0 (list-length (bag.diagnostics))

  bag-has-code-loop : List Diagnostic, Integer, Integer, Integer -> Boolean
  bag-has-code-loop (ds) (code) (i) (len) =
   if i == len then False
   else if (list-at ds i).code == code then True
   else bag-has-code-loop ds code (i + 1) len

  bag-is-truncated : DiagnosticBag -> Boolean
  bag-is-truncated (bag) =
   bag.truncated

Page 1


Chapter: Parsmi--Collections
  cites Foreword chapter ListUtils

Section: Binary Search -- Text Keys (lower bound)
  bsearch-text-pos : List TypeBinding, Text, Integer, Integer -> Integer
  bsearch-text-pos (bindings) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in let mid-name = (list-at bindings mid).name
   in if text-compare name mid-name <= 0 then bsearch-text-pos bindings name lo mid
      else bsearch-text-pos bindings name (mid + 1) hi

Section: Binary Search -- Text Set (lower bound)
  bsearch-text-set : List Text, Text, Integer, Integer -> Integer
  bsearch-text-set (names) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in if text-compare name (list-at names mid) <= 0 then bsearch-text-set names name lo mid
      else bsearch-text-set names name (mid + 1) hi

  text-set-has : List Text, Text -> Boolean
  text-set-has (names) (name) =
   let len = list-length names
   in let pos = bsearch-text-set names name 0 len
   in if pos >= len then False
      else list-at names pos == name

  text-set-insert : List Text, Text -> List Text
  text-set-insert (names) (name) =
   let len = list-length names
   in let pos = bsearch-text-set names name 0 len
   in if pos < len then
     if list-at names pos == name then names
     else list-insert-at names pos name
   else list-insert-at names pos name

Page 1



Chapter: Parsmi--Codex Types

Section: Primitive Types
  CodexType =
   | IntegerTy (Integer) (Integer) (OverflowMode)
   | RealTy (RealWidth) (RealMode)
   | TextTy
   | BooleanTy
   | CharTy
   | VoidTy
   | NothingTy
   | ErrorTy
   | NoExpectTy
   | FunTy (CodexType) (EffectRow) (CodexType)
   | ListTy (CodexType)
   | LinkedListTy (CodexType)
   | TypeVar (Integer between 0 and 4294967295)
   | ForAllTy (Integer between 0 and 4294967295) (CodexType)
   | SumTy (Name) (List CodexType) (List SumCtor)
   | RecordTy (Name) (List CodexType) (List RecordField)
   | ConstructedTy (Name) (List CodexType)
   | EffectfulTy (List Name) (List Text) (CodexType)
   | ProofTy
   | PropEqTy (CodexType) (CodexType)
   | UnitTy (Name) (CodexType)
   | VectorTy (Integer) (CodexType)
   | VectorMaskTy (Integer)
   | TypeCon (Name)
   | TypeApply (CodexType) (CodexType)
   | ForAllEff (Integer between 0 and 4294967295) (CodexType)
   | LinearTy (CodexType)

  SumCtor = record {
   name : Name,
   fields : List CodexType,
   return-type : List CodexType
  }

  RecordField = record {
   name : Name,
   type-val : CodexType
  }

Section: Effect Rows

 The effect row on an arrow. A row is a set of effect
 labels plus an optional row variable. tail-name is the source-level
 lowercase identifier, "" when the row was not written with a tail.
 tail-id is the numeric row-variable id: -1 means no id (a closed
 row, or a source tail not yet parameterized); ids at 0 and above are
 assigned at signature parameterization from the unifier's shared
 32-bit counter, bound under a ForAllEff binder, freshened at
 instantiation, and solved against the unifier's row-substitution
 table. Rows are deliberately not CodexTypes: a type position can
 never resolve to a row, so a kind confusion is unrepresentable.
 Labels are kept name-then-scope sorted and duplicate-free by
 construction; rows are idempotent sets, never multisets. Through
 stage 2 rows remain inert -- concrete effects still ride in
 EffectfulTy until stage 3 migrates them onto the arrow and enforces
 the row at declared boundaries. All pure arrows share the single
 interned empty-row; do not allocate a fresh empty row per arrow.

  EffectLabel = record {
   name : Name,
   scope : Text
  }

  EffectRow = record {
   labels : List EffectLabel,
   tail-name : Text,
   tail-id : Integer between -1 and 4294967295
  }

  empty-row : EffectRow = EffectRow { labels = [], tail-name = "", tail-id = __narrow (-1) }

  tail-only-row : Text -> EffectRow
  tail-only-row (name) = EffectRow { labels = [], tail-name = name, tail-id = __narrow (-1) }

  row-var : Integer -> EffectRow
  row-var (id) = EffectRow { labels = [], tail-name = "", tail-id = __narrow id }

  concrete-row : Text -> EffectRow
  concrete-row (name) = EffectRow { labels = [EffectLabel { name = Name { value = name }, scope = "" }], tail-name = "", tail-id = __narrow (-1) }

  row-with-tail-id : EffectRow, Integer -> EffectRow
  row-with-tail-id (row) (id) = EffectRow { labels = row.labels, tail-name = row.tail-name, tail-id = __narrow id }

  row-is-empty : EffectRow -> Boolean
  row-is-empty (row) = list-length (row.labels) == 0 & text-length (row.tail-name) == 0 & row.tail-id < 0

  row-is-open : EffectRow -> Boolean
  row-is-open (row) = row.tail-id >= 0

Section: Overflow Modes

  OverflowMode =
   | OvError
   | OvWrapping
   | OvClamping

Section: Real Width And Mode

 RmDefault is IEEE 754: an overflow yields an infinity and a caller who
 wants to know must ask. RmTrapping halts instead. RmSaturating clamps
 to the largest finite value of the width, so the answer stays a number
 the next operation can use.

  RealWidth =
   | RwF64
   | RwF32

  RealMode =
   | RmDefault
   | RmTrapping
   | RmSaturating

  real-f64 : CodexType = RealTy RwF64 RmDefault
  real-f32 : CodexType = RealTy RwF32 RmDefault
  real-f64-trapping : CodexType = RealTy RwF64 RmTrapping
  real-f64-saturating : CodexType = RealTy RwF64 RmSaturating
  real-f32-trapping : CodexType = RealTy RwF32 RmTrapping
  real-f32-saturating : CodexType = RealTy RwF32 RmSaturating

Section: Integer Bounds
  i64-max : Integer = 9223372036854775807

  i64-min : Integer = 0 - 9223372036854775807 - 1

  int-ty-default : CodexType = IntegerTy i64-min i64-max OvError

Section: Unit Stripping

  strip-unit-ty : CodexType -> CodexType
  strip-unit-ty (ty) =
   when ty
    is UnitTy (n) (inner) -> strip-unit-ty inner
    is otherwise -> ty

Section: Overflow Mode Classification

  int-ty-wraps : CodexType -> Boolean
  int-ty-wraps (ty) =
   when ty
    is IntegerTy (lo) (hi) (m) -> ov-mode-wraps m
    is UnitTy (n) (inner) -> int-ty-wraps inner
    is otherwise -> False

  ov-mode-wraps : OverflowMode -> Boolean
  ov-mode-wraps (m) =
   when m
    is OvWrapping -> True
    is otherwise -> False



  is-real-type : CodexType -> Boolean
  is-real-type (ty) =
   when ty
    is RealTy (w) (m) -> True
    is otherwise -> False

  is-real-f32 : CodexType -> Boolean
  is-real-f32 (ty) =
   when ty
    is RealTy (w) (m) -> is-width-f32 w
    is otherwise -> False

  is-width-f32 : RealWidth -> Boolean
  is-width-f32 (w) =
   when w
    is RwF32 -> True
    is otherwise -> False

  real-mode-of : CodexType -> RealMode
  real-mode-of (ty) =
   when ty
    is RealTy (w) (m) -> m
    is otherwise -> RmDefault

  real-width-of : CodexType -> RealWidth
  real-width-of (ty) =
   when ty
    is RealTy (w) (m) -> w
    is otherwise -> RwF64

  real-width-eq : RealWidth, RealWidth -> Boolean
  real-width-eq (a) (b) = is-width-f32 a == is-width-f32 b

  real-mode-eq : RealMode, RealMode -> Boolean
  real-mode-eq (a) (b) = real-mode-rank a == real-mode-rank b

  real-mode-rank : RealMode -> Integer
  real-mode-rank (m) =
   when m
    is RmDefault -> 0
    is RmTrapping -> 1
    is RmSaturating -> 2

  real-mode-is-trapping : RealMode -> Boolean
  real-mode-is-trapping (m) =
   when m
    is RmTrapping -> True
    is otherwise -> False

  real-mode-is-saturating : RealMode -> Boolean
  real-mode-is-saturating (m) =
   when m
    is RmSaturating -> True
    is otherwise -> False

Section: Pointer Classification

 Whether a runtime value of this type is a heap pointer (True) or an
 inline scalar (False). The foundation for precise pointer-maps: the
 escape check, dead-deck reclamation, and a copying compactor all need
 to know which record/ctor slots hold pointers vs raw values.

 Scalars are stored inline: Integer (1/2/4/8 bytes by bounds), Boolean
 (1), Char and Number (8, but not pointers). Everything heap-allocated
 is an 8-byte pointer. Nullary ctors are heap-boxed too (emit-nullary-ctor
 allocates 8 bytes and stores the tag), so ALL SumTy values are pointers.
 EffectfulTy, ForAllTy, ForAllEff, and LinearTy classify by their
 underlying value type. LinearTy is the stage-1 ownership marker:
 it survives resolution so later stages
 can read declared linearity, but it is representation-transparent
 everywhere -- width, layout, unification, and the IR wire all see
 the inner type.

  is-pointer-type : CodexType -> Boolean
  is-pointer-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) | RealTy (rw) (rm) | BooleanTy | CharTy | VoidTy | NothingTy | ErrorTy | NoExpectTy | ProofTy | PropEqTy (a) (b) -> False
    is TextTy | ListTy (e) | LinkedListTy (e) | RecordTy (n) (a) (f) | SumTy (n) (a) (c) | ConstructedTy (n) (a) | FunTy (p) (row) (r) | VectorTy (vn) (vt) | VectorMaskTy (mn) -> True
    is EffectfulTy (e) (s) (r) -> is-pointer-type r
    is ForAllTy (i) (b) -> is-pointer-type b
    is ForAllEff (i) (b) -> is-pointer-type b
    is TypeVar (i) -> True
    is UnitTy (n) (inner) -> is-pointer-type inner
    is TypeCon (n) -> False
    is TypeApply (f) (a) -> True
    is LinearTy (inner) -> is-pointer-type inner

Page 1



Chapter: Parsmi--CodexType Helpers

Section: Function-Type Peeling
  peel-fun-param : CodexType -> CodexType
  peel-fun-param (ty) =
   when ty
    is FunTy (p) (row) (r) -> p
    is ForAllTy (id) (body) -> peel-fun-param body
    is ForAllEff (id) (body) -> peel-fun-param body
    is otherwise -> ErrorTy

  peel-fun-return : CodexType -> CodexType
  peel-fun-return (ty) =
   when ty
    is FunTy (p) (row) (r) -> r
    is ForAllTy (id) (body) -> peel-fun-return body
    is ForAllEff (id) (body) -> peel-fun-return body
    is otherwise -> ErrorTy

  strip-fun-args : CodexType -> CodexType
  strip-fun-args (ty) =
   when ty
    is FunTy (p) (row) (r) -> strip-fun-args r
    is ForAllTy (id) (body) -> strip-fun-args body
    is ForAllEff (id) (body) -> strip-fun-args body
    is otherwise -> ty

  peel-applied-return : CodexType, Integer -> CodexType
  peel-applied-return (ty) (k) =
   if k <= 0 then ty
   else when ty
    is FunTy (p) (row) (r) -> peel-applied-return r (k - 1)
    is ForAllTy (id) (body) -> peel-applied-return body k
    is ForAllEff (id) (body) -> peel-applied-return body k
    is otherwise -> ty

  strip-forall-ty : CodexType -> CodexType
  strip-forall-ty (ty) =
   when ty
    is ForAllTy (id) (body) -> strip-forall-ty body
    is ForAllEff (id) (body) -> strip-forall-ty body
    is otherwise -> ty

Section: Linearity Marker

  strip-linear-ty : CodexType -> CodexType
  strip-linear-ty (ty) =
   when ty
    is LinearTy (inner) -> strip-linear-ty inner
    is otherwise -> ty

Section: Hardware Integer Width
  HwIntWidth =
   | HwU8
   | HwU16
   | HwU32
   | HwU64
   | HwI8
   | HwI16
   | HwI32
   | HwI64

  hw-width-bytes : HwIntWidth -> Integer
  hw-width-bytes (w) =
   when w
    is HwU8  | HwI8  -> 1
    is HwU16 | HwI16 -> 2
    is HwU32 | HwI32 -> 4
    is HwU64 | HwI64 -> 8

  hw-width-signed : HwIntWidth -> Boolean
  hw-width-signed (w) =
   when w
    is HwU8 | HwU16 | HwU32 | HwU64 -> False
    is HwI8 | HwI16 | HwI32 | HwI64 -> True

  bounds-to-hw-width : Integer, Integer -> HwIntWidth
  bounds-to-hw-width (lo) (hi) =
   if lo >= 0 then
    if hi <= 255                  then HwU8
    else if hi <= 65535           then HwU16
    else if hi <= 4294967295      then HwU32
    else                               HwU64
   else
    if lo >= (0 - 128)        & hi <= 127        then HwI8
    else if lo >= (0 - 32768) & hi <= 32767      then HwI16
    else if lo >= (0 - 2147483648) & hi <= 2147483647 then HwI32
    else                                              HwI64

 u64's exact band is not writable: its hi is past the signed 64-bit
 literal range. i64's is.

  bounds-are-hw-width : Integer, Integer -> Boolean
  bounds-are-hw-width (lo) (hi) =
   when bounds-to-hw-width lo hi
    is HwU8  -> lo == 0 & hi == 255
    is HwI8  -> lo == (0 - 128) & hi == 127
    is HwU16 -> lo == 0 & hi == 65535
    is HwI16 -> lo == (0 - 32768) & hi == 32767
    is HwU32 -> lo == 0 & hi == 4294967295
    is HwI32 -> lo == (0 - 2147483648) & hi == 2147483647
    is HwI64 -> lo == i64-min & hi == i64-max
    is HwU64 -> False

  integer-ty-hw-width : CodexType -> HwIntWidth
  integer-ty-hw-width (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> bounds-to-hw-width lo hi
    is UnitTy (name) (inner) -> integer-ty-hw-width inner
    is LinearTy (inner) -> integer-ty-hw-width inner
    is otherwise -> HwI64

