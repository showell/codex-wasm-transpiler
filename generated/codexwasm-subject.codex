   in let st10 = st-append-code st9 (cmp-ri reg-rax 13)
   in let skip-cr = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-e 0)
   in let st12 = st-append-code st11 (cmp-ri reg-rax 128)
   in let skip-high = st12.code-len
   in let st13 = st-append-code st12 (jcc cc-ge 0)
   in let st14 = st-append-code st13 (add-rr reg-rax reg-r12)
   in let st15 = st-append-code st14 (movzx-byte reg-rax reg-rax 0)
   in let store-pos = st15.code-len
   in let st16 = st-append-code st15 (mov-rr reg-rsi reg-rbx)
   in let st17 = st-append-code st16 (add-rr reg-rsi reg-rcx)
   in let st18 = st-append-code st17 (add-ri reg-rsi 8)
   in let st19 = st-append-code st18 [136, 6]
   in let st20 = st-append-code st19 (add-ri reg-rcx 1)
   in let st21 = patch-jcc-at st20 skip-cr (st20.code-len)
   in let st22 = patch-jcc-at st21 skip-high store-pos
