   "          (local.set $digit (i32.wrap_i64 (i64.sub (i64.const 0) (i64.rem_s (local.get $abs) (i64.const 10)))))\n" &
   "          (i32.store8 (local.get $pos) (i32.add (local.get $digit) (i32.const " & integer-to-text cce-digit-zero & ")))\n" &
   "          (local.set $pos (i32.sub (local.get $pos) (i32.const 1)))\n" &
   "          (local.set $abs (i64.div_s (local.get $abs) (i64.const 10)))\n" &
   "          (br $digits)))))\n" &
   "    (if (local.get $neg) (then\n" &
   "        (i32.store8 (local.get $pos) (i32.const " & integer-to-text cce-minus & "))\n" &
   "        (local.set $pos (i32.sub (local.get $pos) (i32.const 1)))))\n" &
   "    (local.set $numlen (i32.sub (i32.add (local.get $buf) (i32.const 24)) (i32.add (local.get $pos) (i32.const 1))))\n" &
   "    (local.set $result (call $bump_alloc (i32.add (local.get $numlen) (i32.const 4))))\n" &
   "    (i32.store (local.get $result) (local.get $numlen))\n" &
   "    (local.set $idx (i32.const 0))\n" &
   "    (block $cpd (loop $cpl\n" &
   "      (br_if $cpd (i32.ge_s (local.get $idx) (local.get $numlen)))\n" &
   "      (i32.store8 (i32.add (i32.add (local.get $result) (i32.const 4)) (local.get $idx))\n" &
   "        (i32.load8_u (i32.add (i32.add (local.get $pos) (i32.const 1)) (local.get $idx))))\n" &
   "      (local.set $idx (i32.add (local.get $idx) (i32.const 1)))\n" &
   "      (br $cpl)))\n" &
   "    (i64.extend_i32_u (local.get $result)))\n\n"

 The oracle is `__real_to_text`, `codex/compiler/Emit/X86_64TextHelpers.codex:590`,
 and the FORMAT is the part that has to match rather than the arithmetic: at most
 fifteen fractional digits, trailing zeros stripped down to one, always a dot and
 always a digit after it. The two diverge above 2^63, where `cvttsd2si` answers
 the integer indefinite and `i64.trunc_sat_f64_s` saturates; no `.expected` in the
 corpus spells a value that large.

  wat-rt-f64-to-text : Text =
   "  (func $__f64_to_text (param $bits i64) (result i64)\n" &
   "    (local $neg i32) (local $mag i64) (local $x f64) (local $frac f64)\n" &
   "    (local $ip i64) (local $ibuf i32) (local $ic i32) (local $fbuf i32) (local $fc i32)\n" &
   "    (local $d i32) (local $result i32) (local $len i32) (local $w i32) (local $i i32)\n" &
   "    (local.set $neg (i32.wrap_i64 (i64.shr_u (local.get $bits) (i64.const 63))))\n" &
   "    (local.set $mag (i64.shr_u (i64.shl (local.get $bits) (i64.const 1)) (i64.const 1)))\n" &
   "    (local.set $x (f64.reinterpret_i64 (local.get $mag)))\n" &
   "    (local.set $ibuf (call $bump_alloc (i32.const 32)))\n" &
   "    (local.set $fbuf (call $bump_alloc (i32.const 32)))\n" &
   "    (local.set $ic (i32.const 0))\n" &
   "    (local.set $fc (i32.const 0))\n" &
   "    (if (i64.eqz (local.get $mag))\n" &
   "      (then\n" &
   "        (i32.store8 (local.get $ibuf) (i32.const " & integer-to-text cce-digit-zero & "))\n" &
   "        (local.set $ic (i32.const 1))\n" &
   "        (i32.store8 (local.get $fbuf) (i32.const " & integer-to-text cce-digit-zero & "))\n" &
   "        (local.set $fc (i32.const 1)))\n" &
   "      (else\n" &
   "        (local.set $ip (i64.trunc_sat_f64_s (local.get $x)))\n" &
   "        (local.set $frac (f64.sub (local.get $x) (f64.convert_i64_s (local.get $ip))))\n" &
   "        (if (i64.eqz (local.get $ip))\n" &
   "          (then (i32.store8 (local.get $ibuf) (i32.const " & integer-to-text cce-digit-zero & ")) (local.set $ic (i32.const 1)))\n" &
   "          (else (block $idone (loop $iloop\n" &
   "            (br_if $idone (i64.eqz (local.get $ip)))\n" &
   "            (i32.store8 (i32.add (local.get $ibuf) (local.get $ic))\n" &
   "              (i32.add (i32.wrap_i64 (i64.rem_u (local.get $ip) (i64.const 10))) (i32.const " & integer-to-text cce-digit-zero & ")))\n" &
   "            (local.set $ic (i32.add (local.get $ic) (i32.const 1)))\n" &
   "            (local.set $ip (i64.div_u (local.get $ip) (i64.const 10)))\n" &
   "            (br $iloop)))))\n" &
   "        (block $fdone (loop $floop\n" &
   "          (br_if $fdone (i32.ge_s (local.get $fc) (i32.const 15)))\n" &
   "          (local.set $frac (f64.mul (local.get $frac) (f64.const 10)))\n" &
   "          (local.set $d (i32.wrap_i64 (i64.trunc_sat_f64_s (local.get $frac))))\n" &
   "          (local.set $frac (f64.sub (local.get $frac) (f64.convert_i64_s (i64.extend_i32_s (local.get $d)))))\n" &
   "          (i32.store8 (i32.add (local.get $fbuf) (local.get $fc)) (i32.add (local.get $d) (i32.const " & integer-to-text cce-digit-zero & ")))\n" &
   "          (local.set $fc (i32.add (local.get $fc) (i32.const 1)))\n" &
   "          (br_if $fdone (i64.eqz (i64.reinterpret_f64 (local.get $frac))))\n" &
