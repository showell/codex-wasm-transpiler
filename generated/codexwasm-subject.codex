 THE BINARY WRITERS GO THROUGH `__serial_put` ON A HOSTED TARGET, byte by byte,
 because every other path they have is a port. Both probe for a debug device
 first (`in al, dx` on 0xE9 and 0x511) and both fall back to the UART at 0x3F8,
 so all three of their arms are privileged instructions in user mode. Measured
 2026-08-30: the hosted compiler compiled its own 3 MB source correctly and
 announced `SIZE:3085320`, then died at 0xC0000096 the moment it began writing
 the payload out. The names are recorded by the callers below, so these bodies
 start already registered.

  emit-hosted-write-binary-body : CodegenState -> CodegenState
  emit-hosted-write-binary-body (st) =
   let st2 = st-append-code st (push-r reg-rbx & push-r reg-rcx & push-r reg-r11)
   in let st3 = st-append-code st2 (mov-rr reg-rbx reg-rdi)
   in let st4 = st-append-code st3 (mov-load reg-rcx reg-rbx 0)
   in let st5 = emit-list-eff-base st4 reg-rbx reg-rax
   in let st6 = st-append-code st5 (li reg-r11 0)
   in let loop-top = st6.code-len
   in let st7 = st-append-code st6 (cmp-rr reg-r11 reg-rcx)
   in let done-pos = st7.code-len
   in let st8 = st-append-code st7 (jcc cc-ge 0)
   in let st9 = st-append-code st8 (mov-rr reg-rax reg-r11)
   in let st10 = st-append-code st9 (shl-ri reg-rax 3)
   in let st11 = st-append-code st10 (add-rr reg-rax reg-rbx)
   in let st12 = st-append-code st11 (mov-load reg-rax reg-rax 8)
   in let st13 = emit-call-to st12 "__serial_put"
   in let st14 = st-append-code st13 (add-ri reg-r11 1)
   in let st15 = st-append-code st14 (jmp (loop-top - (st14.code-len + 5)))
   in let st16 = patch-jcc-at st15 done-pos (st15.code-len)
   in let st17 = st-append-code st16 (pop-r reg-r11 & pop-r reg-rcx & pop-r reg-rbx)
   in st-append-code st17 x86-ret

