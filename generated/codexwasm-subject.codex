   in let st28 = st-append-code st27 (shl-ri reg-rcx 8)

   in let st28a = st-append-code st28 (li reg-rdx ne2k-rsar1-port)

   in let st29 = st-append-code st28a (mov-rr reg-rax reg-rcx)

   in let st30 = st-append-code st29 [72, 193, 232, 8]

   in let st31 = st-append-code st30 out-dx-al

   in let st32 = st-append-code st31 (li reg-rdx ne2k-rbcr0-port)

   in let st33 = st-append-code st32 (li reg-rax 4)

   in let st34 = st-append-code st33 out-dx-al

   in let st35 = st-append-code st34 (li reg-rdx ne2k-rbcr1-port)

   in let st36 = st-append-code st35 (xor-rr reg-rax reg-rax)

   in let st37 = st-append-code st36 out-dx-al

   in let st38 = st-append-code st37 (li reg-rdx ne2k-cr-port)

   in let st39 = st-append-code st38 (li reg-rax 10)

   in let st40 = st-append-code st39 out-dx-al

   in let st41 = st-append-code st40 (li reg-rdx ne2k-data-port)

   in let st42 = st-append-code st41 in-ax-dx

   in let st43 = st-append-code st42 [72, 193, 232, 8]

   in let st44 = st-append-code st43 (push-r reg-rax)

   in let st45 = st-append-code st44 in-ax-dx

   in let st50 = st-append-code st45 (push-r reg-rax)

   in let st51 = st-append-code st50 (sub-ri reg-rax 4)

   in let st51a = st-append-code st51 (cmp-ri reg-rax 1536)
   in let bad-len-jmp = st51a.code-len
   in let st51b = st-append-code st51a (jcc cc-a 0)

   in let st52 = st-append-code st51b (push-r reg-rax)

   in let st53 = st-append-code st52 (li reg-rdx ne2k-rsar0-port)

   in let st54 = st-append-code st53 (li reg-rax 4)

   in let st55 = st-append-code st54 out-dx-al

   in let st56 = st-append-code st55 (pop-r reg-rcx)

   in let st56a = st-append-code st56 (add-ri reg-rcx 1)

   in let st56b = st-append-code st56a (and-ri reg-rcx (0 - 2))

   in let st57 = st-append-code st56b (push-r reg-rcx)

   in let st58 = st-append-code st57 (li reg-rdx ne2k-rbcr0-port)

   in let st59 = st-append-code st58 (mov-rr reg-rax reg-rcx)

   in let st60 = st-append-code st59 out-dx-al

   in let st61 = st-append-code st60 (li reg-rdx ne2k-rbcr1-port)

   in let st62 = st-append-code st61 (mov-rr reg-rax reg-rcx)

   in let st63 = st-append-code st62 [72, 193, 232, 8]

   in let st64 = st-append-code st63 out-dx-al

   in let st65 = st-append-code st64 (li reg-rdx ne2k-cr-port)

   in let st66 = st-append-code st65 (li reg-rax 10)

   in let st67 = st-append-code st66 out-dx-al

   in let st68 = st-append-code st67 (mov-rr reg-rdi reg-rbx)

   in let st69 = st-append-code st68 (pop-r reg-rcx)

   in let st70 = st-append-code st69 [72, 209, 233]

   in let st71 = st-append-code st70 (li reg-rdx ne2k-data-port)

   in let st71a = st-append-code st71 [252]

   in let st72 = st-append-code st71a rep-insw

   in let st73 = st-append-code st72 (pop-r reg-rsi)

   in let st74 = st-append-code st73 (pop-r reg-rax)

   in let st75 = st-append-code st74 (li reg-rdx ne2k-bnry-port)

   in let st76 = st-append-code st75 out-dx-al

   in let st77 = st-append-code st76 (pop-r reg-rax)

   in let st78 = st-append-code st77 (mov-rr reg-rax reg-rsi)

   in let st79 = st-append-code st78 (sub-ri reg-rax 4)

   in let st80 = st-append-code st79 (pop-r reg-rbx)

   in let st81 = st-append-code st80 x86-ret

   in let no-data-pos = st81.code-len

   in let st82 = st-append-code st81 (xor-rr reg-rax reg-rax)

   in let st83 = st-append-code st82 (pop-r reg-rbx)

