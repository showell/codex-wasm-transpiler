Section: Binary Output

  emit-write-binary-helper : CodegenState -> CodegenState

  emit-write-binary-helper (st) =

   let st1 = record-func-offset st "__write_binary"

   in if st-hosted st1 then emit-hosted-write-binary-body st1

   else let st2 = st-append-code st1 (push-r reg-rbx)

   in let st3 = st-append-code st2 (push-r reg-rcx)

   in let st4 = st-append-code st3 (push-r reg-r11)

   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-rdi)

