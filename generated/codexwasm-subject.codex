 The hosted slurp and line reader. The buffer protocol is the bare-metal one
 unchanged: RBX is the heap frontier and the buffer, the length goes at [RBX],
 the bytes at RBX+8, and the frontier is bumped once at the end. Bytes under
 128 go through the unicode-to-CCE table, CR is dropped, and the read ends at
 NUL or EOT, which is what `read-file-uni` means on this target.

  emit-hosted-read-all-uni-helper : CodegenState -> CodegenState
  emit-hosted-read-all-uni-helper (st) =
   let st0 = record-func-offset st "__hosted_read_all_uni"
   in let st1 = st-append-code st0 (push-r reg-rbx & push-r reg-rcx & push-r reg-r12)
   in let st2 = emit-load-rodata-addr st1 reg-r12 unicode-to-cce-rodata-offset
