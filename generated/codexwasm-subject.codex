   [15, 198, modrm 3 dst src, imm]

  andpd-xmm : Integer, Integer -> List Integer
  andpd-xmm (dst) (src) =
   [102, 15, 84, modrm 3 dst src]

  andnpd-xmm : Integer, Integer -> List Integer
  andnpd-xmm (dst) (src) =
