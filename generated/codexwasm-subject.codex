   in let st6ad = st-append-code st6ac (jcc cc-ge 0)

   in let st6ae = st-append-code st6ad (mov-rr reg-rax reg-r11)

   in let st6af = st-append-code st6ae (shl-ri reg-rax 3)

   in let st6ag = st-append-code st6af (add-rr reg-rax reg-rbx)

   in let st6ah = st-append-code st6ag (mov-load reg-rax reg-rax 8)

   in let st6ai = st-append-code st6ah out-dx-al

   in let st6aj = st-append-code st6ai (add-ri reg-r11 1)

   in let st6ak = st-append-code st6aj (jmp (dbg-top - (st6aj.code-len + 5)))

   in let st6al = patch-jcc-at st6ak uart-pos (st6ak.code-len)

   in let st7 = st-append-code st6al (li reg-r11 0)

   in let loop-top = st7.code-len

   in let st7a = st-append-code st7 (li reg-rax 0)

   in let st7b = st-append-code st7a (li reg-rdi (st-cell st7a wd-stale-tick-addr))

   in let st7c = st-append-code st7b (mov-store reg-rdi reg-rax 0)

   in let st8 = st-append-code st7c (cmp-rr reg-r11 reg-rcx)

   in let done-pos = st8.code-len

   in let st9 = st-append-code st8 (jcc cc-ge 0)

   in let st10 = st-append-code st9 (mov-rr reg-rax reg-r11)

   in let st11 = st-append-code st10 (shl-ri reg-rax 3)

   in let st12 = st-append-code st11 (add-rr reg-rax reg-rbx)

   in let st13 = st-append-code st12 (mov-load reg-rax reg-rax 8)

   in let st14 = st-append-code st13 (push-r reg-rax)

   in let wait-top = st14.code-len

   in let st15 = st-append-code st14 (li reg-rdx 1021)

   in let st16 = st-append-code st15 [236]

   in let st17 = st-append-code st16 [168, 32]

   in let thr-ready = st17.code-len

   in let st18 = st-append-code st17 (jcc cc-ne 0)

   in let st19 = st-append-code st18 (jmp (wait-top - (st18.code-len + 5)))

   in let st20 = patch-jcc-at st19 thr-ready (st19.code-len)

   in let st21 = st-append-code st20 (pop-r reg-rax)

   in let st22 = st-append-code st21 (li reg-rdx 1016)

   in let st23 = st-append-code st22 out-dx-al

   in let st24 = st-append-code st23 (add-ri reg-r11 1)

   in let st25 = st-append-code st24 (jmp (loop-top - (st24.code-len + 5)))

   in let st26 = patch-jcc-at st25 done-pos (st25.code-len)

   in let st26a = patch-jcc-at st26 dbg-done (st26.code-len)

   in let st27 = st-append-code st26a (pop-r reg-r11)

   in let st28 = st-append-code st27 (pop-r reg-rcx)

   in let st29 = st-append-code st28 (pop-r reg-rbx)

   in st-append-code st29 x86-ret

 Flat-buffer variant: rdi = buffer address, rsi = offset, rdx = length.
 Probes port 1297 (0x511) for the codex-vm bulk blit; on the magic
 answer 183 (0xB7) the guest stores address and length into the fixed
 cells 36160 and 36168 and rings doorbell 1296 (0x510) with command 3,
 so the whole buffer leaves in one VM exit. Anywhere else (older VM,
 QEMU, real hardware) the port floats 255 and the UART loop below runs
 instead. emit-com1-init writes FCR = 0xC7, so the 16550 transmit FIFO
 is on and LSR bit 5 means the whole 16-byte FIFO is empty rather than
 one holding register: poll it once, then rep outsb a burst of up to
 16. A rep string I/O access is a single trap under WHP and KVM, so a
 burst costs two exits where sixteen single bytes cost thirty-two.

 Between those two arms sits the Bochs debug console at port 0xE9
 (233), which QEMU models as isa-debugcon: every byte written is
 appended to its chardev with no FIFO and no status register, so a
 single rep outsb carries the whole buffer in one trap. Its presence
 probe is that an IN from 0xE9 reads back 0xE9 when the device is
 wired (the readback property's default) and floats 0xFF everywhere
 else: QEMU without the device, codex-vm (whose 0x511 arm wins first
 anyway), and real hardware. The harness that wires the device owns
 the reader; nothing else changes, because without it the probe fails
 and the UART loop below runs exactly as before.

  emit-write-binary-buf-helper : CodegenState -> CodegenState

  emit-write-binary-buf-helper (st) =

   let st1 = record-func-offset st "__write_binary_buf"

   in if st-hosted st1 then emit-hosted-write-binary-buf-body st1

   else let st2 = st-append-code st1 (push-r reg-rbx)

   in let st3 = st-append-code st2 (push-r reg-rcx)

   in let st4 = st-append-code st3 (push-r reg-r11)

   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-rdi)

   in let st6 = st-append-code st5 (add-rr reg-rbx reg-rsi)

   in let st7 = st-append-code st6 (mov-rr reg-rcx reg-rdx)

   in let st8 = st-append-code st7 (xor-rr reg-rax reg-rax)

   in let st9 = st-append-code st8 (li reg-rdx 1297)

   in let st10 = st-append-code st9 in-al-dx

   in let st11 = st-append-code st10 (cmp-ri reg-rax 183)

   in let legacy-pos = st11.code-len

   in let st12 = st-append-code st11 (jcc cc-ne 0)

   in let st13 = st-append-code st12 (li reg-rdi 36160)

   in let st14 = st-append-code st13 (mov-store reg-rdi reg-rbx 0)

   in let st15 = st-append-code st14 (li reg-rdi 36168)

   in let st16 = st-append-code st15 (mov-store reg-rdi reg-rcx 0)

   in let st17 = st-append-code st16 (li reg-rax 3)

   in let st18 = st-append-code st17 (li reg-rdx 1296)

   in let st19 = st-append-code st18 out-dx-al

   in let blit-done-pos = st19.code-len

   in let st20 = st-append-code st19 (jmp 0)

   in let st21 = patch-jcc-at st20 legacy-pos (st20.code-len)

   in let st21a = st-append-code st21 (li reg-rdx 233)

   in let st21b = st-append-code st21a in-al-dx

   in let st21c = st-append-code st21b (cmp-ri reg-rax 233)

   in let uart-pos = st21c.code-len

   in let st21d = st-append-code st21c (jcc cc-ne 0)

   in let st21e = st-append-code st21d (mov-rr reg-rsi reg-rbx)

   in let st21f = st-append-code st21e (cld & rep-outsb)

   in let dbg-done-pos = st21f.code-len

   in let st21g = st-append-code st21f (jmp 0)

   in let st21h = patch-jcc-at st21g uart-pos (st21g.code-len)

   in let st22 = st-append-code st21h (mov-rr reg-rsi reg-rbx)

   in let st22a = st-append-code st22 (mov-rr reg-r11 reg-rcx)

   in let loop-top = st22a.code-len

   in let st23 = st-append-code st22a (li reg-rax 0)

   in let st24 = st-append-code st23 (li reg-rdi (st-cell st23 wd-stale-tick-addr))

   in let st25 = st-append-code st24 (mov-store reg-rdi reg-rax 0)

   in let st26 = st-append-code st25 (cmp-ri reg-r11 0)

   in let done-pos = st26.code-len

   in let st27 = st-append-code st26 (jcc cc-le 0)

   in let st28 = st-append-code st27 (mov-rr reg-rcx reg-r11)

   in let st29 = st-append-code st28 (cmp-ri reg-rcx 16)

   in let burst-pos = st29.code-len

   in let st30 = st-append-code st29 (jcc cc-le 0)

   in let st31 = st-append-code st30 (li reg-rcx 16)

   in let st31a = patch-jcc-at st31 burst-pos (st31.code-len)

   in let wait-top = st31a.code-len

   in let st32 = st-append-code st31a (li reg-rdx 1021)

   in let st33 = st-append-code st32 [236]

   in let st34 = st-append-code st33 [168, 32]

   in let thr-ready = st34.code-len

   in let st35 = st-append-code st34 (jcc cc-ne 0)

   in let st36 = st-append-code st35 (jmp (wait-top - (st35.code-len + 5)))

   in let st37 = patch-jcc-at st36 thr-ready (st36.code-len)

   in let st38 = st-append-code st37 (li reg-rdx 1016)

   in let st39 = st-append-code st38 (sub-rr reg-r11 reg-rcx)

   in let st40 = st-append-code st39 (cld & rep-outsb)

   in let st42 = st-append-code st40 (jmp (loop-top - (st40.code-len + 5)))

   in let st43 = patch-jcc-at st42 done-pos (st42.code-len)

