   in let st6v = emit-list-eff-base st6 reg-rbx reg-rax

   in let st6w = st-append-code st6v (xor-rr reg-rax reg-rax)

   in let st6x = st-append-code st6w (li reg-rdx 233)

   in let st6y = st-append-code st6x in-al-dx

   in let st6z = st-append-code st6y (cmp-ri reg-rax 233)

