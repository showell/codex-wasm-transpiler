 peek-byte, poke-byte and peek-qword carry the same window guard as
 peek-32 / poke-32. Without it a byte-wise or qword writer would reach
 the rasterizer's command buffer at 0xBE000000 without earning
 cap-gpu-memory -- the guard is on the sanctioned write path, not the
 access width, so every width that can touch the window is gated. The
 guard is the same three-ALU-op top-byte test, and it costs peek-qword
 (a memo-table primitive) the same predicted, memory-free branch it
 costs peek-32.

  emit-peek-byte-helper : CodegenState -> CodegenState

  emit-peek-byte-helper (st) =

   let fn-off = st.code-len

   in let n = list-push (st.fo-names) "peek-byte"

   in let o = list-push (st.fo-offsets) fn-off

   in let st0 = __record-set (__record-set st "fo-names" n) "fo-offsets" o

   in let st1 = st-append-code st0 (add-rr reg-rdi reg-rsi)

   in let g = emit-gpu-mem-guard st1

   in let st2 = st-append-code (g.state) [72, 15, 182, 7]

   in let st3 = st-append-code st2 x86-ret

   in let fail-pos = st3.code-len

   in let st4 = st-append-code st3 (li reg-rax (0 - 1))

   in let st5 = st-append-code st4 x86-ret

   in patch-jcc-at st5 (g.deny-offset) fail-pos

