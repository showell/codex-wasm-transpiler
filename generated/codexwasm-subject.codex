   in let st89 = patch-jcc-at st88 no-nic-jmp no-nic-pos

   in let st90 = patch-jcc-at st89 bad-len-jmp bad-len-pos

   in patch-jcc-at st90 cap-deny no-nic-pos

  emit-chan-text-send-helper : CodegenState -> CodegenState
  emit-chan-text-send-helper (st) =
   let st1 = record-func-offset st "chan-text-send"
   in let st2 = st-append-code st1 (push-r reg-rbx)
   in let st3 = st-append-code st2 (push-r reg-r12)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-r12 reg-rsi)
   in let st6 = st-append-code st5 (mov-rr reg-rdi reg-rbx)
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-r12)
   in let st8 = emit-call-to st7 "chan-kern-send-block"
   in let st9 = st-append-code st8 (pop-r reg-r12)
   in let st10 = st-append-code st9 (pop-r reg-rbx)
   in st-append-code st10 x86-ret

  emit-chan-text-recv-helper : CodegenState -> CodegenState
  emit-chan-text-recv-helper (st) =
   let st1 = record-func-offset st "chan-text-recv"
   in let st2 = st-append-code st1 (push-r reg-rbx)
   in let st3 = st-append-code st2 (push-r reg-rcx)
   in let st4 = st-append-code st3 (mov-rr reg-rbx reg-rdi)
   in let st5 = st-append-code st4 (mov-rr reg-rdi reg-rbx)
   in let st6 = emit-call-to st5 "chan-kern-recv-block"
   in let st7 = st-append-code st6 (mov-rr reg-rsi reg-rax)
   in let st8 = st-append-code st7 (mov-rr reg-rbx reg-r10)
   in let st9 = st-append-code st8 (mov-load reg-rcx reg-rsi 0)
   in let st10 = st-append-code st9 (mov-store reg-rbx reg-rcx 0)
   in let st11 = st-append-code st10 (lea reg-rdi reg-rbx 8)
   in let st12 = st-append-code st11 (add-ri reg-rsi 8)
   in let st13 = st-append-code st12 [243, 164]
   in let st14 = st-append-code st13 (mov-rr reg-rax reg-rcx)
   in let st15 = st-append-code st14 (add-ri reg-rax 15)
   in let st16 = st-append-code st15 (and-ri reg-rax (-8))
   in let st17 = st-append-code st16 (add-ri reg-rax 8)
   in let st18 = heap-bump-reg st17 reg-rax
   in let st19 = st-append-code st18 (mov-rr reg-rax reg-rbx)
   in let st20 = st-append-code st19 (pop-r reg-rcx)
   in let st21 = st-append-code st20 (pop-r reg-rbx)
   in st-append-code st21 x86-ret

