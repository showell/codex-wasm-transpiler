Section: __list_set_at

 The index is bounded first, and this is the sharpest of the indexing
 guards because the defect it closes was a WRITE across an allocation
 boundary rather than a disclosure. Measured before it existed, on a
 three-element list with a marker list allocated after it:
 `list-set-at t 5 424242` left the marker reading `424242 999 999`, with
 no diagnostic and exit 0. `0 <= i` and `i < len`, as for `list-at`;
 there is no slot at index length to store into.

  emit-list-set-at : CodegenState -> CodegenState
  emit-list-set-at (st) =
    let trap = [15, 11]
   in let st0 = record-func-offset st "__list_set_at"
   in let g0 = st-append-code st0 (mov-load reg-rax reg-rdi 0)
   in let g1 = st-append-code g0 (cmp-ri reg-rsi 0 & jcc cc-ge (list-length trap) & trap)
   in let g2 = st-append-code g1 (cmp-rr reg-rsi reg-rax & jcc cc-l (list-length trap) & trap)
   in let st0a = st-append-code g2 (mov-rr reg-rcx reg-rdi)
   in let st0b = emit-list-eff-base st0a reg-rcx reg-rax
   in let st1 = st-append-code st0b (shl-ri reg-rsi 3)
   in let st2 = st-append-code st1 (add-rr reg-rsi reg-rcx)
   in let st3 = st-append-code st2 (mov-store reg-rsi reg-rdx 8)
   in let st4 = st-append-code st3 (mov-rr reg-rax reg-rdi)
   in st-append-code st4 x86-ret

