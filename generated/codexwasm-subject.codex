Chapter: Parsmi--Resolve Types

Section: Type Resolution

  strip-fun-args-resolve : CodexType -> CodexType
  strip-fun-args-resolve (ty) =
   when ty
    is FunTy (p) (row) (r) -> strip-fun-args-resolve r
    is otherwise -> ty

  resolve-ty-deep : List TypeBinding, CodexType -> CodexType
  resolve-ty-deep (tdefs) (ty) =
   when ty
    is ConstructedTy (cname) (cargs) ->
     if list-length cargs > 0 then deck-record (ConstructedTy cname (for a in cargs -> resolve-ty-deep tdefs a))
     else let raw = lookup-type-bsearch tdefs (cname.value)
     in when raw
      is RecordTy (rn) (ra) (rf) | SumTy (sn) (sa) (sc) -> raw
      is FunTy (p) (row) (r) -> strip-fun-args-resolve r
      is otherwise -> deck-record (ConstructedTy cname [])
    is FunTy (p) (row) (r) -> deck-record (FunTy (resolve-ty-deep tdefs p) row (resolve-ty-deep tdefs r))
    is ListTy (e) -> deck-record (ListTy (resolve-ty-deep tdefs e))
    is LinkedListTy (e) -> deck-record (LinkedListTy (resolve-ty-deep tdefs e))
    is ForAllTy (id) (body) -> deck-record (ForAllTy id (resolve-ty-deep tdefs body))
    is ForAllEff (id) (body) -> deck-record (ForAllEff id (resolve-ty-deep tdefs body))
    is EffectfulTy (effs) (sc) (ret) -> deck-record (EffectfulTy effs sc (resolve-ty-deep tdefs ret))
    is UnitTy (n) (inner) -> deck-record (UnitTy n (resolve-ty-deep tdefs inner))
    is VectorTy (vn) (vt) -> deck-record (VectorTy vn (resolve-ty-deep tdefs vt))
    is VectorMaskTy (n) -> ty
    is TypeApply (tf) (ta) -> let rf = resolve-ty-deep tdefs tf in let ra = resolve-ty-deep tdefs ta in when rf is TypeCon (rn) -> if rn.value == "List" then deck-record (ListTy ra) else deck-record (ConstructedTy rn [ra]) is otherwise -> deck-record (TypeApply rf ra)
    is TypeCon (n) -> ty
    is LinearTy (linner) -> resolve-ty-deep tdefs linner
    is otherwise -> ty

Section: IR Rewrite

  rewrite-ir-pat : List TypeBinding, IRPat -> IRPat
  rewrite-ir-pat (tdefs) (p) =
   when p
    is IrVarPat (name) (t) (s) -> deck-record (IrVarPat name (resolve-ty-deep tdefs t) s)
    is IrLitPat (v) (t) (s) -> deck-record (IrLitPat v (resolve-ty-deep tdefs t) s)
    is IrCtorPat (name) (subs) (t) (s) -> deck-record (IrCtorPat name (for p2 in subs -> rewrite-ir-pat tdefs p2) (resolve-ty-deep tdefs t) s)
    is IrWildPat (s) -> p
    is IrVecPat (subs) (t) (s) -> deck-record (IrVecPat (for p2 in subs -> rewrite-ir-pat tdefs p2) (resolve-ty-deep tdefs t) s)

  rewrite-ir-expr : List TypeBinding, IRExpr -> IRExpr
  rewrite-ir-expr (tdefs) (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> e
    is IrName (n) (t) (s) -> deck-record (IrName n (resolve-ty-deep tdefs t) s)
    is IrBinary (op) (l) (r) (t) (s) -> deck-record (IrBinary op (rewrite-ir-expr tdefs l) (rewrite-ir-expr tdefs r) (resolve-ty-deep tdefs t) s)
    is IrNegate (x) (t) (s) -> deck-record (IrNegate (rewrite-ir-expr tdefs x) (resolve-ty-deep tdefs t) s)
    is IrIf (c) (th) (el) (t) (s) -> deck-record (IrIf (rewrite-ir-expr tdefs c) (rewrite-ir-expr tdefs th) (rewrite-ir-expr tdefs el) (resolve-ty-deep tdefs t) s)
    is IrLet (n) (t) (v) (b) (s) -> deck-record (IrLet n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) (rewrite-ir-expr tdefs b) s)
    is IrApply (f) (a) (t) (s) -> deck-record (IrApply (rewrite-ir-expr tdefs f) (rewrite-ir-expr tdefs a) (resolve-ty-deep tdefs t) s)
    is IrLambda (ps) (b) (t) (s) -> deck-record (IrLambda (for p in ps -> deck-record (IRParam { name = p.name, type-val = resolve-ty-deep tdefs (p.type-val), span = p.span })) (rewrite-ir-expr tdefs b) (resolve-ty-deep tdefs t) s)
    is IrList (es) (t) (s) -> deck-record (IrList (for x in es -> rewrite-ir-expr tdefs x) (resolve-ty-deep tdefs t) s)
    is IrMatch (sc) (bs) (t) (s) -> deck-record (IrMatch (rewrite-ir-expr tdefs sc) (for b in bs -> deck-record (IRBranch { pattern = rewrite-ir-pat tdefs (b.pattern), body = rewrite-ir-expr tdefs (b.body), guard = rewrite-ir-expr tdefs (b.guard), span = b.span, alt-group = b.alt-group })) (resolve-ty-deep tdefs t) s)
    is IrAct (ss) (t) (s) -> deck-record (IrAct (rewrite-ir-act-stmts tdefs ss) (resolve-ty-deep tdefs t) s)
    is IrHandle (eff) (h) (cs) (t) (s) -> deck-record (IrHandle eff (rewrite-ir-expr tdefs h) (for c in cs -> deck-record (IRHandleClause { op-name = c.op-name, params = c.params, resume-name = c.resume-name, body = rewrite-ir-expr tdefs (c.body), span = c.span })) (resolve-ty-deep tdefs t) s)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> deck-record (IrWithTimeout secs effs scopes (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
    is IrRecord (n) (fs) (t) (s) -> deck-record (IrRecord n (for f in fs -> deck-record (IRFieldVal { name = f.name, value = rewrite-ir-expr tdefs (f.value), span = f.span })) (resolve-ty-deep tdefs t) s)
    is IrFieldAccess (r) (f) (t) (s) -> deck-record (IrFieldAccess (rewrite-ir-expr tdefs r) f (resolve-ty-deep tdefs t) s)
    is IrFieldStore (r) (f) (v) (t) (s) -> deck-record (IrFieldStore (rewrite-ir-expr tdefs r) f (rewrite-ir-expr tdefs v) (resolve-ty-deep tdefs t) s)
    is IrFork (body) (t) (s) -> deck-record (IrFork (rewrite-ir-expr tdefs body) (resolve-ty-deep tdefs t) s)
    is IrAwait (task) (t) (s) -> deck-record (IrAwait (rewrite-ir-expr tdefs task) (resolve-ty-deep tdefs t) s)
    is IrTry (max) (body) (fb) (fail) (t) (s) -> deck-record (IrTry max (rewrite-ir-act-stmts tdefs body) (rewrite-ir-act-stmts tdefs fb) (rewrite-ir-act-stmts tdefs fail) (resolve-ty-deep tdefs t) s)
    is IrError (m) (t) (s) -> deck-record (IrError m (resolve-ty-deep tdefs t) s)

  rewrite-ir-act-stmts : List TypeBinding, List IRActStmt -> List IRActStmt
  rewrite-ir-act-stmts (tdefs) (ss) =
   for stmt in ss -> when stmt
    is IrDoBind (n) (t) (v) (sp) -> deck-record (IrDoBind n (resolve-ty-deep tdefs t) (rewrite-ir-expr tdefs v) sp)
    is IrDoExec (v) (sp) -> deck-record (IrDoExec (rewrite-ir-expr tdefs v) sp)

Section: Definition Rewrite

  rewrite-ir-def : List TypeBinding, IRDef -> IRDef
  rewrite-ir-def (tdefs) (d) =
   deck-record (IRDef {
    name = d.name,
    params = for p in (d.params) -> deck-record (IRParam { name = p.name, type-val = resolve-ty-deep tdefs (p.type-val), span = p.span }),
    type-val = resolve-ty-deep tdefs (d.type-val),
    body = rewrite-ir-expr tdefs (d.body),
    chapter-slug = d.chapter-slug,
    is-punctual = d.is-punctual,
    wcet-budget = d.wcet-budget,
    unique-params = d.unique-params,
    span = d.span
   })

 The ceiling is the RESOLVE deck reservation's top, checked per
 definition because this loop is where the phase writes the deck in
 bulk: one rewritten type tree per definition. Measured 2026-07-21 on
 the 2.81 MB selfhost with deck-pos probes, this walk writes 20,029,096
 bytes of the RESOLVE deck's 20,370,712, against 161,112 for
 build-type-def-map and 180,504 for sort-bindings -- so guarding those
 two instead would have bought 1.7 per cent of the phase, which is the
 mistake the SCOPE guard made on its first attempt.

 A definition's rewrite writes kilobytes against an 8 MB band, so a
 per-definition check cannot be outrun. The stop returns the
 definitions rewritten so far; compile-frontend-cdx reads deck-short-of
 again after the walk and raises CDX9002 from there.

  rewrite-ir-defs : List TypeBinding, List IRDef, Integer -> List IRDef
  rewrite-ir-defs (tdefs) (defs) (ceiling) =
   rewrite-ir-defs-acc tdefs defs 0 (list-length defs) [] ceiling

  rewrite-ir-defs-acc : List TypeBinding, List IRDef, Integer, Integer, List IRDef, Integer -> List IRDef
  rewrite-ir-defs-acc (tdefs) (defs) (i) (len) (acc) (ceiling) =
   if i == len then acc
   else if deck-bound-short-of ceiling demand-resolve-guard-band then acc
   else rewrite-ir-defs-acc tdefs defs (i + 1) len (list-push acc (rewrite-ir-def tdefs (list-at defs i))) ceiling


Chapter: Parsmi--IR Text Emitter
  cites Codex chapter OffsetTable (offset-table-empty, offset-table-set, offset-table-get)

Section: Identifier Atoms

  ov-mode-atom : OverflowMode -> Text
  ov-mode-atom (m) =
   when m
    is OvError -> "ov-error"
    is OvWrapping -> "ov-wrap"
    is OvClamping -> "ov-clamp"

  bin-op-atom-typed : IRBinaryOp, CodexType -> Text
  bin-op-atom-typed (op) (ty) =
   if int-ty-wraps ty then (when op
    is IrAddInt -> "add-int-wrapping"
    is IrSubInt -> "sub-int-wrapping"
    is IrMulInt -> "mul-int-wrapping"
    is otherwise -> bin-op-atom op)
   else bin-op-atom op

  bin-op-atom : IRBinaryOp -> Text
  bin-op-atom (op) =
   when op
    is IrAddInt -> "add-int"
    is IrSubInt -> "sub-int"
    is IrMulInt -> "mul-int"
    is IrDivInt -> "div-int"
    is IrRemInt -> "rem-int"
    is IrPowInt -> "pow-int"
    is IrAddNum -> "add-num"
    is IrSubNum -> "sub-num"
    is IrMulNum -> "mul-num"
    is IrDivNum -> "div-num"
    is IrAddRealApprox -> "add-real-approx"
    is IrSubRealApprox -> "sub-real-approx"
    is IrMulRealApprox -> "mul-real-approx"
    is IrDivRealApprox -> "div-real-approx"
    is IrAddRealTrapping -> "add-real-trapping"
    is IrSubRealTrapping -> "sub-real-trapping"
    is IrMulRealTrapping -> "mul-real-trapping"
    is IrDivRealTrapping -> "div-real-trapping"
    is IrAddRealSaturating -> "add-real-saturating"
    is IrSubRealSaturating -> "sub-real-saturating"
    is IrMulRealSaturating -> "mul-real-saturating"
    is IrDivRealSaturating -> "div-real-saturating"
    is IrEq -> "eq"
    is IrNotEq -> "ne"
    is IrLt -> "lt"
    is IrGt -> "gt"
    is IrLtEq -> "le"
    is IrGtEq -> "ge"
    is IrAnd -> "and"
    is IrOr -> "or"
    is IrAppendText -> "append-text"
    is IrAppendList -> "append-list"
    is IrConsList -> "cons-list"
    is IrApproxEq -> "approx-eq"
    is IrApproxEqExact -> "approx-eq-exact"
    is IrAddVec -> "add-vec"
    is IrSubVec -> "sub-vec"
    is IrMulVec -> "mul-vec"
    is IrDivVec -> "div-vec"
    is IrLtVec -> "lt-vec"
    is IrGtVec -> "gt-vec"
    is IrLtEqVec -> "le-vec"
    is IrGtEqVec -> "ge-vec"

Section: String Escaping

  ir-quote : Text -> Text
  ir-quote (s) = "\"" & text-concat-list (ir-quote-collect s 0 (text-length s) []) & "\""

  ir-quote-collect : Text, Integer, Integer, List Text -> List Text
  ir-quote-collect (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in ir-quote-collect s (i + 1) len (list-push acc (ir-quote-char c))

  ir-quote-char : Integer -> Text
  ir-quote-char (c) =
   if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "\"" 0 then "\\\""
   else if c == char-code-at "\n" 0 then "\\n"
   else char-to-text (code-to-char c)

Section: List Helpers

  ir-cat : List Text -> Text
  ir-cat (xs) = text-concat-list xs

  ir-strs-quoted : List Text, Integer, List Text -> List Text
  ir-strs-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-strs-quoted xs (i + 1) (list-push acc (" " & ir-quote (list-at xs i)))

  ir-names-quoted : List Name, Integer, List Text -> List Text
  ir-names-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-names-quoted xs (i + 1) (list-push acc (" " & ir-quote ((list-at xs i).value)))

Section: CodexType Emission

  is-default-int : Integer, Integer, OverflowMode -> Boolean
  is-default-int (lo) (hi) (mode) =
   if lo == i64-min then if hi == i64-max then is-ov-error mode else False
   else False

  is-ov-error : OverflowMode -> Boolean
  is-ov-error (m) =
   when m
    is OvError -> True
    is otherwise -> False

 i64-min cannot be passed to integer-to-text: the bare-metal __itoa
 helper negates negative inputs to a positive register before its digit
 loop, and abs(i64-min) overflows i64. Emit a sentinel atom instead;
 plug parsers map it back to i64-min.

  safe-int-text : Integer -> Text
  safe-int-text (n) = if n == i64-min then "i64-min" else integer-to-text n

  ir-emit-int-bounds : Integer, Integer, OverflowMode -> Text
  ir-emit-int-bounds (lo) (hi) (mode) =
   if is-default-int lo hi mode then "int-default"
   else "(int " & safe-int-text lo & " " & safe-int-text hi & " " & ov-mode-atom mode & ")"

 A bare reference to a generic record (e.g. `-> SortPartition`) parses as
 a RecordTy with empty type-args but fields whose types carry the free
 type variables (parameterize-walk merges the record's own param names
 with the enclosing signature's, so a field `list : List a` holds the
 function's tvar). We do NOT re-emit the fields (that caused exponential
 IR bloat on recursive types) - instead we recover the type arguments
 from the field tvars so a transpiler can emit `SortPartition<T9>`
 rather than an unparameterized generic.

  ir-int-member : List Integer, Integer -> Boolean
  ir-int-member (xs) (n) = ir-int-member-loop xs n 0 (list-length xs)

  ir-int-member-loop : List Integer, Integer, Integer, Integer -> Boolean
  ir-int-member-loop (xs) (n) (i) (len) =
   if i >= len then False
   else if list-at xs i == n then True
   else ir-int-member-loop xs n (i + 1) len

  ir-tvars-of-type : CodexType, List Integer -> List Integer
  ir-tvars-of-type (ty) (acc) =
   when ty
    is TypeVar (id) -> if ir-int-member acc id then acc else list-push acc id
    is ListTy (elem) | LinkedListTy (elem) -> ir-tvars-of-type elem acc
    is FunTy (p) (row) (r) -> ir-tvars-of-type r (ir-tvars-of-type p acc)
    is ForAllTy (tid) (body) -> ir-tvars-of-type body acc
    is ForAllEff (tid) (body) -> ir-tvars-of-type body acc
    is ConstructedTy (name) (args) | RecordTy (name) (args) (fields) | SumTy (name) (args) (ctors) -> ir-tvars-of-type-list args 0 acc
    is EffectfulTy (effs) (sc) (ret) -> ir-tvars-of-type ret acc
    is VectorTy (vn) (vt) -> ir-tvars-of-type vt acc
    is VectorMaskTy (n) -> acc
    is LinearTy (linner) -> ir-tvars-of-type linner acc
    is otherwise -> acc

  ir-tvars-of-type-list : List CodexType, Integer, List Integer -> List Integer
  ir-tvars-of-type-list (xs) (i) (acc) =
   if i >= list-length xs then acc
   else ir-tvars-of-type-list xs (i + 1) (ir-tvars-of-type (list-at xs i) acc)

  ir-record-field-tvars : List RecordField, Integer, List Integer -> List Integer
  ir-record-field-tvars (fields) (i) (acc) =
   if i >= list-length fields then acc
   else ir-record-field-tvars fields (i + 1) (ir-tvars-of-type ((list-at fields i).type-val) acc)

  ir-emit-tvar-args : List Integer, Integer -> Text
  ir-emit-tvar-args (ids) (i) =
   if i >= list-length ids then ""
   else " (tvar " & integer-to-text (list-at ids i) & ")" & ir-emit-tvar-args ids (i + 1)

 THE FOUR ATOMS THAT ALREADY EXISTED KEEP THEIR EXACT SPELLINGS. A plug
 reading this wire matches on the text, so changing "real-approx" to a
 composed form would break every plug for a combination it already
 handles. Only the two f32 modes that could not be spelled before are new
 surface, and a plug that does not know them must refuse rather than fall
 through to ErrorTy.

  ir-emit-real-ty : RealWidth, RealMode -> Text
  ir-emit-real-ty (w) (m) =
   if is-width-f32 w then ir-emit-real-f32-ty m
   else ir-emit-real-f64-ty m

  ir-emit-real-f32-ty : RealMode -> Text
  ir-emit-real-f32-ty (m) =
   when m
    is RmDefault -> "real-approx"
    is RmTrapping -> "real-approx-trapping"
    is RmSaturating -> "real-approx-saturating"

  ir-emit-real-f64-ty : RealMode -> Text
  ir-emit-real-f64-ty (m) =
   when m
    is RmDefault -> "real"
    is RmTrapping -> "real-trapping"
    is RmSaturating -> "real-saturating"

 An arrow's effect row was bound and discarded here until 2026-08-03, so
 a function that declared an effect lost it the moment it took a
 parameter and no consumer of this wire could see it. The row is
 OPTIONAL and trails the two type positions: `(fn p r)` still means an
 empty row and keeps its exact spelling, so a reader taking element 1 and
 element 2 is unaffected.

  ir-emit-row-labels : List EffectLabel -> Text
  ir-emit-row-labels (xs) =
   ir-cat (for l in xs -> " (label " & ir-quote ((l.name).value) & " " & ir-quote (l.scope) & ")")

 Only a row carrying CONCRETE LABELS is published. An open row with no
 labels is a row variable, and rows are inert through the compiler's own
 stage 2 -- concrete effects ride in EffectfulTy until a later stage
 migrates them onto the arrow -- so a bare row variable is a fact no
 consumer can use today, and they are most of the cost. Measured on
 `list-pattern` and `linear-smoke` 2026-08-03: publishing every row grew
 the IR text 15.4 and 9.0 per cent, almost all of it `(row (labels) "" N)`
 on polymorphic arrows; publishing only labelled rows grows it 5.7 and 2.3
 per cent. When row variables become load-bearing this is where they go
 back.

  ir-emit-row : EffectRow -> Text
  ir-emit-row (row) =
   if list-length (row.labels) == 0 then ""
   else " (row (labels" & ir-emit-row-labels (row.labels) & ") " & ir-quote (row.tail-name) & " " & integer-to-text (row.tail-id) & ")"

 `ProofTy`, `PropEqTy`, `TypeCon` and `TypeApply` fell through to the
 `otherwise` arm until 2026-08-04 and emitted the same `error` atom
 `ErrorTy` emits, so a proof type was indistinguishable from a type
 failure on this wire and a reader had to answer UNSUPPORTED on the atom
 rather than treat it as either. That is a hole on its own, and it also
 makes a real defect undiagnosable: a constructor pattern over a
 PARAMETRIC sum binds its variable at `error` while the same variable's
 use carries the real type, and whether the lowering assigned `ErrorTy`
 or a `TypeApply` this emitter had no arm for cannot be read off the
 artifact while both spell it the same way. The `otherwise` arm stays as
 a floor for a variant added later.

  ir-emit-type : CodexType -> Text
  ir-emit-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> ir-emit-int-bounds lo hi mode
    is RealTy (w) (m) -> ir-emit-real-ty w m
    is TextTy -> "text"
    is BooleanTy -> "boolean"
    is CharTy -> "char"
    is VoidTy -> "void"
    is NothingTy -> "nothing"
    is ErrorTy -> "error"
    is NoExpectTy -> "noexpect"
    is FunTy (p) (row) (r) -> "(fn " & ir-emit-type p & " " & ir-emit-type r & ir-emit-row row & ")"
    is ListTy (elem) -> "(list " & ir-emit-type elem & ")"
    is LinkedListTy (elem) -> "(llist " & ir-emit-type elem & ")"
    is TypeVar (id) -> "(tvar " & integer-to-text id & ")"
    is ForAllTy (id) (body) -> "(forall " & integer-to-text id & " " & ir-emit-type body & ")"
    is ForAllEff (id) (body) -> ir-emit-type body
    is SumTy (name) (args) (ctors) -> "(sum " & ir-quote (name.value) & " (args" & ir-emit-type-list args 0 & "))"
    is RecordTy (name) (args) (fields) -> "(record-ty " & ir-quote (name.value) & " (args" & (if list-length args > 0 then ir-emit-type-list args 0 else ir-emit-tvar-args (ir-record-field-tvars fields 0 []) 0) & "))"
    is ConstructedTy (name) (args) -> "(ctd " & ir-quote (name.value) & " (args" & ir-emit-type-list args 0 & "))"
    is EffectfulTy (effs) (sc) (ret) -> "(effectful (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted sc 0 []) & ") " & ir-emit-type ret & ")"
    is UnitTy (name) (inner) -> "(unit " & ir-quote (name.value) & " " & ir-emit-type inner & ")"
    is VectorTy (n) (t) -> "(vector " & integer-to-text n & " " & ir-emit-type t & ")"
    is VectorMaskTy (n) -> "(vector-mask " & integer-to-text n & ")"
    is LinearTy (linner) -> ir-emit-type linner
    is ProofTy -> "proof"
    is PropEqTy (a) (b) -> "(propeq " & ir-emit-type a & " " & ir-emit-type b & ")"
    is TypeCon (n) -> "(tycon " & ir-quote (n.value) & ")"
    is TypeApply (tf) (ta) -> "(tyapply " & ir-emit-type tf & " " & ir-emit-type ta & ")"
    is otherwise -> "error"

  ir-emit-type-list : List CodexType, Integer -> Text
  ir-emit-type-list (xs) (i) =
   ir-cat (for t in xs -> " " & ir-emit-type t)

Section: ATypeExpr Emission

  ir-emit-atype-expr : ATypeExpr -> Text
  ir-emit-atype-expr (te) =
   when te
    is ANamedType (name) (s) -> "(a-named " & ir-quote (name.value) & ")"
    is AFunType (p) (r) (s) -> "(a-fun " & ir-emit-atype-expr p & " " & ir-emit-atype-expr r & ")"
    is AAppType (base) (args) (s) ->
     if ast-real-qual-app-p base args then "(a-named " & ir-quote (ir-real-qual-atom args 0 RwF64 RmDefault) & ")"
     else "(a-app " & ir-emit-atype-expr base & " (args" & ir-emit-atype-expr-list args 0 & "))"
    is AEffectType (effs) (scopes) (tail) (r) (s) ->
     if list-length tail == 0 then "(a-eff (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") " & ir-emit-atype-expr r & ")"
     else "(a-eff (effs" & ir-cat (ir-names-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") (tail " & ir-quote ((list-at tail 0).value) & ") " & ir-emit-atype-expr r & ")"
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> "(a-bounded " & ir-emit-atype-expr b & " " & safe-int-text lo & " " & safe-int-text hi & " " & ov-mode-atom mode & ")"
    is ALinearType (inner) (s) -> "(a-linear " & ir-emit-atype-expr inner & ")"
    is AConstrainedType (cn) (cv) (body) (s) -> ir-emit-atype-expr body
    is APropEqType (l) (r) (s) -> "(a-propeq " & ir-emit-atype-expr l & " " & ir-emit-atype-expr r & ")"
    is AForallType (v) (vt) (p) (s) -> "(a-forall)"
    is otherwise -> "(a-unknown)"

  ir-emit-atype-expr-list : List ATypeExpr, Integer -> Text
  ir-emit-atype-expr-list (xs) (i) =
   ir-cat (for t in xs -> " " & ir-emit-atype-expr t)

Section: Real Qualifier Atom

  ir-real-qual-atom : List ATypeExpr, Integer, RealWidth, RealMode -> Text
  ir-real-qual-atom (args) (i) (w) (m) =
   if i >= list-length args then ir-emit-real-ty w m
   else let word = when (list-at args i) is ANamedType (n) (s) -> n.value is otherwise -> ""
   in if word == "approximate" then ir-real-qual-atom args (i + 1) RwF32 m
      else if word == "trapping" then ir-real-qual-atom args (i + 1) w RmTrapping
      else if word == "saturating" then ir-real-qual-atom args (i + 1) w RmSaturating
      else ir-real-qual-atom args (i + 1) w m

  ir-emit-tparams-text : List Name -> Text
  ir-emit-tparams-text (resolved) =
   ir-cat (ir-names-quoted resolved 0 [])

Section: ATypeDef Emission

  ir-emit-atype-defs : List ATypeDef, Integer -> Text
  ir-emit-atype-defs (xs) (i) =
   ir-cat (ir-emit-atype-defs-acc xs i (list-length xs) [])

  ir-emit-atype-defs-acc : List ATypeDef, Integer, Integer, List Text -> List Text
  ir-emit-atype-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-atype-defs-acc xs (i + 1) len (list-push acc ("\n  " & ir-emit-atype-def (list-at xs i)))

  ir-emit-atype-def : ATypeDef -> Text
  ir-emit-atype-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     "(rec-def " & ir-quote (name.value) & " (tparams" & ir-emit-tparams-text tparams & ") (fields" & ir-emit-rec-field-defs fields 0 & ")" & (if is-mut then " (mutable)" else "") & ")"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     "(var-def " & ir-quote (name.value) & " (tparams" & ir-emit-tparams-text tparams & ") (ctors" & ir-emit-var-ctor-defs ctors 0 & "))"
    is AUnitTypeDef (name) (base) (s) ->
     "(unit-def " & ir-quote (name.value) & " " & ir-emit-atype-expr base & ")"

  ir-emit-rec-field-defs : List ARecordFieldDef, Integer -> Text
  ir-emit-rec-field-defs (xs) (i) =
   ir-cat (ir-emit-rec-field-defs-acc xs i (list-length xs) [])

  ir-emit-rec-field-defs-acc : List ARecordFieldDef, Integer, Integer, List Text -> List Text
  ir-emit-rec-field-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at xs i
   in ir-emit-rec-field-defs-acc xs (i + 1) len (list-push acc (" (rec-field " & ir-quote (f.name.value) & " " & ir-emit-atype-expr (f.type-expr) & ")"))

  ir-emit-var-ctor-defs : List AVariantCtorDef, Integer -> Text
  ir-emit-var-ctor-defs (xs) (i) =
   ir-cat (ir-emit-var-ctor-defs-acc xs i (list-length xs) [])

  ir-emit-var-ctor-defs-acc : List AVariantCtorDef, Integer, Integer, List Text -> List Text
  ir-emit-var-ctor-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at xs i
   in ir-emit-var-ctor-defs-acc xs (i + 1) len (list-push acc (" (var-ctor " & ir-quote (c.name.value) & " (fields" & ir-emit-atype-expr-list (c.fields) 0 & "))"))

Section: IRPattern Emission

  ir-emit-pat : IRPat -> Text
  ir-emit-pat (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> "(var-pat " & ir-quote name & " " & ir-emit-type ty & ")"
    is IrLitPat (text) (ty) (sp) -> "(lit-pat " & ir-quote text & " " & ir-emit-type ty & ")"
    is IrCtorPat (name) (subs) (ty) (sp) -> "(ctor-pat " & ir-quote name & " (subs" & ir-emit-pat-list subs 0 & ") " & ir-emit-type ty & ")"
    is IrWildPat (sp) -> "wild-pat"
    is IrVecPat (subs) (ty) (sp) -> "(vec-pat" & ir-emit-pat-list subs 0 & ")"

  ir-emit-pat-list : List IRPat, Integer -> Text
  ir-emit-pat-list (xs) (i) =
   ir-cat (ir-emit-pat-list-acc xs i (list-length xs) [])

  ir-emit-pat-list-acc : List IRPat, Integer, Integer, List Text -> List Text
  ir-emit-pat-list-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-pat-list-acc xs (i + 1) len (list-push acc (" " & ir-emit-pat (list-at xs i)))

Section: IRExpr Emission

  ir-emit-expr : IRExpr -> Text
  ir-emit-expr (e) =
   when e
    is IrIntLit (n) (sp) -> "(int-lit " & safe-int-text n & ")"
    is IrNumLit (n) (sp) -> "(num-lit " & safe-int-text n & ")"
    is IrTextLit (s) (sp) -> "(text-lit " & ir-quote s & ")"
    is IrBoolLit (b) (sp) -> if b then "(bool-lit true)" else "(bool-lit false)"
    is IrCharLit (c) (sp) -> "(char-lit " & integer-to-text c & ")"
    is IrName (n) (ty) (sp) -> "(name " & ir-quote n & " " & ir-emit-type ty & ")"
    is IrBinary (op) (l) (r) (ty) (sp) -> "(binary " & bin-op-atom-typed op ty & " " & ir-emit-expr l & " " & ir-emit-expr r & " " & ir-emit-type ty & ")"
    is IrNegate (x) (ty) (sp) -> "(negate " & ir-emit-expr x & " " & ir-emit-type ty & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> "(if " & ir-emit-expr c & " " & ir-emit-expr t & " " & ir-emit-expr el & " " & ir-emit-type ty & ")"
    is IrLet (n) (ty) (v) (b) (sp) -> ir-cat (ir-emit-let-chain e [] 0)
    is IrApply (f) (a) (ty) (sp) -> "(apply " & ir-emit-expr f & " " & ir-emit-expr a & " " & ir-emit-type ty & ")"
    is IrLambda (params) (body) (ty) (sp) -> "(lambda (params" & ir-emit-params params 0 & ") " & ir-emit-expr body & " " & ir-emit-type ty & ")"
    is IrList (es) (ty) (sp) -> "(list-expr (elems" & ir-emit-expr-list es 0 & ") " & ir-emit-type ty & ")"
    is IrMatch (sc) (bs) (ty) (sp) -> "(match " & ir-emit-expr sc & " (branches" & ir-emit-branches bs 0 & ") " & ir-emit-type ty & ")"
    is IrAct (ss) (ty) (sp) -> "(act (stmts" & ir-emit-act-stmts ss 0 & ") " & ir-emit-type ty & ")"
    is IrHandle (eff) (h) (cs) (ty) (sp) -> "(handle " & ir-quote eff & " " & ir-emit-expr h & " (clauses" & ir-emit-handle-clauses cs 0 & ") " & ir-emit-type ty & ")"
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> "(with-timeout " & integer-to-text secs & " (effs" & ir-cat (ir-strs-quoted effs 0 []) & ") (scopes" & ir-cat (ir-strs-quoted scopes 0 []) & ") " & ir-emit-expr body & " " & ir-emit-type ty & ")"
    is IrRecord (n) (fs) (ty) (sp) -> "(record " & ir-quote n & " (fields" & ir-emit-field-vals fs 0 & ") " & ir-emit-type ty & ")"
    is IrFieldAccess (r) (f) (ty) (sp) -> let fi = ir-resolve-field-index (ir-expr-type r) f in "(field-access " & ir-emit-expr r & " " & ir-quote (ir-field-with-index f fi) & " " & ir-emit-type ty & ")"
    is IrFieldStore (r) (f) (v) (ty) (sp) -> let fi = ir-resolve-field-index (ir-expr-type r) f in "(field-store " & ir-emit-expr r & " " & ir-quote (ir-field-with-index f fi) & " " & ir-emit-expr v & " " & ir-emit-type ty & ")"
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> "(try " & integer-to-text max & " (body" & ir-emit-act-stmts body 0 & ") (fallback" & ir-emit-act-stmts fb 0 & ") (fail" & ir-emit-act-stmts fail 0 & ") " & ir-emit-type ty & ")"
    is IrFork (b) (ty) (sp) -> "(fork " & ir-emit-expr b & " " & ir-emit-type ty & ")"
    is IrAwait (t) (ty) (sp) -> "(await " & ir-emit-expr t & " " & ir-emit-type ty & ")"
    is IrError (m) (ty) (sp) -> "(error " & ir-quote m & " " & ir-emit-type ty & ")"

 Let-chains are the deepest structure in real Codex (every `in` nests
 the rest), so emitting `IrLet` by naive recursion makes each level
 concatenate the entire inner body -- the left operand is never at the
 heap bump pointer, so __str_concat takes the copy path every level,
 giving O(depth^2) copies. Flatten the chain instead: collect each
 level's "(let name ty val " prefix into one list, emit the innermost
 body, then append one ")" per level, and join once. Byte-identical
 output, O(total). Mirrors codex-emit-let-chain in the Codex text emitter.

  ir-emit-let-chain : IRExpr, List Text, Integer -> List Text
  ir-emit-let-chain (e) (acc) (depth) =
   when e
    is IrLet (n) (ty) (v) (b) (sp) ->
     ir-emit-let-chain b (list-push acc ("(let " & ir-quote n & " " & ir-emit-type ty & " " & ir-emit-expr v & " ")) (depth + 1)
    is otherwise ->
     ir-close-parens (list-push acc (ir-emit-expr e)) depth

  ir-close-parens : List Text, Integer -> List Text
  ir-close-parens (acc) (n) =
   if n == 0 then acc
   else ir-close-parens (list-push acc ")") (n - 1)

  ir-emit-expr-list : List IRExpr, Integer -> Text
  ir-emit-expr-list (xs) (i) =
   ir-cat (ir-emit-expr-list-acc xs i (list-length xs) [])

  ir-emit-expr-list-acc : List IRExpr, Integer, Integer, List Text -> List Text
  ir-emit-expr-list-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-expr-list-acc xs (i + 1) len (list-push acc (" " & ir-emit-expr (list-at xs i)))

  ir-emit-params : List IRParam, Integer -> Text
  ir-emit-params (xs) (i) =
   ir-cat (ir-emit-params-acc xs i (list-length xs) [])

  ir-emit-params-acc : List IRParam, Integer, Integer, List Text -> List Text
  ir-emit-params-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at xs i
   in ir-emit-params-acc xs (i + 1) len (list-push acc (" (param " & ir-quote (p.name) & " " & ir-emit-type (p.type-val) & ")"))

  ir-emit-branches : List IRBranch, Integer -> Text
  ir-emit-branches (xs) (i) =
   ir-cat (ir-emit-branches-acc xs i (list-length xs) [])

  ir-emit-branches-acc : List IRBranch, Integer, Integer, List Text -> List Text
  ir-emit-branches-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at xs i
   in ir-emit-branches-acc xs (i + 1) len (list-push acc (" (branch " & ir-emit-pat (b.pattern) & " " & ir-emit-expr (b.body) & " " & ir-emit-expr (b.guard) & ")"))

  ir-emit-act-stmts : List IRActStmt, Integer -> Text
  ir-emit-act-stmts (xs) (i) =
   ir-cat (ir-emit-act-stmts-acc xs i (list-length xs) [])

  ir-emit-act-stmts-acc : List IRActStmt, Integer, Integer, List Text -> List Text
  ir-emit-act-stmts-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-act-stmts-acc xs (i + 1) len (list-push acc (" " & ir-emit-act-stmt (list-at xs i)))

  ir-emit-act-stmt : IRActStmt -> Text
  ir-emit-act-stmt (s) =
   when s
    is IrDoBind (n) (ty) (v) (sp) -> "(do-bind " & ir-quote n & " " & ir-emit-type ty & " " & ir-emit-expr v & ")"
    is IrDoExec (e) (sp) -> "(do-exec " & ir-emit-expr e & ")"

  ir-emit-handle-clauses : List IRHandleClause, Integer -> Text
  ir-emit-handle-clauses (xs) (i) =
   ir-cat (ir-emit-handle-clauses-acc xs i (list-length xs) [])

  ir-emit-handle-clauses-acc : List IRHandleClause, Integer, Integer, List Text -> List Text
  ir-emit-handle-clauses-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at xs i
   in ir-emit-handle-clauses-acc xs (i + 1) len (list-push acc (" (handle-clause " & ir-quote (c.op-name) & " (params" & ir-cat (ir-strs-quoted (c.params) 0 []) & ") " & ir-quote (c.resume-name) & " " & ir-emit-expr (c.body) & ")"))

  ir-emit-field-vals : List IRFieldVal, Integer -> Text
  ir-emit-field-vals (xs) (i) =
   ir-cat (ir-emit-field-vals-acc xs i (list-length xs) [])

  ir-emit-field-vals-acc : List IRFieldVal, Integer, Integer, List Text -> List Text
  ir-emit-field-vals-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at xs i
   in ir-emit-field-vals-acc xs (i + 1) len (list-push acc (" (field-val " & ir-quote (f.name) & " " & ir-emit-expr (f.value) & ")"))

Section: Field Index Resolution

  ir-resolve-field-index : CodexType, Text -> Integer
  ir-resolve-field-index (ty) (name) =
   when ty
    is RecordTy (rn) (tvars) (fields) -> ir-find-field-in-record fields name 0
    is otherwise -> 0 - 1

  ir-find-field-in-record : List RecordField, Text, Integer -> Integer
  ir-find-field-in-record (fields) (name) (i) =
   if i >= list-length fields then 0 - 1
   else if ((list-at fields i).name).value == name then i
   else ir-find-field-in-record fields name (i + 1)

  ir-field-with-index : Text, Integer -> Text
  ir-field-with-index (name) (idx) =
   if idx >= 0 then name & "/" & integer-to-text idx
   else name

Section: IR Dead Code Elimination

 Reachability pruning of the chapter's def list. A def is kept when it
 is reachable, through referenced names, from the entry point. Operates
 on the structured IR -- no text, no Unicode. The collected name set is
 every atom the text emitter would quote, so the kept set matches a
 substring reachability over the emitted IR text. Type defs, ctors, and
 effect-op names live in the chapter header and are untouched.

  DceWork = record {
   visited : List Boolean,
   frontier : List Integer
  }

  ir-dce-append-list : List Text, Integer, List Text -> List Text
  ir-dce-append-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-append-list xs (i + 1) (list-push acc (list-at xs i))

 So the walk now collects REFERENCES only:

   IrName            a use of a definition -- the reference
   IrRecord          the constructor being applied
   IrCtorPat         the constructor being matched
   handler op-name   the effect operation a clause discharges
   handler resume    the continuation the clause may invoke
   IrHandle eff      the effect being handled
   IrWithTimeout     the effects and scopes it names

 and ignores BINDING occurrences (a let name, a parameter, a pattern
 variable, a clause parameter) because a binding introduces a name rather
 than reaching one, FIELD names because a field is selected from a record
 rather than called, and TEXT (literals, literal patterns, error messages)
 because Codex has no dispatch from a runtime string: there is no
 call-by-name, so a definition cannot be reached by spelling it.

 The one place a name in a string does reach a definition is the emitter
 calling a worker through a hardcoded string of its own -- the fat16
 servicers. That is not something this walk can see from the IR, and it is
 handled where it belongs, as an explicit root (cdx-emit-roots, opening).

  ir-dce-collect-expr : IRExpr, List Text -> List Text
  ir-dce-collect-expr (e) (acc) =
   when e
    is IrIntLit (n) (sp) | IrNumLit (n) (sp) -> acc
    is IrTextLit (s) (sp) -> acc
    is IrBoolLit (b) (sp) | IrCharLit (c) (sp) -> acc
    is IrName (n) (ty) (sp) -> list-push acc n
    is IrBinary (op) (l) (r) (ty) (sp) -> ir-dce-collect-expr r (ir-dce-collect-expr l acc)
    is IrNegate (x) (ty) (sp) -> ir-dce-collect-expr x acc
    is IrIf (c) (t) (el) (ty) (sp) -> ir-dce-collect-expr el (ir-dce-collect-expr t (ir-dce-collect-expr c acc))
    is IrLet (n) (ty) (v) (b) (sp) -> ir-dce-collect-expr b (ir-dce-collect-expr v acc)
    is IrApply (f) (a) (ty) (sp) -> ir-dce-collect-expr a (ir-dce-collect-expr f acc)
    is IrLambda (ps) (body) (ty) (sp) -> ir-dce-collect-expr body acc
    is IrList (es) (ty) (sp) -> ir-dce-collect-expr-list es 0 acc
    is IrMatch (sc) (bs) (ty) (sp) -> ir-dce-collect-branches bs 0 (ir-dce-collect-expr sc acc)
    is IrAct (ss) (ty) (sp) -> ir-dce-collect-stmts ss 0 acc
    is IrHandle (eff) (h) (cs) (ty) (sp) -> ir-dce-collect-clauses cs 0 (ir-dce-collect-expr h (list-push acc eff))
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> ir-dce-collect-expr body (ir-dce-append-list scopes 0 (ir-dce-append-list effs 0 acc))
    is IrRecord (n) (fs) (ty) (sp) -> ir-dce-collect-fields fs 0 (list-push acc n)
    is IrFieldAccess (r) (f) (ty) (sp) -> ir-dce-collect-expr r acc
    is IrFieldStore (r) (f) (v) (ty) (sp) -> ir-dce-collect-expr v (ir-dce-collect-expr r acc)
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> ir-dce-collect-stmts fail 0 (ir-dce-collect-stmts fb 0 (ir-dce-collect-stmts body 0 acc))
    is IrFork (b) (ty) (sp) -> ir-dce-collect-expr b acc
    is IrAwait (t) (ty) (sp) -> ir-dce-collect-expr t acc
    is IrError (m) (ty) (sp) -> acc

  ir-dce-collect-expr-list : List IRExpr, Integer, List Text -> List Text
  ir-dce-collect-expr-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-expr-list xs (i + 1) (ir-dce-collect-expr (list-at xs i) acc)

  ir-dce-collect-branches : List IRBranch, Integer, List Text -> List Text
  ir-dce-collect-branches (xs) (i) (acc) =
   if i == list-length xs then acc
   else let b = list-at xs i
   in ir-dce-collect-branches xs (i + 1) (ir-dce-collect-expr (b.guard) (ir-dce-collect-expr (b.body) (ir-dce-collect-pat (b.pattern) acc)))

  ir-dce-collect-pat : IRPat, List Text -> List Text
  ir-dce-collect-pat (p) (acc) =
   when p
    is IrVarPat (name) (ty) (sp) -> acc
    is IrLitPat (text) (ty) (sp) -> acc
    is IrCtorPat (name) (subs) (ty) (sp) -> ir-dce-collect-pat-list subs 0 (list-push acc name)
    is IrWildPat (sp) -> acc
    is IrVecPat (subs) (ty) (sp) -> ir-dce-collect-pat-list subs 0 acc

  ir-dce-collect-pat-list : List IRPat, Integer, List Text -> List Text
  ir-dce-collect-pat-list (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-pat-list xs (i + 1) (ir-dce-collect-pat (list-at xs i) acc)

  ir-dce-collect-stmts : List IRActStmt, Integer, List Text -> List Text
  ir-dce-collect-stmts (xs) (i) (acc) =
   if i == list-length xs then acc
   else ir-dce-collect-stmts xs (i + 1) (ir-dce-collect-stmt (list-at xs i) acc)

  ir-dce-collect-stmt : IRActStmt, List Text -> List Text
  ir-dce-collect-stmt (s) (acc) =
   when s
    is IrDoBind (n) (ty) (v) (sp) -> ir-dce-collect-expr v acc
    is IrDoExec (e) (sp) -> ir-dce-collect-expr e acc

  ir-dce-collect-clauses : List IRHandleClause, Integer, List Text -> List Text
  ir-dce-collect-clauses (xs) (i) (acc) =
   if i == list-length xs then acc
   else let c = list-at xs i
   in ir-dce-collect-clauses xs (i + 1) (ir-dce-collect-expr (c.body) (list-push (list-push acc (c.op-name)) (c.resume-name)))

  ir-dce-collect-fields : List IRFieldVal, Integer, List Text -> List Text
  ir-dce-collect-fields (xs) (i) (acc) =
   if i == list-length xs then acc
   else let f = list-at xs i
   in ir-dce-collect-fields xs (i + 1) (ir-dce-collect-expr (f.value) acc)

  ir-dce-build-index : List IRDef, Integer, Integer, OffsetTable -> OffsetTable
  ir-dce-build-index (defs) (i) (len) (tbl) =
   if i == len then tbl
   else ir-dce-build-index defs (i + 1) len (offset-table-set tbl ((list-at defs i).name) i)

  ir-dce-falses : Integer, Integer, List Boolean -> List Boolean
  ir-dce-falses (n) (i) (acc) =
   if i >= n then acc
   else ir-dce-falses n (i + 1) (list-push acc False)

  ir-dce-add-name : Text, OffsetTable, DceWork -> DceWork
  ir-dce-add-name (nm) (tbl) (w) =
   let j = offset-table-get tbl nm
   in if j < 0 then w
      else if list-at (w.visited) j then w
      else DceWork { visited = list-set-at (w.visited) j True, frontier = list-push (w.frontier) j }

  ir-dce-add-names : List Text, Integer, Integer, OffsetTable, DceWork -> DceWork
  ir-dce-add-names (names) (i) (len) (tbl) (w) =
   if i == len then w
   else ir-dce-add-names names (i + 1) len tbl (ir-dce-add-name (list-at names i) tbl w)

  ir-dce-flood : List IRDef, OffsetTable, Integer, DceWork -> DceWork
  ir-dce-flood (defs) (tbl) (i) (w) =
   if i >= list-length (w.frontier) then w
   else let cur = list-at (w.frontier) i
   in let names = ir-dce-collect-expr ((list-at defs cur).body) []
   in ir-dce-flood defs tbl (i + 1) (ir-dce-add-names names 0 (list-length names) tbl w)

  ir-dce-filter : List IRDef, List Boolean, Integer, Integer, List IRDef -> List IRDef
  ir-dce-filter (defs) (visited) (i) (len) (acc) =
   if i == len then acc
   else if list-at visited i then ir-dce-filter defs visited (i + 1) len (list-push acc (list-at defs i))
   else ir-dce-filter defs visited (i + 1) len acc

  ir-prune-unreachable : IRChapter, Text -> IRChapter
  ir-prune-unreachable (m) (root) = ir-prune-unreachable-roots m [root]

  ir-prune-unreachable-roots : IRChapter, List Text -> IRChapter
  ir-prune-unreachable-roots (m) (roots) =
   if list-length roots == 0 then m
   else ir-prune-roots-indexed m roots (ir-dce-build-index (m.defs) 0 (list-length (m.defs)) offset-table-empty)

  ir-prune-roots-indexed : IRChapter, List Text, OffsetTable -> IRChapter
  ir-prune-roots-indexed (m) (roots) (tbl) =
   if offset-table-get tbl (list-at roots 0) < 0 then m
   else ir-prune-roots-flood m roots tbl

  ir-prune-roots-flood : IRChapter, List Text, OffsetTable -> IRChapter
  ir-prune-roots-flood (m) (roots) (tbl) =
   let defs = m.defs
   in let n = list-length defs
   in let w0 = DceWork { visited = ir-dce-falses n 0 (__list-with-capacity n), frontier = [] }
   in let w = ir-dce-flood defs tbl 0 (ir-dce-add-names roots 0 (list-length roots) tbl w0)
   in __record-set m "defs" (ir-dce-filter defs (w.visited) 0 n [])

 This stores the filtered list back into the chapter it was given and
 hands back THE SAME record. Making it build a fresh chapter instead
 looks like the obvious correction -- a callee does not own a record its
 caller still holds -- and it is NOT a safe change: measured 2026-07-28,
 it makes `keep-proof-defs` collect from the unpruned list and every
 surviving definition gets appended back a second time by
 `ir-chapter-with-proofs`. A punctual function that survives the prune
 was emitted TWICE, at two addresses in the symbol map, and reported its
 WCET line twice. Callers that need the pre-prune list must bind it
 before calling, which is the same discipline `keep-proof-defs` above
 already follows and says so.

 Only an EXPLICIT budget is reported. A wcet-budget of zero means the
 author declared none and emit-wcet-check substitutes the default 256;
 that is not a claim anyone made, so a pruned punctual without a budget
 is ordinary dead code and says nothing.

 The walk takes two cursors rather than an index because ir-dce-filter
 preserves order, so the kept list is a subsequence of the original. That
 costs one pass and no allocation beyond the result. It assumes
 definition names are unique, which is no stronger an assumption than the
 prune already makes -- ir-dce-build-index keys the reachability table by
 the same name.

  ir-dropped-budgeted-punctuals : List IRDef, List IRDef -> List IRDef
  ir-dropped-budgeted-punctuals (all-defs) (kept) =
   ir-dbp-loop all-defs kept 0 0 []

  ir-dbp-loop : List IRDef, List IRDef, Integer, Integer, List IRDef -> List IRDef
  ir-dbp-loop (all-defs) (kept) (i) (j) (acc) =
   if i == list-length all-defs then acc
   else let d = list-at all-defs i
   in if j < list-length kept
      then if (list-at kept j).name == d.name
           then ir-dbp-loop all-defs kept (i + 1) (j + 1) acc
           else ir-dbp-take all-defs kept i j acc d
      else ir-dbp-take all-defs kept i j acc d

  ir-dbp-take : List IRDef, List IRDef, Integer, Integer, List IRDef, IRDef -> List IRDef
  ir-dbp-take (all-defs) (kept) (i) (j) (acc) (d) =
   if d.is-punctual
    then if d.wcet-budget > 0
         then ir-dbp-loop all-defs kept (i + 1) j (list-push acc d)
         else ir-dbp-loop all-defs kept (i + 1) j acc
    else ir-dbp-loop all-defs kept (i + 1) j acc

Section: IRDef Emission

 `unique-params` names the parameters declared `linear`. It is carried the
 whole length of the pipeline and consumed at x86 emit for noalias slots,
 and it was never printed, so linearity did not survive to this wire at
 all: `linear T` and `T` produced byte-identical IR text. It trails the
 form and is omitted when empty, so a def with no linear parameter keeps
 its exact previous spelling and a reader taking elements 1 through 7 is
 unaffected.

  ir-emit-unique : List Text -> Text
  ir-emit-unique (ns) =
   if list-length ns == 0 then ""
   else " (unique" & ir-cat (for n in ns -> " " & ir-quote n) & ")"

  ir-emit-def : IRDef -> Text
  ir-emit-def (d) =
   let punct = if d.is-punctual then "1" else "0"
   in "(def " & ir-quote (d.name) & " " & ir-quote (d.chapter-slug) & " (params" & ir-emit-params (d.params) 0 & ") " & ir-emit-type (d.type-val) & " " & ir-emit-expr (d.body) & " " & punct & " " & show (d.wcet-budget) & ir-emit-unique (d.unique-params) & ")"

  ir-emit-defs : List IRDef, Integer -> Text
  ir-emit-defs (xs) (i) =
   ir-cat (ir-emit-defs-acc xs i (list-length xs) [])

  ir-emit-defs-acc : List IRDef, Integer, Integer, List Text -> List Text
  ir-emit-defs-acc (xs) (i) (len) (acc) =
   if i == len then acc
   else ir-emit-defs-acc xs (i + 1) len (list-push acc ("\n  " & ir-emit-def (list-at xs i)))

Section: IRChapter Emission

  ir-emit-text-strs : List Text, Integer -> Text
  ir-emit-text-strs (xs) (i) =
   ir-cat (ir-strs-quoted xs i [])

  ir-emit-name-strs : List Name, Integer -> Text
  ir-emit-name-strs (xs) (i) =
   ir-cat (ir-names-quoted xs i [])

  ir-pblocks-quoted : List ProseBlock, Integer, List Text -> List Text
  ir-pblocks-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else let p = list-at xs i
   in ir-pblocks-quoted xs (i + 1) (list-push acc (" (pb " & ir-quote (p.anchor) & " " & ir-quote (p.text) & ")"))

  ir-emit-prose-blocks : List ProseBlock, Integer -> Text
  ir-emit-prose-blocks (xs) (i) =
   ir-cat (ir-pblocks-quoted xs i [])

  ir-anns-quoted : List AnnotationNode, Integer, List Text -> List Text
  ir-anns-quoted (xs) (i) (acc) =
   if i == list-length xs then acc
   else let a = list-at xs i
   in ir-anns-quoted xs (i + 1) (list-push acc (" (ann " & ir-quote (a.kind) & " " & ir-quote (a.target) & " " & ir-quote (a.body) & ")"))

  ir-emit-annotations : List AnnotationNode, Integer -> Text
  ir-emit-annotations (xs) (i) =
   ir-cat (ir-anns-quoted xs i [])

  emit-ir-chapter : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-ir-chapter (m) (meta) (type-defs) =
   emit-ir-chapter-prefix m meta type-defs & ir-emit-defs (m.defs) 0 & "))\n"

 `grounds` publishes the chapter's grounds table, one "slug\neffect"
 entry per grounded effect, exactly as the type checker holds it. It is
 keyed like every other form in this header rather than positional, so a
 reader that does not look it up is unaffected; `ir-quote` escapes the
 separating newline and the parser's tokenizer restores it, so the entry
 crosses the wire unchanged. Unlike `unique` it is emitted even when
 empty, matching its siblings here, and an ungrounded chapter pays ten
 bytes for `(grounds)`.

 The chapter header up to and including the "(defs" opener -- everything
 except the per-def list and the closing "))". emit-ir-cce (opening)
 does not call emit-ir-chapter: building the whole chapter as one value
 exhausted the allocator on a wide-citation program (a 17-cite test hit
 the heap floor under the framebuffer at the same address at -MemMB
 3072 and 6144, measured 2026-07-28 -- with no collector every interior
 & of the expression walk is a permanent copy, ir-cat then duplicates
 the payload, and the top-level & copies it again). It uses the two
 helpers below instead: one pass to learn the SIZE the wire frame
 announces before the first payload byte, one pass to print, each def
 bracketed in __heap-save/__heap-restore so peak heap is the largest
 single def. Emission is pure, so the passes agree. emit-ir-uni still
 builds the monolith; it has no SIZE frame and no known large caller.

 The pieces go out through print-text, and only print-text: a payload
 newline is the CCE byte inside the Text, and print-line's appended
 terminator is the raw serial 10, which compile.ps1's byte slice would
 count against SIZE. Delegating the joiners to print-line was tried
 2026-07-28 and corrupted exactly those bytes; the account is in
 red-workplan's outbox. So every "\n  " joiner stays inside its piece,
 the footer keeps its own newline, and the one raw linefeed after the
 payload is print-line's, exactly as the monolith's print-line emitted
 it.

  ir-defs-wire-size : List IRDef, Integer, Integer, Integer -> Integer
  ir-defs-wire-size (xs) (i) (len) (acc) =
   if i == len then acc
   else let h = __heap-save
   in let n = text-length (ir-emit-def (list-at xs i))
   in let restored = __heap-restore h
   in ir-defs-wire-size xs (i + 1) len (acc + n + 3)

 **It has its own flag rather than riding `debug`, and that is not tidiness.**
 Wired behind `debug` first, it printed nothing at all: `IR-CCE debug` empties
 the chapter. Measured 2026-08-04 on the compiler's own source, same kernel and
 same input, `IR-CCE` runs 28 s and dies OUT OF MEMORY while `IR-CCE debug`
 finishes in 5 s announcing `SIZE:130` with zero definitions -- and it does the
 same on `seed#587` and `seed#586`, so it long predates this instrument. An
 instrument gated on the flag that destroys its own subject measures nothing,
 which is what running it against the real input is for.

 **Print through `print-line-uni`, never `print-text`.** `print-text` emits CCE,
 which is right for the payload and unreadable as ASCII in a raw capture: these
 three probes first shipped on `print-text` and 390 KB of trace read as an empty
 output, which cost a wrong published finding about where the emit dies.

  ir-trace-dce-cost : List IRDef, Integer, Integer -> [Console] Nothing
  ir-trace-dce-cost (xs) (i) (len) =
   if i >= len then print-line-uni "DCE-END"
   else let d = list-at xs i
   in act
    print-line-uni ("DCE " & integer-to-text i & " " & d.name)
    let h = __heap-save
    in let names = ir-dce-collect-expr (d.body) []
    in let k = list-length names
    in let after = __heap-save
    in let restored = __heap-restore h
    in act
     print-line-uni ("DCE-K " & integer-to-text k & " bytes " & integer-to-text (after - h))
     ir-trace-dce-cost xs (i + 1) len
    end
   end

  ir-trace-def-sizes : List IRDef, Integer, Integer -> [Console] Nothing
  ir-trace-def-sizes (xs) (i) (len) =
   if i >= len then print-line-uni "WSZ-END"
   else let d = list-at xs i
   in act
    print-line-uni ("WSZ " & integer-to-text i & " " & d.name)
    let h = __heap-save
    in let n = text-length (ir-emit-def d)
    in let restored = __heap-restore h
    in act
     print-line-uni ("WSZ-SIZE " & integer-to-text n)
     ir-trace-def-sizes xs (i + 1) len
    end
   end

  ir-print-defs : List IRDef, Integer, Integer -> [Console] Nothing
  ir-print-defs (xs) (i) (len) =
   if i == len then print-text "))\n"
   else let h = __heap-save
   in act
    print-text ("\n  " & ir-emit-def (list-at xs i))
    let restored = __heap-restore h
    in ir-print-defs xs (i + 1) len
   end

  emit-ir-chapter-prefix : IRChapter, IRTextMeta, List ATypeDef -> Text
  emit-ir-chapter-prefix (m) (meta) (type-defs) =
   "(chapter "
    & ir-quote (m.name.value) & "\n  "
    & "(title " & ir-quote (meta.chapter-title) & ")\n  "
    & "(prose " & ir-quote (meta.prose) & ")\n  "
    & "(pblocks" & ir-emit-prose-blocks (meta.prose-blocks) 0 & ")\n  "
    & "(anns" & ir-emit-annotations (meta.annotations) 0 & ")\n  "
    & "(sections" & ir-emit-text-strs (meta.section-titles) 0 & ")\n  "
    & "(ctors" & ir-emit-text-strs (meta.ctor-names) 0 & ")\n  "
    & "(eff-ops" & ir-emit-text-strs (m.effect-op-names) 0 & ")\n  "
    & "(grounds" & ir-emit-text-strs (meta.ground-effects) 0 & ")\n  "
    & "(type-defs" & ir-emit-atype-defs type-defs 0 & ")\n  "
    & "(defs"

Page 1


Chapter: Parsmi--Occurrence
  cites Codex chapter Build Settings (max-recursion-depth)

 This unit is an ANALYSIS. It reads IRExpr and returns a result; it
 rewrites nothing and it is not wired into the pipeline that produces
 binaries. It is dead code in the shipping compiler -- parsed and
 type-checked with the rest of the tree, but unreachable from
 `opening`, so codegen tree-shakes it and the self-compile is
 byte-identical to the seed. It links into WS-D3 when the simplifier
 that consumes it lands, exactly as the interval kernel waited for its
 consumer.

 The count is computed in ONE pass, not per-name. Counting one name at
 a time over a tree is quadratic in the number of binders; instead each
 subtree returns the MAP from every free name to its OccCount, and a
 parent combines its children's maps. Union SUMS counts: a name free in
 two siblings is used at least twice, so it is Many. This is
 deliberately conservative at joins -- the two arms of an IrIf are
 alternatives, not both taken, yet their maps are summed, so a name
 used once in each arm classifies Many. That is the SAFE direction for
 the inliner it feeds: inlining an occurs-once binding into both arms
 of a case duplicates the bound work down every path, which occurs-once
 inlining must never do. Over-counting to Many forbids exactly that;
 under-counting to Once would license it. So the join sums.

 Scope removal is the crux. At every binder -- the name of an IrLet, the
 parameters of an IrLambda, the variables of a match pattern, the
 binder of an IrDoBind -- the name's occurrences in the body are what is
 reported FOR THAT BINDER, and the name is REMOVED from the map that
 propagates upward, because it is not free above its binder. Shadowing
 falls out for free: removing the name at the inner binder consumes the
 inner occurrences; the outer binder of the same name sees only what is
 left, which is why an inner and an outer binding of one name are
 classified independently. The tree is correctly nested (the 2.22 bug
 was the emitter's flat table, never the tree), so lexical scope is
 just structural recursion.

 The walk is depth-bounded by the compiler's shared recursion budget,
 so a pathological IR is reported as unwalked rather than hung -- the
 analysis never answers about a subtree it did not read.

 Limitations, stated so they are not assumed away: the join is
 conservative (once-per-arm reads as Many), which is sound for the
 inliner but not tight for a size heuristic that later wants the true
 per-arm count; loop-breaker selection for recursive binding groups
 (the other half of GHC's occurrence analyser) is not done here, because
 this IR has no recursive let groups -- recursion is between top-level
 definitions, which this per-definition analysis does not cross; and the
 map is an association list scanned linearly, chosen for the binder
 counts a single definition carries, not for a definition with thousands
 of distinct free names.

Section: Occurrence Count

 Dead is absence: a name with no free occurrence is never stored in a
 map, and a lookup that misses answers Dead. occ-bump records one more
 occurrence -- the only way a count ever rises -- and saturates at Many,
 because the classification cares only about zero, one, and many.

  OccCount =
   | OccDead
   | OccOnce
   | OccMany

  occ-bump : OccCount -> OccCount
  occ-bump (c) =
   when c
    is OccDead -> OccOnce
    is OccOnce -> OccMany
    is OccMany -> OccMany

  occ-count-name : OccCount -> Text
  occ-count-name (c) =
   when c
    is OccDead -> "Dead"
    is OccOnce -> "Once"
    is OccMany -> "Many"

Section: Occurrence Map

  OccEntry = record {
   name : Text,
   count : OccCount
  }

  OccResult = record {
   free : List OccEntry,
   binders : List OccEntry
  }

  occ-map-find : List OccEntry, Text, Integer, Integer -> Integer
  occ-map-find (m) (n) (i) (len) =
   if i >= len then 0 - 1
   else if (list-at m i).name == n then i
   else occ-map-find m n (i + 1) len

  occ-map-get : List OccEntry, Text -> OccCount
  occ-map-get (m) (n) =
   let i = occ-map-find m n 0 (list-length m)
   in if i < 0 then OccDead else (list-at m i).count

  occ-insert : List OccEntry, Text, OccCount -> List OccEntry
  occ-insert (m) (n) (c) =
   let i = occ-map-find m n 0 (list-length m)
   in if i < 0 then list-push m (OccEntry { name = n, count = c })
   else list-set-at m i (OccEntry { name = n, count = occ-bump ((list-at m i).count) })

  occ-singleton : Text -> List OccEntry
  occ-singleton (n) = occ-insert [] n (occ-bump OccDead)

  occ-union : List OccEntry, List OccEntry -> List OccEntry
  occ-union (m1) (m2) = occ-union-loop m1 m2 0 (list-length m2)

  occ-union-loop : List OccEntry, List OccEntry, Integer, Integer -> List OccEntry
  occ-union-loop (acc) (m2) (i) (len) =
   if i >= len then acc
   else let e = list-at m2 i
   in occ-union-loop (occ-insert acc (e.name) (e.count)) m2 (i + 1) len

  occ-remove : List OccEntry, Text -> List OccEntry
  occ-remove (m) (n) = occ-remove-loop [] m n 0 (list-length m)

  occ-remove-loop : List OccEntry, List OccEntry, Text, Integer, Integer -> List OccEntry
  occ-remove-loop (acc) (m) (n) (i) (len) =
   if i >= len then acc
   else let e = list-at m i
   in occ-remove-loop (if (e.name) == n then acc else list-push acc e) m n (i + 1) len

  occ-bind-one : Text, List OccEntry, List OccEntry -> OccResult
  occ-bind-one (n) (free) (binders) =
   OccResult {
    free = occ-remove free n,
    binders = list-push binders (OccEntry { name = n, count = occ-map-get free n })
   }

Section: Expression Walk

  occ-expr : IRExpr, List OccEntry, Integer -> OccResult
  occ-expr (e) (acc) (depth) =
   if depth >= max-recursion-depth then OccResult { free = [], binders = acc }
   else when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> OccResult { free = [], binders = acc }
    is IrName (n) (t) (s) -> OccResult { free = occ-singleton n, binders = acc }
    is IrNegate (x) (t) (s) -> occ-expr x acc (depth + 1)
    is IrBinary (op) (l) (r) (t) (s) ->
     let rl = occ-expr l acc (depth + 1)
     in let rr = occ-expr r (rl.binders) (depth + 1)
     in OccResult { free = occ-union (rl.free) (rr.free), binders = rr.binders }
    is IrIf (c) (th) (el) (t) (s) ->
     let rc = occ-expr c acc (depth + 1)
     in let rt = occ-expr th (rc.binders) (depth + 1)
     in let re = occ-expr el (rt.binders) (depth + 1)
     in OccResult { free = occ-union (rc.free) (occ-union (rt.free) (re.free)), binders = re.binders }
    is IrLet (n) (t) (v) (b) (s) ->
     let rv = occ-expr v acc (depth + 1)
     in let rb = occ-expr b (rv.binders) (depth + 1)
     in OccResult {
      free = occ-union (rv.free) (occ-remove (rb.free) n),
      binders = list-push (rb.binders) (OccEntry { name = n, count = occ-map-get (rb.free) n })
     }
    is IrApply (f) (a) (t) (s) ->
     let rf = occ-expr f acc (depth + 1)
     in let ra = occ-expr a (rf.binders) (depth + 1)
     in OccResult { free = occ-union (rf.free) (ra.free), binders = ra.binders }
    is IrLambda (ps) (b) (t) (s) ->
     let rb = occ-expr b acc (depth + 1)
     in occ-bind-params ps (rb.free) (rb.binders) 0 (list-length ps)
    is IrList (es) (t) (s) -> occ-exprs es acc (depth + 1) 0 (list-length es) []
    is IrMatch (sc) (bs) (t) (s) ->
     let rsc = occ-expr sc acc (depth + 1)
     in occ-branches bs (rsc.free) (rsc.binders) (depth + 1) 0 (list-length bs)
    is IrAct (ss) (t) (s) -> occ-stmts ss acc (depth + 1) 0 (list-length ss)
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let rh = occ-expr h acc (depth + 1)
     in occ-clauses cs (rh.free) (rh.binders) (depth + 1) 0 (list-length cs)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> occ-expr body acc (depth + 1)
    is IrRecord (n) (fs) (t) (s) -> occ-fields fs acc (depth + 1) 0 (list-length fs) []
    is IrFieldAccess (r) (f) (t) (s) -> occ-expr r acc (depth + 1)
    is IrFork (b) (t) (s) -> occ-expr b acc (depth + 1)
    is IrAwait (tk) (t) (s) -> occ-expr tk acc (depth + 1)
    is IrTry (mx) (body) (fb) (fail) (t) (s) ->
     let r1 = occ-stmts body acc (depth + 1) 0 (list-length body)
     in let r2 = occ-stmts fb (r1.binders) (depth + 1) 0 (list-length fb)
     in let r3 = occ-stmts fail (r2.binders) (depth + 1) 0 (list-length fail)
     in OccResult { free = occ-union (r1.free) (occ-union (r2.free) (r3.free)), binders = r3.binders }
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let rr = occ-expr r acc (depth + 1)
     in let rv = occ-expr v (rr.binders) (depth + 1)
     in OccResult { free = occ-union (rr.free) (rv.free), binders = rv.binders }
    is IrError (m) (t) (s) -> OccResult { free = [], binders = acc }

  occ-exprs : List IRExpr, List OccEntry, Integer, Integer, Integer, List OccEntry -> OccResult
  occ-exprs (es) (acc) (depth) (i) (len) (freeacc) =
   if i >= len then OccResult { free = freeacc, binders = acc }
   else let r = occ-expr (list-at es i) acc depth
   in occ-exprs es (r.binders) depth (i + 1) len (occ-union freeacc (r.free))

  occ-fields : List IRFieldVal, List OccEntry, Integer, Integer, Integer, List OccEntry -> OccResult
  occ-fields (fs) (acc) (depth) (i) (len) (freeacc) =
   if i >= len then OccResult { free = freeacc, binders = acc }
   else let f = list-at fs i
   in let r = occ-expr (f.value) acc depth
   in occ-fields fs (r.binders) depth (i + 1) len (occ-union freeacc (r.free))

  occ-bind-params : List IRParam, List OccEntry, List OccEntry, Integer, Integer -> OccResult
  occ-bind-params (ps) (free) (binders) (i) (len) =
   if i >= len then OccResult { free = free, binders = binders }
   else let p = list-at ps i
   in let r = occ-bind-one (p.name) free binders
   in occ-bind-params ps (r.free) (r.binders) (i + 1) len

 An act statement's binder is in scope for the statements after it. The
 rest of the sequence is analysed first; a bind reads its classification
 from that tail's free map and removes its name before the map rises.

  occ-stmts : List IRActStmt, List OccEntry, Integer, Integer, Integer -> OccResult
  occ-stmts (ss) (acc) (depth) (i) (len) =
   if i >= len then OccResult { free = [], binders = acc }
   else let s = list-at ss i
   in when s
    is IrDoExec (v) (sp) ->
     let rv = occ-expr v acc depth
     in let rrest = occ-stmts ss (rv.binders) depth (i + 1) len
     in OccResult { free = occ-union (rv.free) (rrest.free), binders = rrest.binders }
    is IrDoBind (n) (t) (v) (sp) ->
     let rv = occ-expr v acc depth
     in let rrest = occ-stmts ss (rv.binders) depth (i + 1) len
     in OccResult {
      free = occ-union (rv.free) (occ-remove (rrest.free) n),
      binders = list-push (rrest.binders) (OccEntry { name = n, count = occ-map-get (rrest.free) n })
     }

  occ-branches : List IRBranch, List OccEntry, List OccEntry, Integer, Integer, Integer -> OccResult
  occ-branches (bs) (free) (binders) (depth) (i) (len) =
   if i >= len then OccResult { free = free, binders = binders }
   else let b = list-at bs i
   in let rg = occ-expr (b.guard) binders depth
   in let rbody = occ-expr (b.body) (rg.binders) depth
   in let branchfree = occ-union (rg.free) (rbody.free)
   in let pr = occ-bind-pat branchfree (b.pattern) (rbody.binders) depth
   in occ-branches bs (occ-union free (pr.free)) (pr.binders) depth (i + 1) len

  occ-bind-pat : List OccEntry, IRPat, List OccEntry, Integer -> OccResult
  occ-bind-pat (free) (p) (binders) (depth) =
   if depth >= max-recursion-depth then OccResult { free = free, binders = binders }
   else when p
    is IrVarPat (n) (t) (s) -> occ-bind-one n free binders
    is IrCtorPat (n) (subs) (t) (s) -> occ-bind-pat-list free subs binders (depth + 1) 0 (list-length subs)
    is IrVecPat (subs) (t) (s) -> occ-bind-pat-list free subs binders (depth + 1) 0 (list-length subs)
    is otherwise -> OccResult { free = free, binders = binders }

  occ-bind-pat-list : List OccEntry, List IRPat, List OccEntry, Integer, Integer, Integer -> OccResult
  occ-bind-pat-list (free) (ps) (binders) (depth) (i) (len) =
   if i >= len then OccResult { free = free, binders = binders }
   else let r = occ-bind-pat free (list-at ps i) binders depth
   in occ-bind-pat-list (r.free) ps (r.binders) depth (i + 1) len

  occ-clauses : List IRHandleClause, List OccEntry, List OccEntry, Integer, Integer, Integer -> OccResult
  occ-clauses (cs) (free) (binders) (depth) (i) (len) =
   if i >= len then OccResult { free = free, binders = binders }
   else let c = list-at cs i
   in let rb = occ-expr (c.body) binders depth
   in let r1 = occ-bind-names (rb.free) (c.params) (rb.binders) 0 (list-length (c.params))
   in let r2 = occ-bind-one (c.resume-name) (r1.free) (r1.binders)
   in occ-clauses cs (occ-union free (r2.free)) (r2.binders) depth (i + 1) len

  occ-bind-names : List OccEntry, List Text, List OccEntry, Integer, Integer -> OccResult
  occ-bind-names (free) (ns) (binders) (i) (len) =
   if i >= len then OccResult { free = free, binders = binders }
   else let r = occ-bind-one (list-at ns i) free binders
   in occ-bind-names (r.free) ns (r.binders) (i + 1) len

Section: Definition Analysis

 The per-definition result the WS-D3 simplifier consumes: one entry per
 binder in the definition, parameters first in declaration order, then
 the internal binders in traversal order. A parameter's classification
 is read from the free map of the whole body.

  occ-analyse-def : IRDef -> List OccEntry
  occ-analyse-def (d) =
   let r = occ-expr (d.body) [] 0
   in (occ-classify-params (d.params) (r.free) 0 (list-length (d.params)) []) & (r.binders)

  occ-classify-params : List IRParam, List OccEntry, Integer, Integer, List OccEntry -> List OccEntry
  occ-classify-params (ps) (free) (i) (len) (acc) =
   if i >= len then acc
   else let p = list-at ps i
   in occ-classify-params ps free (i + 1) len (list-push acc (OccEntry { name = p.name, count = occ-map-get free (p.name) }))

  occ-report-chapter : IRChapter -> List Text
  occ-report-chapter (ch) = occ-report-defs (ch.defs) 0 (list-length (ch.defs)) []

  occ-report-defs : List IRDef, Integer, Integer, List Text -> List Text
  occ-report-defs (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in let es = occ-analyse-def d
   in occ-report-defs defs (i + 1) len (list-push acc ("OCC " & (d.name) & ": " & occ-join es 0 (list-length es) ""))

  occ-join : List OccEntry, Integer, Integer, Text -> Text
  occ-join (es) (i) (len) (acc) =
   if i >= len then acc
   else let e = list-at es i
   in occ-join es (i + 1) len (acc & (if acc == "" then "" else ", ") & (e.name) & "=" & occ-count-name (e.count))

 The occurrence report is INFORMATION about well-formed IR, not a
 fault, so it carries an info-severity code of its own. It must not be
 `ir-check`'s CDX9004, which means malformed IR: sharing that code
 would make a real IR corruption and an occurrence line indistinguishable
 to anyone grepping for the former. CDX4030 sits in the info band beside
 CDX4010 (bounds proven) and CDX4020 (proof erased); info diagnostics do
 not set the error flag, so `occ-report` reports and the compile still
 emits its binary.

  cdx-occ-report : Integer = 4030

  occ-info-bag : List Text -> DiagnosticBag
  occ-info-bag (lines) = occ-info-bag-loop empty-bag lines 0 (list-length lines)

  occ-info-bag-loop : DiagnosticBag, List Text, Integer, Integer -> DiagnosticBag
  occ-info-bag-loop (bag) (lines) (i) (len) =
   if i >= len then bag
   else occ-info-bag-loop (bag-add bag (make-info cdx-occ-report (list-at lines i) synthetic-span)) lines (i + 1) len

Page 1


Chapter: Parsmi--IRCheck
  cites Codex chapter Build Settings (max-recursion-depth)

 It is opt-in, and it is off in `default-ir-pipeline`. The shipping
 compiler pays nothing for it: no walk, no skip list, no allocation.
 Turn it on when a pass is under suspicion, and it is on for every
 definition in the chapter, which for a self-compile is every function
 in the compiler.

 Three things are checked, and only three.

 **Scope discipline under shadowing.** Every `IrName` must be bound by
 something. The scope walk seeds from the definition's parameters and
 admits binders from `IrLet`, `IrLambda`, match branch patterns
 (including constructor sub-patterns), `IrDoBind`, and handle clause
 parameters and resume names. But this IR legitimately names things
 that no binder introduced -- chapter-level definitions, builtins,
 effect operations, nullary constructors -- and the emitter resolves
 exactly those four when a name misses the locals (`emit-name`:
 locals, then `is-builtin`, then the user-arity table, then the
 handler table, then a nullary constructor tag). So the checker admits
 the same four, and a name is a violation only when it is in none of
 them. **A false positive here is worse than a miss.** Constructors are
 admitted by the name-resolver's own `is-type-name`, because the ctor
 list is not carried on the IRChapter; that is the one place this check
 is coarser than the emitter, and it is coarse in the safe direction.

 **Type presence.** Every expression node, parameter, and definition
 that carries a `CodexType` carries a resolved one. `ErrorTy` there
 means an earlier phase failed silently.

 The contract is not universal, and finding out where it fails was the
 first thing this checker did. **Three places in the IR carry `ErrorTy`
 on perfectly valid programs today**, and all three are excluded from
 the check rather than papered over:

 1. **Constructor sub-patterns** -- `lookup-ctor-field-type` answers
    `ErrorTy` for any scrutinee not already a resolved `SumTy`, which
    is every polymorphic sum. `when b is Wrap (x)` types `x` as
    `ErrorTy`.
 2. **The element type of an empty `IrList`** -- `[]` has no element to
    take a type from.
 3. **Un-annotated lambdas** -- `let f = \a -> a + a in ...` lowers the
    `IrLambda`, its parameters, and the `IrLet` that binds it with
    `ErrorTy`; nothing carries the checker's inferred type down into
    lowering for that node.

 None of the three is a miscompile -- codegen never reads those slots.
 All three are a warning to the middle-end campaign: **a pass may not
 yet reason from a type it reads out of the IR** without knowing which
 of these it is standing on. They are the honest reason the ErrorTy
 check is narrower than "every node".

 **Structural sanity.** A match with no branches, an apply whose
 function position is a literal, a let that binds the empty name.

 Limitations, stated so they are not assumed away: the three type holes
 above are not checked; the ErrorTy check is otherwise shallow (an
 `ErrorTy` nested inside a `ListTy` is not reported); no effect-row
 agreement is checked; no arity checking; a constructor name is
 admitted on its spelling, not against a constructor table; and the
 walk is depth- and scope-bounded, so a pathological tree is reported
 as unchecked rather than walked forever.

Section: Diagnostic Code

 9xxx is the compiler-internal band (CdxCodes: 9001 resource exhausted,
 9002 deck overflow, 9003 escape violation). A malformed IR is the
 compiler's fault, never the program's, so it belongs here and nowhere
 else. The constant lives beside its only producer until CdxCodes can
 be edited to carry the registry entry.

  cdx-ir-check-violation : Integer = 9004

Section: Bounds

 The walk is bounded twice. Depth is the recursion budget every other
 tree walker in the compiler uses, so a cyclic or pathological IR
 cannot hang the checker. Scope is a fixed stack of names: binders are
 written into it by index and the count in hand is the only authority
 on what is in scope, which is what makes shadowing correct -- a sibling
 branch overwrites its predecessor's slots rather than inheriting them.
 The stack is allocated once for the whole chapter and never grows, so
 the scope walk allocates nothing per definition.

 Exhausting either bound is itself reported. The checker never answers
 "clean" about a subtree it did not read.

  ir-check-scope-cap : Integer = 1024

Section: Entry Point

  ir-check : IRChapter -> List Text
  ir-check (ch) =
   let globals = ir-check-globals ch
   in let stack = ir-check-make-stack 0 []
   in ir-check-defs globals stack (ch.defs) 0 (list-length (ch.defs)) []

  ir-check-globals : IRChapter -> SkipListText
  ir-check-globals (ch) =
   let s0 = skip-list-text-from-list builtin-names
   in let s1 = ir-check-add-def-names s0 (ch.defs) 0 (list-length (ch.defs))
   in ir-check-add-names s1 (ch.effect-op-names) 0 (list-length (ch.effect-op-names))

  ir-check-add-def-names : SkipListText, List IRDef, Integer, Integer -> SkipListText
  ir-check-add-def-names (s) (defs) (i) (len) =
   if i >= len then s
   else ir-check-add-def-names (skip-list-text-insert s ((list-at defs i).name)) defs (i + 1) len

  ir-check-add-names : SkipListText, List Text, Integer, Integer -> SkipListText
  ir-check-add-names (s) (xs) (i) (len) =
   if i >= len then s
   else ir-check-add-names (skip-list-text-insert s (list-at xs i)) xs (i + 1) len

  ir-check-make-stack : Integer, List Text -> List Text
  ir-check-make-stack (i) (acc) =
   if i >= ir-check-scope-cap then acc
   else ir-check-make-stack (i + 1) (list-push acc "")

Section: Environment

  IRCheckEnv = record {
   globals : SkipListText,
   scope : List Text,
   def-name : Text
  }

  ir-check-msg : IRCheckEnv, Text -> Text
  ir-check-msg (env) (m) = (env.def-name) & ": " & m

  ir-check-push : IRCheckEnv, Text, Integer -> Integer
  ir-check-push (env) (n) (nb) =
   if nb >= ir-check-scope-cap then nb
   else let written = list-set-at (env.scope) nb n
   in nb + 1

  ir-check-push-names : IRCheckEnv, List Text, Integer, Integer, Integer -> Integer
  ir-check-push-names (env) (xs) (i) (len) (nb) =
   if i >= len then nb
   else ir-check-push-names env xs (i + 1) len (ir-check-push env (list-at xs i) nb)

  ir-check-in-scope : IRCheckEnv, Text, Integer -> Boolean
  ir-check-in-scope (env) (n) (nb) = ir-check-scan (env.scope) n (nb - 1)

  ir-check-scan : List Text, Text, Integer -> Boolean
  ir-check-scan (stack) (n) (i) =
   if i < 0 then False
   else if list-at stack i == n then True
   else ir-check-scan stack n (i - 1)

Section: Predicates

  ir-check-is-error-ty : CodexType -> Boolean
  ir-check-is-error-ty (t) =
   when t
    is ErrorTy -> True
    is otherwise -> False

  ir-check-is-literal : IRExpr -> Boolean
  ir-check-is-literal (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> True
    is otherwise -> False

  ir-check-is-lambda : IRExpr -> Boolean
  ir-check-is-lambda (e) =
   when e
    is IrLambda (ps) (b) (t) (s) -> True
    is otherwise -> False

  ir-check-ty : IRCheckEnv, CodexType, Text, List Text -> List Text
  ir-check-ty (env) (t) (kind) (acc) =
   if ir-check-is-error-ty t then list-push acc (ir-check-msg env (kind & " carries ErrorTy"))
   else acc

Section: Definitions

  ir-check-defs : SkipListText, List Text, List IRDef, Integer, Integer, List Text -> List Text
  ir-check-defs (globals) (stack) (defs) (i) (len) (acc) =
   if i >= len then acc
   else ir-check-defs globals stack defs (i + 1) len (ir-check-def globals stack (list-at defs i) acc)

  ir-check-def : SkipListText, List Text, IRDef, List Text -> List Text
  ir-check-def (globals) (stack) (d) (acc) =
   let env = IRCheckEnv { globals = globals, scope = stack, def-name = d.name }
   in let params = d.params
   in let nb = ir-check-bind-params env params 0 (list-length params) 0
   in let acc1 = ir-check-param-types env params 0 (list-length params) acc
   in let acc2 = ir-check-ty env (d.type-val) "definition" acc1
   in ir-check-expr env (d.body) nb 0 acc2

  ir-check-bind-params : IRCheckEnv, List IRParam, Integer, Integer, Integer -> Integer
  ir-check-bind-params (env) (ps) (i) (len) (nb) =
   if i >= len then nb
   else ir-check-bind-params env ps (i + 1) len (ir-check-push env ((list-at ps i).name) nb)

  ir-check-param-types : IRCheckEnv, List IRParam, Integer, Integer, List Text -> List Text
  ir-check-param-types (env) (ps) (i) (len) (acc) =
   if i >= len then acc
   else let p = list-at ps i
   in ir-check-param-types env ps (i + 1) len (ir-check-ty env (p.type-val) ("parameter '" & (p.name) & "'") acc)

Section: Expressions

  ir-check-expr : IRCheckEnv, IRExpr, Integer, Integer, List Text -> List Text
  ir-check-expr (env) (e) (nb) (depth) (acc) =
   if depth >= max-recursion-depth then list-push acc (ir-check-msg env "IR depth budget exhausted; subtree not checked")
   else if nb >= ir-check-scope-cap then list-push acc (ir-check-msg env "scope budget exhausted; subtree not checked")
   else when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> acc
    is IrName (n) (t) (s) ->
     let acc1 = ir-check-ty env t ("IrName '" & n & "'") acc
     in if ir-check-in-scope env n nb then acc1
        else if skip-list-text-has (env.globals) n then acc1
        else if is-type-name n then acc1
        else list-push acc1 (ir-check-msg env ("unbound name '" & n & "'"))
    is IrNegate (x) (t) (s) -> ir-check-expr env x nb (depth + 1) acc
    is IrBinary (op) (l) (r) (t) (s) ->
     let acc1 = ir-check-ty env t "IrBinary" acc
     in let acc2 = ir-check-expr env l nb (depth + 1) acc1
     in ir-check-expr env r nb (depth + 1) acc2
    is IrIf (c) (th) (el) (t) (s) ->
     let acc1 = ir-check-ty env t "IrIf" acc
     in let acc2 = ir-check-expr env c nb (depth + 1) acc1
     in let acc3 = ir-check-expr env th nb (depth + 1) acc2
     in ir-check-expr env el nb (depth + 1) acc3
    is IrLet (n) (t) (v) (b) (s) ->
     let acc1 = if ir-check-is-lambda v then acc else ir-check-ty env t ("IrLet '" & n & "'") acc
     in let acc2 = if n == "" then list-push acc1 (ir-check-msg env "IrLet binds the empty name") else acc1
     in let acc3 = ir-check-expr env v nb (depth + 1) acc2
     in ir-check-expr env b (ir-check-push env n nb) (depth + 1) acc3
    is IrApply (f) (a) (t) (s) ->
     let acc1 = ir-check-ty env t "IrApply" acc
     in let acc2 = if ir-check-is-literal f then list-push acc1 (ir-check-msg env "IrApply applies a literal in function position") else acc1
     in let acc3 = ir-check-expr env f nb (depth + 1) acc2
     in ir-check-expr env a nb (depth + 1) acc3
    is IrLambda (ps) (b) (t) (s) ->
     ir-check-expr env b (ir-check-bind-params env ps 0 (list-length ps) nb) (depth + 1) acc
    is IrList (es) (t) (s) ->
     let acc1 = if list-length es == 0 then acc else ir-check-ty env t "IrList" acc
     in ir-check-exprs env es nb (depth + 1) 0 (list-length es) acc1
    is IrMatch (sc) (bs) (t) (s) ->
     let acc1 = ir-check-ty env t "IrMatch" acc
     in let acc2 = if list-length bs == 0 then list-push acc1 (ir-check-msg env "IrMatch has no branches") else acc1
     in let acc3 = ir-check-expr env sc nb (depth + 1) acc2
     in ir-check-branches env bs nb (depth + 1) 0 (list-length bs) acc3
    is IrAct (ss) (t) (s) ->
     let acc1 = ir-check-ty env t "IrAct" acc
     in ir-check-stmts env ss nb (depth + 1) 0 (list-length ss) acc1
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let acc1 = ir-check-ty env t "IrHandle" acc
     in let acc2 = ir-check-expr env h nb (depth + 1) acc1
     in ir-check-clauses env cs nb (depth + 1) 0 (list-length cs) acc2
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) ->
     let acc1 = ir-check-ty env t "IrWithTimeout" acc
     in ir-check-expr env body nb (depth + 1) acc1
    is IrRecord (n) (fs) (t) (s) ->
     let acc1 = ir-check-ty env t ("IrRecord '" & n & "'") acc
     in ir-check-fields env fs nb (depth + 1) 0 (list-length fs) acc1
    is IrFieldAccess (r) (f) (t) (s) ->
     let acc1 = ir-check-ty env t ("IrFieldAccess '" & f & "'") acc
     in ir-check-expr env r nb (depth + 1) acc1
    is IrFork (b) (t) (s) ->
     let acc1 = ir-check-ty env t "IrFork" acc
     in ir-check-expr env b nb (depth + 1) acc1
    is IrAwait (tk) (t) (s) ->
     let acc1 = ir-check-ty env t "IrAwait" acc
     in ir-check-expr env tk nb (depth + 1) acc1
    is IrTry (mx) (body) (fb) (fail) (t) (s) ->
     let acc1 = ir-check-ty env t "IrTry" acc
     in let acc2 = ir-check-stmts env body nb (depth + 1) 0 (list-length body) acc1
     in let acc3 = ir-check-stmts env fb nb (depth + 1) 0 (list-length fb) acc2
     in ir-check-stmts env fail nb (depth + 1) 0 (list-length fail) acc3
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let acc1 = ir-check-ty env t ("IrFieldStore '" & f & "'") acc
     in let acc2 = ir-check-expr env r nb (depth + 1) acc1
     in ir-check-expr env v nb (depth + 1) acc2
    is IrError (m) (t) (s) -> ir-check-ty env t "IrError" acc

  ir-check-exprs : IRCheckEnv, List IRExpr, Integer, Integer, Integer, Integer, List Text -> List Text
  ir-check-exprs (env) (es) (nb) (depth) (i) (len) (acc) =
   if i >= len then acc
   else ir-check-exprs env es nb depth (i + 1) len (ir-check-expr env (list-at es i) nb depth acc)

  ir-check-fields : IRCheckEnv, List IRFieldVal, Integer, Integer, Integer, Integer, List Text -> List Text
  ir-check-fields (env) (fs) (nb) (depth) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fs i
   in ir-check-fields env fs nb depth (i + 1) len (ir-check-expr env (f.value) nb depth acc)

  ir-check-stmts : IRCheckEnv, List IRActStmt, Integer, Integer, Integer, Integer, List Text -> List Text
  ir-check-stmts (env) (ss) (nb) (depth) (i) (len) (acc) =
   if i >= len then acc
   else let s = list-at ss i
   in when s
    is IrDoBind (n) (t) (v) (sp) ->
     let acc1 = ir-check-ty env t ("IrDoBind '" & n & "'") acc
     in let acc2 = ir-check-expr env v nb depth acc1
     in ir-check-stmts env ss (ir-check-push env n nb) depth (i + 1) len acc2
    is IrDoExec (v) (sp) ->
     ir-check-stmts env ss nb depth (i + 1) len (ir-check-expr env v nb depth acc)

  ir-check-branches : IRCheckEnv, List IRBranch, Integer, Integer, Integer, Integer, List Text -> List Text
  ir-check-branches (env) (bs) (nb) (depth) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at bs i
   in let nb2 = ir-check-bind-pat env (b.pattern) nb depth
   in let acc1 = ir-check-expr env (b.guard) nb2 depth acc
   in let acc2 = ir-check-expr env (b.body) nb2 depth acc1
   in ir-check-branches env bs nb depth (i + 1) len acc2

  ir-check-clauses : IRCheckEnv, List IRHandleClause, Integer, Integer, Integer, Integer, List Text -> List Text
  ir-check-clauses (env) (cs) (nb) (depth) (i) (len) (acc) =
   if i >= len then acc
   else let c = list-at cs i
   in let nb2 = ir-check-push-names env (c.params) 0 (list-length (c.params)) nb
   in let nb3 = ir-check-push env (c.resume-name) nb2
   in ir-check-clauses env cs nb depth (i + 1) len (ir-check-expr env (c.body) nb3 depth acc)

Section: Patterns

 Patterns are walked for their binders only -- see hole 1 in the chapter
 prose for why their types are not checked. Codegen never reads them
 (it matches on tags and field offsets), so the IR is not wrong, but it
 is not typed either. The check belongs here the day lowering fills
 them in.

  ir-check-bind-pat : IRCheckEnv, IRPat, Integer, Integer -> Integer
  ir-check-bind-pat (env) (p) (nb) (depth) =
   if depth >= max-recursion-depth then nb
   else when p
    is IrVarPat (n) (t) (s) -> ir-check-push env n nb
    is IrCtorPat (n) (subs) (t) (s) -> ir-check-bind-pats env subs nb (depth + 1) 0 (list-length subs)
    is IrVecPat (subs) (t) (s) -> ir-check-bind-pats env subs nb (depth + 1) 0 (list-length subs)
    is otherwise -> nb

  ir-check-bind-pats : IRCheckEnv, List IRPat, Integer, Integer, Integer, Integer -> Integer
  ir-check-bind-pats (env) (ps) (nb) (depth) (i) (len) =
   if i >= len then nb
   else ir-check-bind-pats env ps (ir-check-bind-pat env (list-at ps i) nb depth) depth (i + 1) len

Section: Reporting

  ir-check-violation-bag : List Text -> DiagnosticBag
  ir-check-violation-bag (vs) =
   ir-check-violation-bag-loop empty-bag vs 0 (list-length vs)

  ir-check-violation-bag-loop : DiagnosticBag, List Text, Integer, Integer -> DiagnosticBag
  ir-check-violation-bag-loop (bag) (vs) (i) (len) =
   if i >= len then bag
   else ir-check-violation-bag-loop (bag-add bag (make-error cdx-ir-check-violation (list-at vs i) synthetic-span)) vs (i + 1) len


Chapter: Parsmi--LambdaLifting
  cites Foreword chapter Sort
  cites Foreword chapter Tuple

Section: Types
  LiftCtx = record {
   reserved : SkipListText,
   counter : Integer between 0 and 4294967295,
   lifted : List IRDef
  }

  FreeVar = record {
   name : Text,
   type-val : CodexType
  }

Section: Entry Point
  lift-lambdas : IRChapter, Integer -> IRChapter
  lift-lambdas (chapter) (ceiling) =
   let reserved = collect-reserved-names (chapter.defs) 0 (list-length (chapter.defs)) skip-list-text-empty
   in let ctx0 = LiftCtx { reserved = reserved, counter = 0, lifted = [] }
   in let (ctx, defs) = lift-defs ctx0 (chapter.defs) 0 (list-length (chapter.defs)) [] ceiling
   in __record-set chapter "defs" (defs & (ctx.lifted))

  collect-reserved-names : List IRDef, Integer, Integer, SkipListText -> SkipListText
  collect-reserved-names (defs) (i) (len) (acc) =
   if i >= len then acc
   else let d = list-at defs i
   in collect-reserved-names defs (i + 1) len (skip-list-text-insert acc (d.name))

  params-to-names : List IRParam, Integer, Integer, SkipListText -> SkipListText
  params-to-names (params) (i) (len) (acc) =
   if i >= len then acc
   else let p = list-at params i
   in params-to-names params (i + 1) len (skip-list-text-insert acc (p.name))

 The ceiling is the LIFT deck reservation's top, checked per definition
 because this loop is the phase's only bulk deck writer -- lift-lambdas
 is the whole of LIFT, and it writes 38,846,816 bytes on the 2.81 MB
 selfhost (measured 2026-07-21 with deck-pos probes). A definition's
 lift writes kilobytes against an 8 MB band. The stop returns the
 definitions lifted so far together with the lambdas lifted out of
 them, so the concat in lift-lambdas stays proportional to what was
 collected; compile-frontend-cdx reads deck-short-of again afterwards
 and raises CDX9002 from there.

  lift-defs : LiftCtx, List IRDef, Integer, Integer, List IRDef, Integer -> (LiftCtx, List IRDef)
  lift-defs (ctx) (defs) (i) (len) (acc) (ceiling) =
   if i >= len then (ctx, acc)
   else if deck-bound-short-of ceiling demand-lift-guard-band then (ctx, acc)
   else let d = list-at defs i
   in let absorbed = absorb-outer-lambdas d
   in let enclosing = params-to-names (absorbed.params) 0 (list-length (absorbed.params)) skip-list-text-empty
   in let (ctx1, body-expr) = lift-expr ctx enclosing (absorbed.body)
   in let new-def = deck-record (IRDef {
    name = absorbed.name,
    params = absorbed.params,
    type-val = absorbed.type-val,
    body = body-expr,
    chapter-slug = absorbed.chapter-slug,
    is-punctual = absorbed.is-punctual,
    wcet-budget = absorbed.wcet-budget,
    unique-params = absorbed.unique-params,
    span = absorbed.span
   })
   in lift-defs ctx1 defs (i + 1) len (list-push acc new-def) ceiling

  absorb-outer-lambdas : IRDef -> IRDef
  absorb-outer-lambdas (d) =
   when d.body
    is IrLambda (lps) (lbody) (lty) (lsp) ->
     let extended-params = (d.params) & lps
     in let merged = deck-record (IRDef {
      name = d.name,
      params = extended-params,
      type-val = d.type-val,
      body = lbody,
      chapter-slug = d.chapter-slug,
      is-punctual = d.is-punctual,
      wcet-budget = d.wcet-budget,
      unique-params = d.unique-params,
      span = d.span
     })
     in absorb-outer-lambdas merged
    is otherwise -> d

Section: Expression Walker
  lift-expr : LiftCtx, SkipListText, IRExpr -> (LiftCtx, IRExpr)
  lift-expr (ctx) (enclosing) (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) | IrName (n) (t) (s) | IrError (m) (t) (s) -> (ctx, e)
    is IrLambda (ps) (b) (t) (s) -> lift-one-lambda ctx enclosing ps b t s
    is IrBinary (op) (l) (r) (t) (s) ->
     let (ctx1, l-expr) = lift-expr ctx enclosing l
     in let (ctx2, r-expr) = lift-expr ctx1 enclosing r
     in (ctx2, deck-record (IrBinary op l-expr r-expr t s))
    is IrNegate (x) (t) (s) ->
     let (ctx1, x-expr) = lift-expr ctx enclosing x
     in (ctx1, deck-record (IrNegate x-expr t s))
    is IrIf (c) (th) (el) (t) (s) ->
     let (ctx1, c-expr) = lift-expr ctx enclosing c
     in let (ctx2, th-expr) = lift-expr ctx1 enclosing th
     in let (ctx3, el-expr) = lift-expr ctx2 enclosing el
     in (ctx3, deck-record (IrIf c-expr th-expr el-expr t s))
    is IrLet (n) (t) (v) (b) (s) ->
     let (ctx1, v-expr) = lift-expr ctx enclosing v
     in let b-enclosing = skip-list-text-insert enclosing n
     in let (ctx2, b-expr) = lift-expr ctx1 b-enclosing b
     in (ctx2, deck-record (IrLet n t v-expr b-expr s))
    is IrApply (f) (a) (t) (s) ->
     let (ctx1, f-expr) = lift-expr ctx enclosing f
     in let (ctx2, a-expr) = lift-expr ctx1 enclosing a
     in (ctx2, deck-record (IrApply f-expr a-expr t s))
    is IrList (es) (t) (s) ->
     let (ctx1, es-lifted) = lift-exprs ctx enclosing es 0 (list-length es) []
     in (ctx1, deck-record (IrList es-lifted t s))
    is IrMatch (sc) (bs) (t) (s) ->
     let (ctx1, sc-expr) = lift-expr ctx enclosing sc
     in let (ctx2, bs-lifted) = lift-branches ctx1 enclosing bs 0 (list-length bs) []
     in (ctx2, deck-record (IrMatch sc-expr bs-lifted t s))
    is IrAct (ss) (t) (s) ->
     let (ctx1, ss-lifted) = lift-act-stmts ctx enclosing ss 0 (list-length ss) []
     in (ctx1, deck-record (IrAct ss-lifted t s))
    is IrRecord (n) (fs) (t) (s) ->
     let (ctx1, fs-lifted) = lift-fields ctx enclosing fs 0 (list-length fs) []
     in (ctx1, deck-record (IrRecord n fs-lifted t s))
    is IrFieldAccess (r) (f) (t) (s) ->
     let (ctx1, r-expr) = lift-expr ctx enclosing r
     in (ctx1, deck-record (IrFieldAccess r-expr f t s))
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let (ctx1, r-expr) = lift-expr ctx enclosing r
     in let (ctx2, v-expr) = lift-expr ctx1 enclosing v
     in (ctx2, deck-record (IrFieldStore r-expr f v-expr t s))
    is IrFork (body) (t) (s) ->
     let (ctx1, b-expr) = lift-expr ctx enclosing body
     in (ctx1, deck-record (IrFork b-expr t s))
    is IrAwait (task) (t) (s) ->
     let (ctx1, t-expr) = lift-expr ctx enclosing task
     in (ctx1, deck-record (IrAwait t-expr t s))
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let (ctx1, h-expr) = lift-expr ctx enclosing h
     in let clause-enclosing = add-clause-names-to-enclosing cs enclosing
     in let (ctx2, cs-lifted) = lift-handle-clauses ctx1 clause-enclosing cs 0 (list-length cs) []
     in (ctx2, deck-record (IrHandle eff h-expr cs-lifted t s))
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) ->
     let (ctx1, b-expr) = lift-expr ctx enclosing body
     in (ctx1, deck-record (IrWithTimeout secs effs scopes b-expr t s))
    is IrTry (max) (body) (fb) (fail) (t) (s) ->
     let (ctx1, body-stmts) = lift-act-stmts ctx enclosing body 0 (list-length body) []
     in let (ctx2, fb-stmts) = lift-act-stmts ctx1 enclosing fb 0 (list-length fb) []
     in let (ctx3, fail-stmts) = lift-act-stmts ctx2 enclosing fail 0 (list-length fail) []
     in (ctx3, deck-record (IrTry max body-stmts fb-stmts fail-stmts t s))

  lift-exprs : LiftCtx, SkipListText, List IRExpr, Integer, Integer, List IRExpr -> (LiftCtx, List IRExpr)
  lift-exprs (ctx) (enclosing) (es) (i) (len) (acc) =
   if i >= len then (ctx, acc)
   else let (ctx1, expr) = lift-expr ctx enclosing (list-at es i)
   in lift-exprs ctx1 enclosing es (i + 1) len (list-push acc expr)

  lift-branches : LiftCtx, SkipListText, List IRBranch, Integer, Integer, List IRBranch -> (LiftCtx, List IRBranch)
  lift-branches (ctx) (enclosing) (bs) (i) (len) (acc) =
   if i >= len then (ctx, acc)
   else let b = list-at bs i
   in let branch-enclosing = lift-collect-pattern-names (b.pattern) enclosing
   in let (ctx1, body-expr) = lift-expr ctx branch-enclosing (b.body)
   in let (ctx2, guard-expr) = lift-expr ctx1 branch-enclosing (b.guard)
   in let new-b = deck-record (IRBranch {
    pattern = b.pattern,
    body = body-expr,
    guard = guard-expr,
    span = b.span,
    alt-group = b.alt-group
   })
   in lift-branches ctx2 enclosing bs (i + 1) len (list-push acc new-b)

  lift-fields : LiftCtx, SkipListText, List IRFieldVal, Integer, Integer, List IRFieldVal -> (LiftCtx, List IRFieldVal)
  lift-fields (ctx) (enclosing) (fs) (i) (len) (acc) =
   if i >= len then (ctx, acc)
   else let f = list-at fs i
   in let (ctx1, v-expr) = lift-expr ctx enclosing (f.value)
   in let new-f = deck-record (IRFieldVal {
    name = f.name,
    value = v-expr,
    span = f.span
   })
   in lift-fields ctx1 enclosing fs (i + 1) len (list-push acc new-f)

  lift-act-stmts : LiftCtx, SkipListText, List IRActStmt, Integer, Integer, List IRActStmt -> (LiftCtx, List IRActStmt)
  lift-act-stmts (ctx) (enclosing) (ss) (i) (len) (acc) =
   if i >= len then (ctx, acc)
   else let s = list-at ss i
   in when s
    is IrDoBind (n) (t) (v) (sp) ->
     let (ctx1, v-expr) = lift-expr ctx enclosing v
     in let new-enclosing = skip-list-text-insert enclosing n
     in lift-act-stmts ctx1 new-enclosing ss (i + 1) len (list-push acc (deck-record (IrDoBind n t v-expr sp)))
    is IrDoExec (v) (sp) ->
     let (ctx1, v-expr) = lift-expr ctx enclosing v
     in lift-act-stmts ctx1 enclosing ss (i + 1) len (list-push acc (deck-record (IrDoExec v-expr sp)))

  lift-handle-clauses : LiftCtx, SkipListText, List IRHandleClause, Integer, Integer, List IRHandleClause -> (LiftCtx, List IRHandleClause)
  lift-handle-clauses (ctx) (enclosing) (cs) (i) (len) (acc) =
   if i >= len then (ctx, acc)
   else let c = list-at cs i
   in let clause-enc = skip-list-text-insert enclosing (c.resume-name)
   in let (ctx1, body-expr) = lift-expr ctx clause-enc (c.body)
   in let new-c = deck-record (IRHandleClause {
    op-name = c.op-name,
    params = c.params,
    resume-name = c.resume-name,
    body = body-expr,
    span = c.span
   })
   in lift-handle-clauses ctx1 enclosing cs (i + 1) len (list-push acc new-c)

  add-clause-names-to-enclosing : List IRHandleClause, SkipListText -> SkipListText
  add-clause-names-to-enclosing (cs) (enc) =
   add-clause-names-loop cs 0 (list-length cs) enc

  add-clause-names-loop : List IRHandleClause, Integer, Integer, SkipListText -> SkipListText
  add-clause-names-loop (cs) (i) (len) (enc) =
   if i >= len then enc
   else let c = list-at cs i
   in let enc1 = skip-list-text-insert enc (c.op-name)
   in let enc2 = skip-list-text-insert enc1 (c.resume-name)
   in add-clause-names-loop cs (i + 1) len enc2

Section: Pattern Variables
  lift-collect-pattern-names : IRPat, SkipListText -> SkipListText
  lift-collect-pattern-names (p) (acc) =
   when p
    is IrVarPat (n) (t) (s) -> skip-list-text-insert acc n
    is IrLitPat (v) (t) (s) | IrWildPat (s) -> acc
    is IrCtorPat (n) (subs) (t) (s) -> collect-pattern-name-list subs 0 (list-length subs) acc
    is IrVecPat (subs) (t) (s) -> collect-pattern-name-list subs 0 (list-length subs) acc

  collect-pattern-name-list : List IRPat, Integer, Integer, SkipListText -> SkipListText
  collect-pattern-name-list (ps) (i) (len) (acc) =
   if i >= len then acc
   else collect-pattern-name-list ps (i + 1) len (lift-collect-pattern-names (list-at ps i) acc)

Section: Lift Single Lambda
  lift-one-lambda : LiftCtx, SkipListText, List IRParam, IRExpr, CodexType, SourceSpan -> (LiftCtx, IRExpr)
  lift-one-lambda (ctx) (enclosing) (ps) (body) (ty) (sp) =
   when body
    is IrLambda (inner-ps) (inner-body) (inner-ty) (inner-sp) ->
     lift-one-lambda ctx enclosing (ps & inner-ps) inner-body ty sp
    is otherwise ->
   let body-enclosing = params-to-names ps 0 (list-length ps) enclosing
   in let (ctx1, body-expr) = lift-expr ctx body-enclosing body
   in let param-names = params-to-names ps 0 (list-length ps) skip-list-text-empty
   in let sorted-free = collect-free-vars body-expr param-names enclosing []
   in let (ctx2, lam-name) = gen-unique-name ctx1 "__lam"
   in let ret-ty = infer-lambda-return-ty ty (list-length ps)
   in let lifted-params = build-lifted-params sorted-free ps
   in let lifted-ty = build-function-ty lifted-params 0 (list-length lifted-params) ret-ty
   in let lifted-def = deck-record (IRDef {
    name = lam-name,
    params = lifted-params,
    type-val = lifted-ty,
    body = body-expr,
    chapter-slug = "",
    is-punctual = False,
    wcet-budget = 0,
    unique-params = [],
    span = sp
   })
   in let ctx3 = __record-set ctx2 "lifted" (list-push (ctx2.lifted) lifted-def)
   in let replacement = build-partial-app lam-name lifted-ty sorted-free 0 (list-length sorted-free) sp
   in (ctx3, replacement)

  gen-unique-name : LiftCtx, Text -> (LiftCtx, Text)
  gen-unique-name (ctx) (base) =
   gen-unique-name-loop ctx base (ctx.counter)

  gen-unique-name-loop : LiftCtx, Text, Integer between 0 and 4294967295 -> (LiftCtx, Text)
  gen-unique-name-loop (ctx) (base) (i) =
   let candidate = base & "_" & integer-to-text i
   in if skip-list-text-has (ctx.reserved) candidate then gen-unique-name-loop ctx base (i + 1)
      else let ctx1 = __record-set ctx "reserved" (skip-list-text-insert (ctx.reserved) candidate)
      in let ctx2 = __record-set ctx1 "counter" (i + 1)
      in (ctx2, candidate)

  build-lifted-params : List FreeVar, List IRParam -> List IRParam
  build-lifted-params (captures) (lam-params) =
   let cap-params = free-vars-to-params captures 0 (list-length captures) []
   in cap-params & lam-params

  free-vars-to-params : List FreeVar, Integer, Integer, List IRParam -> List IRParam
  free-vars-to-params (fvs) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fvs i
   in free-vars-to-params fvs (i + 1) len (list-push acc (deck-record (IRParam {
    name = f.name,
    type-val = f.type-val,
    span = synthetic-span
   })))

  build-function-ty : List IRParam, Integer, Integer, CodexType -> CodexType
  build-function-ty (params) (i) (len) (ret) =
   if i >= len then ret
   else let p = list-at params i
   in FunTy (p.type-val) empty-row (build-function-ty params (i + 1) len ret)

  infer-lambda-return-ty : CodexType, Integer -> CodexType
  infer-lambda-return-ty (ty) (n-params) =
   if n-params == 0 then ty
   else when ty
    is FunTy (pt) (row) (rt) -> infer-lambda-return-ty rt (n-params - 1)
    is otherwise -> ty

  build-partial-app : Text, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
  build-partial-app (name) (fn-ty) (captures) (i) (len) (sp) =
   build-partial-app-loop (deck-record (IrName name fn-ty sp)) fn-ty captures 0 len sp

  build-partial-app-loop : IRExpr, CodexType, List FreeVar, Integer, Integer, SourceSpan -> IRExpr
  build-partial-app-loop (acc) (acc-ty) (captures) (i) (len) (sp) =
   if i >= len then acc
   else let c = list-at captures i
   in let next-ty = when acc-ty
    is FunTy (pt) (row) (rt) -> rt
    is otherwise -> acc-ty
   in let new-acc = deck-record (IrApply acc (deck-record (IrName (c.name) (c.type-val) sp)) next-ty sp)
   in build-partial-app-loop new-acc next-ty captures (i + 1) len sp

Section: Free Variable Collection
  collect-free-vars : IRExpr, SkipListText, SkipListText, List FreeVar -> List FreeVar
  collect-free-vars (e) (local-bound) (capturable) (acc) =
   when e
    is IrName (n) (t) (s) ->
     if (skip-list-text-has capturable n) & (skip-list-text-has local-bound n == False) & (free-var-has acc n == False)
      then let fv-pos = bsearch-freevar-pos acc n 0 (list-length acc)
      in list-insert-at acc fv-pos (FreeVar { name = n, type-val = t })
      else acc
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) | IrError (m) (t) (s) -> acc
    is IrLambda (ps) (b) (t) (s) ->
     let inner-bound = params-to-names ps 0 (list-length ps) local-bound
     in collect-free-vars b inner-bound capturable acc
    is IrApply (f) (a) (t) (s) ->
     let acc1 = collect-free-vars f local-bound capturable acc
     in collect-free-vars a local-bound capturable acc1
    is IrBinary (op) (l) (r) (t) (s) ->
     let acc1 = collect-free-vars l local-bound capturable acc
     in collect-free-vars r local-bound capturable acc1
    is IrNegate (x) (t) (s) -> collect-free-vars x local-bound capturable acc
    is IrIf (c) (th) (el) (t) (s) ->
     let acc1 = collect-free-vars c local-bound capturable acc
     in let acc2 = collect-free-vars th local-bound capturable acc1
     in collect-free-vars el local-bound capturable acc2
    is IrLet (n) (t) (v) (b) (s) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in let new-bound = skip-list-text-insert local-bound n
     in collect-free-vars b new-bound capturable acc1
    is IrMatch (sc) (bs) (t) (s) ->
     let acc1 = collect-free-vars sc local-bound capturable acc
     in collect-free-vars-branches bs local-bound capturable 0 (list-length bs) acc1
    is IrList (es) (t) (s) -> collect-free-vars-list es local-bound capturable 0 (list-length es) acc
    is IrRecord (n) (fs) (t) (s) -> collect-free-vars-fields fs local-bound capturable 0 (list-length fs) acc
    is IrFieldAccess (r) (f) (t) (s) -> collect-free-vars r local-bound capturable acc
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let acc1 = collect-free-vars r local-bound capturable acc
     in collect-free-vars v local-bound capturable acc1
    is IrAct (ss) (t) (s) -> collect-free-vars-act-stmts ss local-bound capturable 0 (list-length ss) acc
    is IrFork (b) (t) (s) -> collect-free-vars b local-bound capturable acc
    is IrAwait (t2) (t) (s) -> collect-free-vars t2 local-bound capturable acc
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let acc1 = collect-free-vars h local-bound capturable acc
     in collect-free-vars-clauses cs local-bound capturable acc1 0 (list-length cs)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> collect-free-vars body local-bound capturable acc
    is IrTry (max) (body) (fb) (fail) (t) (s) ->
     let acc1 = collect-free-vars-act-stmts body local-bound capturable 0 (list-length body) acc
     in let acc2 = collect-free-vars-act-stmts fb local-bound capturable 0 (list-length fb) acc1
     in collect-free-vars-act-stmts fail local-bound capturable 0 (list-length fail) acc2

  bsearch-freevar-pos : List FreeVar, Text, Integer, Integer -> Integer
  bsearch-freevar-pos (xs) (name) (lo) (hi) =
   if lo >= hi then lo
   else let mid = lo + (hi - lo) / 2
   in if text-compare name (list-at xs mid).name <= 0 then bsearch-freevar-pos xs name lo mid
      else bsearch-freevar-pos xs name (mid + 1) hi

  free-var-has : List FreeVar, Text -> Boolean
  free-var-has (xs) (name) =
   let len = list-length xs
   in let pos = bsearch-freevar-pos xs name 0 len
   in if pos >= len then False
      else (list-at xs pos).name == name

  collect-free-vars-list : List IRExpr, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-list (es) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else collect-free-vars-list es local-bound capturable (i + 1) len (collect-free-vars (list-at es i) local-bound capturable acc)

  collect-free-vars-branches : List IRBranch, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-branches (bs) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let b = list-at bs i
   in let branch-bound = lift-collect-pattern-names (b.pattern) local-bound
   in let acc1 = collect-free-vars (b.body) branch-bound capturable acc
   in let acc2 = collect-free-vars (b.guard) branch-bound capturable acc1
   in collect-free-vars-branches bs local-bound capturable (i + 1) len acc2

  collect-free-vars-fields : List IRFieldVal, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-fields (fs) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let f = list-at fs i
   in collect-free-vars-fields fs local-bound capturable (i + 1) len (collect-free-vars (f.value) local-bound capturable acc)

  collect-free-vars-act-stmts : List IRActStmt, SkipListText, SkipListText, Integer, Integer, List FreeVar -> List FreeVar
  collect-free-vars-act-stmts (ss) (local-bound) (capturable) (i) (len) (acc) =
   if i >= len then acc
   else let s = list-at ss i
   in when s
    is IrDoBind (n) (t) (v) (sp) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in let new-bound = skip-list-text-insert local-bound n
     in collect-free-vars-act-stmts ss new-bound capturable (i + 1) len acc1
    is IrDoExec (v) (sp) ->
     let acc1 = collect-free-vars v local-bound capturable acc
     in collect-free-vars-act-stmts ss local-bound capturable (i + 1) len acc1

  collect-free-vars-clauses : List IRHandleClause, SkipListText, SkipListText, List FreeVar, Integer, Integer -> List FreeVar
  collect-free-vars-clauses (cs) (local-bound) (capturable) (acc) (i) (len) =
   if i >= len then acc
   else let c = list-at cs i
   in let clause-bound = skip-list-text-insert local-bound (c.resume-name)
   in let clause-cap = skip-list-text-insert capturable (c.resume-name)
   in let acc1 = collect-free-vars (c.body) clause-bound clause-cap acc
   in collect-free-vars-clauses cs local-bound capturable acc1 (i + 1) len

Page 1


Chapter: Parsmi--Simplify
  cites Codex chapter Build Settings (max-recursion-depth)

 The simplifier: one traversal that applies every local rewrite it
 knows at once, iterated to a fixpoint (GHC Core's
 one-Simplifier-pass architecture, the closest
 production analogue to this IR). This is WS-D3, slices 1 through 3. It
 carries a substitution environment down the tree and a rewrite count
 up it. It stays deliberately narrow -- no renaming, so every rewrite is
 sound by inspection: dead-let elimination and occurs-once inlining reason
 about traps and effects through an explicit purity predicate, and
 inlining refuses (rather than renames) any substitution that could
 capture a variable.

 **Constant folding.** Integer add / subtract / multiply over two
 literals, the six integer comparisons, boolean and / or, negate of a
 literal, and the three text builtins the old hardcoded pass already
 folded (text-length, char-code, char-code-at). Folding replaces an
 expression with the value the runtime would compute for it, so it is
 always sound. Division and remainder are NOT folded here: they can
 trap on a zero divisor and folding would have to preserve that trap,
 which is the next slice's concern along with the sign rules.

 **Sparse conditional constant propagation.** An `IrIf` whose condition
 has folded to a boolean literal becomes its taken arm. The untaken arm
 is never even simplified -- this is a strict language, so the arm that
 is not taken never runs, and dropping it can remove no effect and no
 trap that would otherwise have fired.

 **Literal propagation.** A `let` whose value has folded to a literal is
 dropped and every use of its name in the body is replaced by that
 literal. A literal has no free variables, so this substitution can
 capture nothing and needs no renaming; a literal is free to duplicate,
 so it is sound whether the name is used once or many times. This is the
 rewrite that carries a constant to where it can fold -- `let x = 5 in
 x + 3` becomes `8` in one traversal, because the body is simplified
 under the extended substitution before the fold runs.

 **Dead-let elimination.** A non-literal `let x = v in b` whose name x is
 never used in b, and whose value v is pure and trap-free, is dropped and
 replaced by b -- the binding and the work that computed its value both
 disappear. This is where the simplifier consumes the WS-D2 occurrence
 analyser: deadness is `occ-expr`'s free map answering that x has no free
 occurrence in b, which is correct under shadowing. It needs no renaming
 because it removes a binding rather than moving a value. The purity
 predicate is what keeps it sound in a strict language -- dropping a let
 whose value could trap or print would delete that trap or print -- so it
 fires only for values that certainly do neither (see the Purity section).

 The substitution is shadow-aware. At every binder -- a `let`, a lambda
 parameter, a match pattern variable, an act bind -- the bound name is
 removed from the substitution before its scope is walked, so an inner
 binding of a name the substitution carries hides the outer literal
 rather than being overwritten by it. Because the only values ever
 substituted are literals, removal is the whole of the discipline: there
 is no capture to rename around. The rapier -- renaming on collision so a
 non-trivial value can be substituted -- is the next slice, and this one
 is written so it never needs it.

 Two boundaries are walked with an empty substitution rather than the
 carried one: the clauses of an `IrHandle` and the three statement lists
 of an `IrTry`. A handle clause's operation and resume binders, and the
 way a try body's binds are visible in its fallback blocks, are exactly
 the unscoped-binder edges that remain unscoped. Propagating an outer
 literal across those boundaries could replace one of those leaked names.
 Refusing to carry the substitution in costs only the rare cross-boundary
 constant and keeps the slice sound without depending on those being
 closed first. The sub-expressions inside are still folded and
 propagated on their own.

 Termination. A single traversal terminates by structural recursion,
 bounded by the shared recursion depth; a subtree past the budget is
 returned unsimplified, which is always sound. The traversal is iterated
 while it reports rewrites, capped at `simplify-max-iters`. Every rewrite
 here strictly shrinks the tree or turns a name into a literal, both
 monotone, so the iteration cannot oscillate and the cap is a backstop,
 not a semantic bound; a later slice with non-monotone rewrites
 (reassociation) is where a size-proportional global budget that errors
 loudly earns its place.

 Limitations, stated so they are not assumed away: occurs-once inlining
 refuses rather than renames when a substitution would capture (the
 rename-on-collision rapier that would inline those cases too is a later
 refinement), so a value whose free name is bound somewhere in the body
 is left where it is; no division or remainder folding; no
 case-of-known-constructor, if-of-if commuting, reassociation, or
 strength reduction; the substitution is an
 association list scanned linearly, sized for the binders one definition
 carries; and heap is bounded by the iteration cap rather than reclaimed
 between iterations -- every iteration rebuilds the definition body on the
 pass deck, so peak is at most `simplify-max-iters` copies of the largest
 body, paid only when the pass is switched on.

Section: Results

  SimpRes = record {
   expr : IRExpr,
   ticks : Integer
  }

  FoldRes = record {
   folded : Boolean,
   expr : IRExpr
  }

  SimpDefRes = record {
   def : IRDef,
   ticks : Integer
  }

  SimpDefsRes = record {
   defs : List IRDef,
   ticks : Integer
  }

  SimpStmtsRes = record {
   stmts : List IRActStmt,
   ticks : Integer
  }

  SimplifyOutcome = record {
   chapter : IRChapter,
   infos : List Text
  }

  simplify-max-iters : Integer = 4

Section: Substitution

 A map from a name to the literal that replaces it. Only literals are
 ever stored, which is the property that makes propagation capture-free.
 Adding a name removes any earlier binding of it first, so at most one
 entry per name survives and it is always the innermost -- a lookup never
 has to reason about order.

  SubstEntry = record {
   name : Text,
   val : IRExpr
  }

  subst-find : List SubstEntry, Text, Integer, Integer -> Integer
  subst-find (m) (n) (i) (len) =
   if i >= len then 0 - 1
   else if (list-at m i).name == n then i
   else subst-find m n (i + 1) len

  subst-remove : List SubstEntry, Text -> List SubstEntry
  subst-remove (m) (n) = subst-remove-loop [] m n 0 (list-length m)

  subst-remove-loop : List SubstEntry, List SubstEntry, Text, Integer, Integer -> List SubstEntry
  subst-remove-loop (acc) (m) (n) (i) (len) =
   if i >= len then acc
   else let e = list-at m i
   in subst-remove-loop (if (e.name) == n then acc else list-push acc e) m n (i + 1) len

  subst-add : List SubstEntry, Text, IRExpr -> List SubstEntry
  subst-add (m) (n) (v) = list-push (subst-remove m n) (SubstEntry { name = n, val = v })

Section: Literals

 A literal is an integer, number, text, boolean, or character constant --
 the values that are free to duplicate and cannot capture. Only these
 are substituted and only these drive the let-dropping rewrite.

  simp-is-literal : IRExpr -> Boolean
  simp-is-literal (e) =
   when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> True
    is otherwise -> False

Section: Folding

  fold-none : IRExpr -> FoldRes
  fold-none (e) = FoldRes { folded = False, expr = e }

  fold-some : IRExpr -> FoldRes
  fold-some (e) = FoldRes { folded = True, expr = e }

  simp-fold-int : IRBinaryOp, Integer, Integer, CodexType, SourceSpan -> FoldRes
  simp-fold-int (op) (a) (b) (ty) (sp) =
   when op
    is IrAddInt -> if int-ty-wraps ty == False & add-fold-fits a b then fold-some (deck-record (IrIntLit (a + b) sp)) else simp-fold-keep op a b ty sp
    is IrSubInt -> if int-ty-wraps ty == False & sub-fold-fits a b then fold-some (deck-record (IrIntLit (a - b) sp)) else simp-fold-keep op a b ty sp
    is IrMulInt -> if int-ty-wraps ty == False & mul-fold-fits a b then fold-some (deck-record (IrIntLit (a * b) sp)) else simp-fold-keep op a b ty sp
    is IrEq -> fold-some (deck-record (IrBoolLit (a == b) sp))
    is IrNotEq -> fold-some (deck-record (IrBoolLit (a /= b) sp))
    is IrLt -> fold-some (deck-record (IrBoolLit (a < b) sp))
    is IrGt -> fold-some (deck-record (IrBoolLit (a > b) sp))
    is IrLtEq -> fold-some (deck-record (IrBoolLit (a <= b) sp))
    is IrGtEq -> fold-some (deck-record (IrBoolLit (a >= b) sp))
    is otherwise -> simp-fold-keep op a b ty sp

  simp-fold-keep : IRBinaryOp, Integer, Integer, CodexType, SourceSpan -> FoldRes
  simp-fold-keep (op) (a) (b) (ty) (sp) = fold-none (deck-record (IrBinary op (deck-record (IrIntLit a sp)) (deck-record (IrIntLit b sp)) ty sp))

  add-fold-fits : Integer, Integer -> Boolean
  add-fold-fits (a) (b) =
   if b >= 0 then a <= i64-max - b else a >= i64-min - b

  sub-fold-fits : Integer, Integer -> Boolean
  sub-fold-fits (a) (b) =
   if b >= 0 then a >= i64-min + b else a <= i64-max + b

  mul-fold-fits : Integer, Integer -> Boolean
  mul-fold-fits (a) (b) =
   if a == 0 | b == 0 then True
   else if a == i64-min | b == i64-min then False
   else (if a < 0 then 0 - a else a) <= i64-max / (if b < 0 then 0 - b else b)

  simp-fold-bool : IRBinaryOp, Boolean, Boolean, CodexType, SourceSpan -> FoldRes
  simp-fold-bool (op) (a) (b) (ty) (sp) =
   when op
    is IrAnd -> fold-some (deck-record (IrBoolLit (a & b) sp))
    is IrOr -> fold-some (deck-record (IrBoolLit (a | b) sp))
    is IrEq -> fold-some (deck-record (IrBoolLit (a == b) sp))
    is IrNotEq -> fold-some (deck-record (IrBoolLit (a /= b) sp))
    is otherwise -> fold-none (deck-record (IrBinary op (deck-record (IrBoolLit a sp)) (deck-record (IrBoolLit b sp)) ty sp))

  simp-fold-binary : IRBinaryOp, IRExpr, IRExpr, CodexType, SourceSpan -> FoldRes
  simp-fold-binary (op) (l) (r) (ty) (sp) =
   when l
    is IrIntLit (a) (ls) ->
     (when r
      is IrIntLit (b) (rs) -> simp-fold-int op a b ty sp
      is otherwise -> fold-none (deck-record (IrBinary op l r ty sp)))
    is IrBoolLit (a) (ls) ->
     (when r
      is IrBoolLit (b) (rs) -> simp-fold-bool op a b ty sp
      is otherwise -> fold-none (deck-record (IrBinary op l r ty sp)))
    is IrCharLit (a) (ls) ->
     (when r
      is IrCharLit (b) (rs) ->
       (when op
        is IrEq -> fold-some (deck-record (IrBoolLit (a == b) sp))
        is IrNotEq -> fold-some (deck-record (IrBoolLit (a /= b) sp))
        is otherwise -> fold-none (deck-record (IrBinary op l r ty sp)))
      is otherwise -> fold-none (deck-record (IrBinary op l r ty sp)))
    is otherwise -> fold-none (deck-record (IrBinary op l r ty sp))

 The text builtins the old pass folded, recognised on already-simplified
 operands: `text-length` and `char-code` are one-argument applications,
 `char-code-at` a two-argument one whose partial application is itself an
 `IrApply`. An out-of-range index is left as a call, to trap at runtime
 exactly as it would unfolded.

 These three rules fold a name, so they must first ask whether the chapter
 DEFINES that name -- a chapter is allowed to define its own
 `text-length`. Folding one that does gave two answers in one function:
 the fold caught the literal argument and answered the builtin's way,
 while every other call site reached `emit-compound`, which checks
 `user-arity < 0` before routing to `emit-builtin` and answered the
 definition's way. `fold-constants` (Lowering,
 Section: Constant Folding) had the identical defect.

 Both are fixed the same way and the set is the same set: `dn`, a
 `SkipListText` of the chapter's own def names, built once per chapter at
 `simplify-chapter` / `simplify-run` and threaded down the walk. A name in
 it is never folded.

 `dn` is threaded rather than rebuilt per definition because the walk is
 iterated to a fixpoint -- `simplify-iter` runs the whole traversal again
 for each rewrite round, and rebuilding a skip list of every def name on
 each round would put a chapter-sized structure inside the fixpoint loop.
 It is chapter-scoped data and it is built where the chapter is.

  simp-fold-apply : SkipListText, IRExpr, IRExpr, CodexType, SourceSpan -> FoldRes
  simp-fold-apply (dn) (f) (a) (ty) (sp) =
   when f
    is IrName (n) (fty) (ns) ->
     if skip-list-text-has dn n then fold-none (deck-record (IrApply f a ty sp))
     else if n == "text-length" then (when a
      is IrTextLit (s) (as) -> fold-some (deck-record (IrIntLit (text-length s) sp))
      is otherwise -> fold-none (deck-record (IrApply f a ty sp)))
     else if n == "char-code" then (when a
      is IrCharLit (v) (as) -> fold-some (deck-record (IrIntLit v sp))
      is otherwise -> fold-none (deck-record (IrApply f a ty sp)))
     else fold-none (deck-record (IrApply f a ty sp))
    is IrApply (inner-f) (inner-a) (fty) (fs) ->
     (when inner-f
      is IrName (n) (nty) (nsp) ->
       if n == "char-code-at" then (if skip-list-text-has dn n then fold-none (deck-record (IrApply f a ty sp))
        else simp-fold-char-code-at f inner-a a ty sp)
       else fold-none (deck-record (IrApply f a ty sp))
      is otherwise -> fold-none (deck-record (IrApply f a ty sp)))
    is otherwise -> fold-none (deck-record (IrApply f a ty sp))

  simp-fold-char-code-at : IRExpr, IRExpr, IRExpr, CodexType, SourceSpan -> FoldRes
  simp-fold-char-code-at (partial) (str-arg) (idx-arg) (ty) (sp) =
   when str-arg
    is IrTextLit (s) (as) ->
     (when idx-arg
      is IrIntLit (i) (is2) ->
       if i >= 0 then (if i < text-length s then fold-some (deck-record (IrIntLit (char-code-at s i) sp))
        else fold-none (deck-record (IrApply partial idx-arg ty sp)))
       else fold-none (deck-record (IrApply partial idx-arg ty sp))
      is otherwise -> fold-none (deck-record (IrApply partial idx-arg ty sp)))
    is otherwise -> fold-none (deck-record (IrApply partial idx-arg ty sp))

Section: Purity and Deadness

 Dead-let elimination drops `let x = v in b` when x is never used in b
 and evaluating v has no observable consequence. Both halves are needed:
 an unused binding whose value could trap or print must not be dropped,
 because dropping it deletes the trap or the print. This is where the
 simplifier consumes the occurrence analyser (`IR/Occurrence.codex`,
 WS-D2): deadness is read from `occ-expr`'s free map, which counts free
 names with correct shadowing, so a name shadowed by an inner binder of
 the same name is not mistaken for a use of the outer one -- the exact
 hazard a flat name-keyed set would fall into.

 The purity predicate is conservative in the safe direction: it answers
 True only for expressions that certainly cannot trap and certainly have
 no effect, so a False merely keeps a let that could have been dropped.
 Literals, names (referencing a value neither traps nor acts), the
 non-trapping integer / boolean / text operators, and the pure structural
 forms (if, let, lambda, list, record, field access) qualify. Division
 and remainder trap on a zero divisor; application can call anything; a
 match can be inexhaustive; act, handle, try, fork, await, field store,
 and error carry effects or traps. None of those qualify, so a let
 binding one of them is kept even when its name is dead.

  simp-op-trapfree : IRBinaryOp -> Boolean
  simp-op-trapfree (op) =
   when op
    is IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq | IrAnd | IrOr | IrAppendText | IrAppendList | IrConsList -> True
    is otherwise -> False

  simp-op-trapfree-typed : IRBinaryOp, CodexType -> Boolean
  simp-op-trapfree-typed (op) (t) =
   when op
    is IrAddInt | IrSubInt | IrMulInt -> int-ty-wraps t
    is otherwise -> simp-op-trapfree op

  simp-pure-trapfree : IRExpr, Integer -> Boolean
  simp-pure-trapfree (e) (depth) =
   if depth >= max-recursion-depth then False
   else when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> True
    is IrName (nm) (t) (s) -> True
    is IrNegate (x) (t) (s) -> simp-pure-trapfree x (depth + 1)
    is IrBinary (op) (l) (r) (t) (s) ->
     if simp-op-trapfree-typed op t then (if simp-pure-trapfree l (depth + 1) then simp-pure-trapfree r (depth + 1) else False) else False
    is IrIf (c) (th) (el) (t) (s) ->
     if simp-pure-trapfree c (depth + 1) then (if simp-pure-trapfree th (depth + 1) then simp-pure-trapfree el (depth + 1) else False) else False
    is IrLet (nm) (t) (v) (bd) (s) ->
     if simp-pure-trapfree v (depth + 1) then simp-pure-trapfree bd (depth + 1) else False
    is IrLambda (ps) (bd) (t) (s) -> True
    is IrList (es) (t) (s) -> simp-pure-trapfree-list es (depth + 1) 0 (list-length es)
    is IrRecord (nm) (fs) (t) (s) -> simp-pure-trapfree-fields fs (depth + 1) 0 (list-length fs)
    is IrFieldAccess (r) (f) (t) (s) -> simp-pure-trapfree r (depth + 1)
    is otherwise -> False

  simp-pure-trapfree-list : List IRExpr, Integer, Integer, Integer -> Boolean
  simp-pure-trapfree-list (es) (depth) (i) (len) =
   if i >= len then True
   else if simp-pure-trapfree (list-at es i) depth then simp-pure-trapfree-list es depth (i + 1) len
   else False

  simp-pure-trapfree-fields : List IRFieldVal, Integer, Integer, Integer -> Boolean
  simp-pure-trapfree-fields (fs) (depth) (i) (len) =
   if i >= len then True
   else if simp-pure-trapfree ((list-at fs i).value) depth then simp-pure-trapfree-fields fs depth (i + 1) len
   else False

  simp-is-dead : Text, IRExpr -> Boolean
  simp-is-dead (n) (b) =
   when occ-map-get ((occ-expr b [] 0).free) n
    is OccDead -> True
    is otherwise -> False

Section: Inlining

 A let bound to a non-literal value may still be inlined -- its name
 replaced by the value and the binding dropped -- in two cases, and only
 when doing so cannot capture. A value bound to a bare name is
 copy-propagated at any occurrence count: a name is pure, trap-free, and
 free to duplicate, so replacing every use costs nothing and can change
 nothing. A value that is pure and trap-free and whose name occurs
 exactly once is inlined into that one use: no work is duplicated because
 there is one use, and the value cannot trap or act, so moving where it
 is evaluated is unobservable -- the property that makes this sound in a
 strict language, where a conditional use would otherwise decide whether
 the value's trap fires.

 Capture is refused, not renamed. Substituting a value that carries free
 variables into a body that binds one of those names would rebind the
 value's variable to the wrong thing. This slice detects that -- does any
 binder in the body carry a free name of the value -- and declines to
 inline when it could happen, keeping the let. Declining is strictly
 sound; the alternative, renaming the colliding binder to a fresh name
 (the rapier), is more complete and is a later refinement. Because the
 fixed point cannot see a capture miscompile -- a wrongly captured program
 still compiles to a consistent wrong answer -- the guard here is the one
 that matters, and the adversarial `sc-cap` fixture pins it.

  simp-free-names : IRExpr -> List Text
  simp-free-names (e) = for en in ((occ-expr e [] 0).free) -> en.name

  simp-occ-once : Text, IRExpr -> Boolean
  simp-occ-once (n) (b) =
   when occ-map-get ((occ-expr b [] 0).free) n
    is OccOnce -> True
    is otherwise -> False

  simp-name-in : List Text, Text -> Boolean
  simp-name-in (names) (n) = simp-name-in-loop names n 0 (list-length names)

  simp-name-in-loop : List Text, Text, Integer, Integer -> Boolean
  simp-name-in-loop (names) (n) (i) (len) =
   if i >= len then False
   else if list-at names i == n then True
   else simp-name-in-loop names n (i + 1) len

 Does any binder anywhere in the expression carry a name in the set? A
 True here forbids an inline that would otherwise capture. The walk is
 depth-bounded, and an exhausted budget answers True -- the conservative
 direction, since an unknown body might bind a captured name.

  simp-binds-any : IRExpr, List Text, Integer -> Boolean
  simp-binds-any (e) (names) (depth) =
   if depth >= max-recursion-depth then True
   else when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> False
    is IrName (n) (t) (s) -> False
    is IrError (m) (t) (s) -> False
    is IrNegate (x) (t) (s) -> simp-binds-any x names (depth + 1)
    is IrBinary (op) (l) (r) (t) (s) -> if simp-binds-any l names (depth + 1) then True else simp-binds-any r names (depth + 1)
    is IrIf (c) (th) (el) (t) (s) -> if simp-binds-any c names (depth + 1) then True else if simp-binds-any th names (depth + 1) then True else simp-binds-any el names (depth + 1)
    is IrLet (n) (t) (v) (b) (s) -> if simp-name-in names n then True else if simp-binds-any v names (depth + 1) then True else simp-binds-any b names (depth + 1)
    is IrApply (f) (a) (t) (s) -> if simp-binds-any f names (depth + 1) then True else simp-binds-any a names (depth + 1)
    is IrLambda (ps) (b) (t) (s) -> if simp-params-in names ps 0 (list-length ps) then True else simp-binds-any b names (depth + 1)
    is IrList (es) (t) (s) -> simp-binds-any-list es names (depth + 1) 0 (list-length es)
    is IrMatch (sc) (bs) (t) (s) -> if simp-binds-any sc names (depth + 1) then True else simp-binds-any-branches bs names (depth + 1) 0 (list-length bs)
    is IrAct (ss) (t) (s) -> simp-binds-any-stmts ss names (depth + 1) 0 (list-length ss)
    is IrHandle (eff) (h) (cs) (t) (s) -> if simp-binds-any h names (depth + 1) then True else simp-binds-any-clauses cs names (depth + 1) 0 (list-length cs)
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) -> simp-binds-any body names (depth + 1)
    is IrRecord (n) (fs) (t) (s) -> simp-binds-any-fields fs names (depth + 1) 0 (list-length fs)
    is IrFieldAccess (r) (f) (t) (s) -> simp-binds-any r names (depth + 1)
    is IrFork (b) (t) (s) -> simp-binds-any b names (depth + 1)
    is IrAwait (tk) (t) (s) -> simp-binds-any tk names (depth + 1)
    is IrTry (mx) (body) (fb) (fail) (t) (s) -> if simp-binds-any-stmts body names (depth + 1) 0 (list-length body) then True else if simp-binds-any-stmts fb names (depth + 1) 0 (list-length fb) then True else simp-binds-any-stmts fail names (depth + 1) 0 (list-length fail)
    is IrFieldStore (r) (f) (v) (t) (s) -> if simp-binds-any r names (depth + 1) then True else simp-binds-any v names (depth + 1)

  simp-params-in : List Text, List IRParam, Integer, Integer -> Boolean
  simp-params-in (names) (ps) (i) (len) =
   if i >= len then False
   else if simp-name-in names ((list-at ps i).name) then True
   else simp-params-in names ps (i + 1) len

  simp-binds-any-list : List IRExpr, List Text, Integer, Integer, Integer -> Boolean
  simp-binds-any-list (es) (names) (depth) (i) (len) =
   if i >= len then False
   else if simp-binds-any (list-at es i) names depth then True
   else simp-binds-any-list es names depth (i + 1) len

  simp-binds-any-fields : List IRFieldVal, List Text, Integer, Integer, Integer -> Boolean
  simp-binds-any-fields (fs) (names) (depth) (i) (len) =
   if i >= len then False
   else if simp-binds-any ((list-at fs i).value) names depth then True
   else simp-binds-any-fields fs names depth (i + 1) len

  simp-binds-any-branches : List IRBranch, List Text, Integer, Integer, Integer -> Boolean
  simp-binds-any-branches (bs) (names) (depth) (i) (len) =
   if i >= len then False
   else let b = list-at bs i
   in if simp-pat-binds names (b.pattern) (depth + 1) then True
      else if simp-binds-any (b.guard) names depth then True
      else if simp-binds-any (b.body) names depth then True
      else simp-binds-any-branches bs names depth (i + 1) len

  simp-pat-binds : List Text, IRPat, Integer -> Boolean
  simp-pat-binds (names) (p) (depth) =
   if depth >= max-recursion-depth then True
   else when p
    is IrVarPat (n) (t) (s) -> simp-name-in names n
    is IrCtorPat (n) (subs) (t) (s) -> simp-pat-binds-list names subs (depth + 1) 0 (list-length subs)
    is IrVecPat (subs) (t) (s) -> simp-pat-binds-list names subs (depth + 1) 0 (list-length subs)
    is otherwise -> False

  simp-pat-binds-list : List Text, List IRPat, Integer, Integer, Integer -> Boolean
  simp-pat-binds-list (names) (ps) (depth) (i) (len) =
   if i >= len then False
   else if simp-pat-binds names (list-at ps i) depth then True
   else simp-pat-binds-list names ps depth (i + 1) len

  simp-binds-any-stmts : List IRActStmt, List Text, Integer, Integer, Integer -> Boolean
  simp-binds-any-stmts (ss) (names) (depth) (i) (len) =
   if i >= len then False
   else let s = list-at ss i
   in when s
    is IrDoExec (v) (sp) -> if simp-binds-any v names depth then True else simp-binds-any-stmts ss names depth (i + 1) len
    is IrDoBind (n) (t) (v) (sp) -> if simp-name-in names n then True else if simp-binds-any v names depth then True else simp-binds-any-stmts ss names depth (i + 1) len

  simp-binds-any-clauses : List IRHandleClause, List Text, Integer, Integer, Integer -> Boolean
  simp-binds-any-clauses (cs) (names) (depth) (i) (len) =
   if i >= len then False
   else let c = list-at cs i
   in if simp-name-in names (c.resume-name) then True
      else if simp-name-in-list names (c.params) 0 (list-length (c.params)) then True
      else if simp-binds-any (c.body) names depth then True
      else simp-binds-any-clauses cs names depth (i + 1) len

  simp-name-in-list : List Text, List Text, Integer, Integer -> Boolean
  simp-name-in-list (names) (xs) (i) (len) =
   if i >= len then False
   else if simp-name-in names (list-at xs i) then True
   else simp-name-in-list names xs (i + 1) len

  simp-inline-ok : Text, IRExpr, IRExpr -> Boolean
  simp-inline-ok (n) (v) (b) =
   when v
    is IrName (y) (t) (s) -> if simp-binds-any b [y] 0 then False else True
    is otherwise ->
     if simp-pure-trapfree v 0 then
      (if simp-occ-once n b then (if simp-binds-any b (simp-free-names v) 0 then False else True) else False)
     else False

Section: Expression Walk

 One traversal, carrying the substitution down and the rewrite count up.
 A node past the depth budget is returned untouched -- sound, because
 leaving a subtree unsimplified never changes its meaning.

  simplify-expr : SkipListText, List SubstEntry, IRExpr, Integer -> SimpRes
  simplify-expr (dn) (env) (e) (depth) =
   if depth >= max-recursion-depth then SimpRes { expr = e, ticks = 0 }
   else when e
    is IrIntLit (v) (s) | IrNumLit (v) (s) | IrTextLit (v) (s) | IrBoolLit (v) (s) | IrCharLit (v) (s) -> SimpRes { expr = e, ticks = 0 }
    is IrName (n) (t) (s) ->
     let i = subst-find env n 0 (list-length env)
     in if i < 0 then SimpRes { expr = e, ticks = 0 }
        else SimpRes { expr = (list-at env i).val, ticks = 1 }
    is IrNegate (x) (t) (s) ->
     let rx = simplify-expr dn env x (depth + 1)
     in (when rx.expr
      is IrIntLit (v) (ls) -> SimpRes { expr = deck-record (IrIntLit (-v) s), ticks = rx.ticks + 1 }
      is otherwise -> SimpRes { expr = deck-record (IrNegate (rx.expr) t s), ticks = rx.ticks })
    is IrBinary (op) (l) (r) (t) (s) ->
     let rl = simplify-expr dn env l (depth + 1)
     in let rr = simplify-expr dn env r (depth + 1)
     in let fr = simp-fold-binary op (rl.expr) (rr.expr) t s
     in SimpRes { expr = fr.expr, ticks = rl.ticks + rr.ticks + (if fr.folded then 1 else 0) }
    is IrIf (c) (th) (el) (t) (s) ->
     let rc = simplify-expr dn env c (depth + 1)
     in (when rc.expr
      is IrBoolLit (b) (cs) ->
       let rt = simplify-expr dn env (if b then th else el) (depth + 1)
       in SimpRes { expr = rt.expr, ticks = rc.ticks + rt.ticks + 1 }
      is otherwise ->
       let rt = simplify-expr dn env th (depth + 1)
       in let re = simplify-expr dn env el (depth + 1)
       in SimpRes { expr = deck-record (IrIf (rc.expr) (rt.expr) (re.expr) t s), ticks = rc.ticks + rt.ticks + re.ticks })
    is IrLet (n) (t) (v) (b) (s) ->
     let rv = simplify-expr dn env v (depth + 1)
     in if simp-is-literal (rv.expr)
        then let rb = simplify-expr (dn) (subst-add env n (rv.expr)) b (depth + 1)
             in SimpRes { expr = rb.expr, ticks = rv.ticks + rb.ticks + 1 }
        else if simp-inline-ok n (rv.expr) b
        then let rb = simplify-expr (dn) (subst-add env n (rv.expr)) b (depth + 1)
             in SimpRes { expr = rb.expr, ticks = rv.ticks + rb.ticks + 1 }
        else let rb = simplify-expr (dn) (subst-remove env n) b (depth + 1)
             in if simp-pure-trapfree (rv.expr) 0 & simp-is-dead n (rb.expr)
                then SimpRes { expr = rb.expr, ticks = rv.ticks + rb.ticks + 1 }
                else SimpRes { expr = deck-record (IrLet n t (rv.expr) (rb.expr) s), ticks = rv.ticks + rb.ticks }
    is IrApply (f) (a) (t) (s) ->
     let rf = simplify-expr dn env f (depth + 1)
     in let ra = simplify-expr dn env a (depth + 1)
     in let fr = simp-fold-apply dn (rf.expr) (ra.expr) t s
     in SimpRes { expr = fr.expr, ticks = rf.ticks + ra.ticks + (if fr.folded then 1 else 0) }
    is IrLambda (ps) (b) (t) (s) ->
     let rb = simplify-expr (dn) (subst-remove-names env ps 0 (list-length ps)) b (depth + 1)
     in SimpRes { expr = deck-record (IrLambda ps (rb.expr) t s), ticks = rb.ticks }
    is IrList (es) (t) (s) ->
     let r = simplify-exprs dn env es (depth + 1) 0 (list-length es) [] 0
     in SimpRes { expr = deck-record (IrList (r.stmts-as-exprs) t s), ticks = r.ticks }
    is IrMatch (sc) (bs) (t) (s) ->
     let rsc = simplify-expr dn env sc (depth + 1)
     in let rb = simplify-branches dn env bs (depth + 1) 0 (list-length bs) [] 0
     in SimpRes { expr = deck-record (IrMatch (rsc.expr) (rb.branches) t s), ticks = rsc.ticks + rb.ticks }
    is IrAct (ss) (t) (s) ->
     let r = simplify-stmts dn env ss (depth + 1) 0 (list-length ss) [] 0
     in SimpRes { expr = deck-record (IrAct (r.stmts) t s), ticks = r.ticks }
    is IrHandle (eff) (h) (cs) (t) (s) ->
     let rh = simplify-expr dn env h (depth + 1)
     in let rc = simplify-clauses dn cs (depth + 1) 0 (list-length cs) [] 0
     in SimpRes { expr = deck-record (IrHandle eff (rh.expr) (rc.clauses) t s), ticks = rh.ticks + rc.ticks }
    is IrWithTimeout (secs) (effs) (scopes) (body) (t) (s) ->
     let rb = simplify-expr dn env body (depth + 1)
     in SimpRes { expr = deck-record (IrWithTimeout secs effs scopes (rb.expr) t s), ticks = rb.ticks }
    is IrRecord (n) (fs) (t) (s) ->
     let r = simplify-fields dn env fs (depth + 1) 0 (list-length fs) [] 0
     in SimpRes { expr = deck-record (IrRecord n (r.fields) t s), ticks = r.ticks }
    is IrFieldAccess (r) (f) (t) (s) ->
     let rr = simplify-expr dn env r (depth + 1)
     in SimpRes { expr = deck-record (IrFieldAccess (rr.expr) f t s), ticks = rr.ticks }
    is IrFork (b) (t) (s) ->
     let rb = simplify-expr dn env b (depth + 1)
     in SimpRes { expr = deck-record (IrFork (rb.expr) t s), ticks = rb.ticks }
    is IrAwait (tk) (t) (s) ->
     let rt = simplify-expr dn env tk (depth + 1)
     in SimpRes { expr = deck-record (IrAwait (rt.expr) t s), ticks = rt.ticks }
    is IrTry (mx) (body) (fb) (fail) (t) (s) ->
     let r1 = simplify-stmts dn [] body (depth + 1) 0 (list-length body) [] 0
     in let r2 = simplify-stmts dn [] fb (depth + 1) 0 (list-length fb) [] 0
     in let r3 = simplify-stmts dn [] fail (depth + 1) 0 (list-length fail) [] 0
     in SimpRes { expr = deck-record (IrTry mx (r1.stmts) (r2.stmts) (r3.stmts) t s), ticks = r1.ticks + r2.ticks + r3.ticks }
    is IrFieldStore (r) (f) (v) (t) (s) ->
     let rr = simplify-expr dn env r (depth + 1)
     in let rv = simplify-expr dn env v (depth + 1)
     in SimpRes { expr = deck-record (IrFieldStore (rr.expr) f (rv.expr) t s), ticks = rr.ticks + rv.ticks }
    is IrError (m) (t) (s) -> SimpRes { expr = e, ticks = 0 }

  subst-remove-names : List SubstEntry, List IRParam, Integer, Integer -> List SubstEntry
  subst-remove-names (env) (ps) (i) (len) =
   if i >= len then env
   else subst-remove-names (subst-remove env ((list-at ps i).name)) ps (i + 1) len

Section: List and Field Walks

  SimpExprsRes = record {
   stmts-as-exprs : List IRExpr,
   ticks : Integer
  }

  simplify-exprs : SkipListText, List SubstEntry, List IRExpr, Integer, Integer, Integer, List IRExpr, Integer -> SimpExprsRes
  simplify-exprs (dn) (env) (es) (depth) (i) (len) (acc) (ticks) =
   if i >= len then SimpExprsRes { stmts-as-exprs = acc, ticks = ticks }
   else let r = simplify-expr dn env (list-at es i) depth
   in simplify-exprs dn env es depth (i + 1) len (list-push acc (r.expr)) (ticks + r.ticks)

  SimpFieldsRes = record {
   fields : List IRFieldVal,
   ticks : Integer
  }

  simplify-fields : SkipListText, List SubstEntry, List IRFieldVal, Integer, Integer, Integer, List IRFieldVal, Integer -> SimpFieldsRes
  simplify-fields (dn) (env) (fs) (depth) (i) (len) (acc) (ticks) =
   if i >= len then SimpFieldsRes { fields = acc, ticks = ticks }
   else let f = list-at fs i
   in let r = simplify-expr dn env (f.value) depth
   in simplify-fields dn env fs depth (i + 1) len (list-push acc (deck-record (__record-set f "value" (r.expr)))) (ticks + r.ticks)

Section: Statement, Branch, and Clause Walks

  simplify-stmts : SkipListText, List SubstEntry, List IRActStmt, Integer, Integer, Integer, List IRActStmt, Integer -> SimpStmtsRes
  simplify-stmts (dn) (env) (ss) (depth) (i) (len) (acc) (ticks) =
   if i >= len then SimpStmtsRes { stmts = acc, ticks = ticks }
   else let s = list-at ss i
   in when s
    is IrDoExec (v) (sp) ->
     let rv = simplify-expr dn env v depth
     in simplify-stmts dn env ss depth (i + 1) len (list-push acc (deck-record (IrDoExec (rv.expr) sp))) (ticks + rv.ticks)
    is IrDoBind (n) (t) (v) (sp) ->
     let rv = simplify-expr dn env v depth
     in simplify-stmts dn (subst-remove env n) ss depth (i + 1) len (list-push acc (deck-record (IrDoBind n t (rv.expr) sp))) (ticks + rv.ticks)

  SimpBranchesRes = record {
   branches : List IRBranch,
   ticks : Integer
  }

  simplify-branches : SkipListText, List SubstEntry, List IRBranch, Integer, Integer, Integer, List IRBranch, Integer -> SimpBranchesRes
  simplify-branches (dn) (env) (bs) (depth) (i) (len) (acc) (ticks) =
   if i >= len then SimpBranchesRes { branches = acc, ticks = ticks }
   else let b = list-at bs i
   in let benv = subst-remove-pat env (b.pattern) depth
   in let rg = simplify-expr dn benv (b.guard) depth
   in let rbody = simplify-expr dn benv (b.body) depth
   in simplify-branches dn env bs depth (i + 1) len (list-push acc (deck-record (IRBranch { pattern = b.pattern, body = rbody.expr, guard = rg.expr, span = b.span, alt-group = b.alt-group }))) (ticks + rg.ticks + rbody.ticks)

  subst-remove-pat : List SubstEntry, IRPat, Integer -> List SubstEntry
  subst-remove-pat (env) (p) (depth) =
   if depth >= max-recursion-depth then env
   else when p
    is IrVarPat (n) (t) (s) -> subst-remove env n
    is IrCtorPat (n) (subs) (t) (s) -> subst-remove-pats env subs (depth + 1) 0 (list-length subs)
    is IrVecPat (subs) (t) (s) -> subst-remove-pats env subs (depth + 1) 0 (list-length subs)
    is otherwise -> env

  subst-remove-pats : List SubstEntry, List IRPat, Integer, Integer, Integer -> List SubstEntry
  subst-remove-pats (env) (ps) (depth) (i) (len) =
   if i >= len then env
   else subst-remove-pats (subst-remove-pat env (list-at ps i) depth) ps depth (i + 1) len

  SimpClausesRes = record {
   clauses : List IRHandleClause,
   ticks : Integer
  }

  simplify-clauses : SkipListText, List IRHandleClause, Integer, Integer, Integer, List IRHandleClause, Integer -> SimpClausesRes
  simplify-clauses (dn) (cs) (depth) (i) (len) (acc) (ticks) =
   if i >= len then SimpClausesRes { clauses = acc, ticks = ticks }
   else let c = list-at cs i
   in let rb = simplify-expr dn [] (c.body) depth
   in simplify-clauses dn cs depth (i + 1) len (list-push acc (deck-record (__record-set c "body" (rb.expr)))) (ticks + rb.ticks)

Section: Definition and Chapter

  simplify-def : SkipListText, IRDef -> SimpDefRes
  simplify-def (dn) (d) =
   let r = simplify-iter dn (d.body) 0 0
   in let d2 = __record-set d "body" (r.expr)
   in SimpDefRes { def = deck-record d2, ticks = r.ticks }

  simplify-iter : SkipListText, IRExpr, Integer, Integer -> SimpRes
  simplify-iter (dn) (body) (iter) (acc) =
   let r = simplify-expr dn [] body 0
   in if r.ticks == 0 then SimpRes { expr = r.expr, ticks = acc }
      else if (iter + 1) >= simplify-max-iters then SimpRes { expr = r.expr, ticks = acc + r.ticks }
      else simplify-iter dn (r.expr) (iter + 1) (acc + r.ticks)

  simplify-defs : SkipListText, List IRDef, Integer, Integer, List IRDef, Integer -> SimpDefsRes
  simplify-defs (dn) (defs) (i) (len) (acc) (ticks) =
   if i >= len then SimpDefsRes { defs = acc, ticks = ticks }
   else let r = simplify-def dn (list-at defs i)
   in simplify-defs dn defs (i + 1) len (list-push acc (r.def)) (ticks + r.ticks)

  simplify-chapter : IRChapter -> IRChapter
  simplify-chapter (ch) =
   let dn = deck-record (skip-list-text-from-list (for d in (ch.defs) -> d.name))
   in __record-set ch "defs" ((simplify-defs dn (ch.defs) 0 (list-length (ch.defs)) [] 0).defs)

  simplify-run : IRChapter -> SimplifyOutcome
  simplify-run (ch) =
   let dn = deck-record (skip-list-text-from-list (for d in (ch.defs) -> d.name))
   in let r = simplify-defs dn (ch.defs) 0 (list-length (ch.defs)) [] 0
   in let ch2 = __record-set ch "defs" (r.defs)
   in SimplifyOutcome {
    chapter = ch2,
    infos = [ "SIMPLIFY: rewrites=" & integer-to-text (r.ticks) ]
   }


Chapter: Parsmi--Passes

Section: Pass Result

  IRPassResult = record {
   chapter : IRChapter,
   violations : List Text,
   infos : List Text
  }

Section: Pass Registry

 An unknown name is the identity transform. A diagnostic for a
 misspelled pass name belongs to the configuration surface and
 arrives with it; until then the pipeline must never turn a bad
 name into a changed program.

 It shipped opt-in for exactly one changelist while the measurements were
 taken, and they came back with nothing to weigh against it. Same
 compiler, pass off then on: the selfhost binary went 2,514,844 to
 2,504,887 bytes and its compile 10.1 s to 9.8 s; across nine other real
 programs six shrank, three were unchanged and none grew; every one of the
 ten produced byte-identical output; and the LOWER deck -- the tightest in
 the compiler, and the reason for the caution -- read 286,227,712 both
 ways, so the substituted bodies cost it nothing measurable.

 Unlike the other passes, `lir-dump` does NOT execute inside this
 pipeline: the constructor-pattern increment needs its scrutinee's
 resolved `SumTy`, and this pipeline runs before the RESOLVE phase. So the
 registry entry is inert (it returns nothing) and `opening.codex` produces
 the LIR report from `lir-report-if` after RESOLVE and LIFT, over the same
 `cdx-chapter` the emitter consumes. The pipeline name is still the
 trigger; only the execution site moved.

  default-ir-pipeline : List Text
  default-ir-pipeline = ["fold-constants", "inline-leaf-calls", "inline-single-caller"]

 A plug that emits SOURCE resolves a call by its name, so a pass that
 substitutes a body and deletes the call deletes the plug's only handle on
 it. The inline passes are therefore absent here and must stay absent. This
 is not a statement about IR: the machine-code plugs read the same IR-CCE
 and keep the full pipeline.

 WHICH PLUGS TAKE THIS, ruled 2026-08-16: by-name resolution decides, not
 target shape. Ask whether the plug's OUTPUT names the callee; if it does,
 it takes this pipeline however low-level the target looks. `ptx`, `wasm`
 and `wgsl` are ISA-shaped and all three take it, measured by emitting one
 probe both ways and seeing a call site appear. `arm64` and `riscv` do not,
 and they are settled by taking no IR-CCE at all rather than by being
 assembly. Decide it by measuring a probe, not by reading the target's name:
 35 of 50 plugs shipped on the wrong pipeline until 2026-08-16 because
 nobody had.

 A plug that cannot express the probe cannot be classified by it. `t3isa`
 is ternary and refuses IEEE 754 by construction, so a probe using `Real`
 never reaches its call emission and answers nothing about it either way.
 Measured with an integer-only probe 2026-08-16, it needs no entry here at
 all: a def with a bounded boundary is never an inline candidate
 (`Lowering.codex:1675`, so the band's entry and epilogue guards are not
 spliced past), and `t3isa` refuses an unbanded integer, so no inline pass
 can reach any program it accepts.

 Two probe shapes answer nothing here, and both looked like answers. A
 callee reached only with LITERAL arguments from inside an `act` is left
 alone by the passes, so its arms match while measuring nothing. And a
 chapter with no `opening` emits the foreword too, so its arms differ on
 foreword definitions that are not the probe's. Give the probe an
 `opening` and compare, or the reachable set is not the thing under test.

  text-plug-ir-pipeline : List Text
  text-plug-ir-pipeline = ["fold-constants"]

  run-ir-pass : Text, IRChapter -> IRPassResult
  run-ir-pass (name) (ch) =
   if name == "fold-constants" then IRPassResult { chapter = fold-constants-in-chapter ch, violations = [], infos = [] }
   else if name == "inline-leaf-calls" then IRPassResult { chapter = inline-leaf-calls-in-chapter ch, violations = [], infos = [] }
   else if name == "inline-single-caller" then IRPassResult { chapter = inline-single-caller-in-chapter ch, violations = [], infos = [] }
   else if name == "inline-cost-based" then IRPassResult { chapter = inline-cost-based-in-chapter ch, violations = [], infos = [] }
   else if name == "ir-check" then IRPassResult { chapter = ch, violations = ir-check ch, infos = [] }
   else if name == "occ-report" then IRPassResult { chapter = ch, violations = [], infos = occ-report-chapter ch }
   else if name == "simplify" then let o = simplify-run ch in IRPassResult { chapter = o.chapter, violations = [], infos = o.infos }
   else if name == "lir-dump" then IRPassResult { chapter = ch, violations = [], infos = [] }
   else IRPassResult { chapter = ch, violations = [], infos = [] }

Section: Pipeline

 The chapter folds through the named passes in list order. The loop
 carries an index, the current chapter, and the violations reported so
 far; every allocation is the pass's own, on whatever deck the caller
 placed the run.

 The run reports the pipeline it actually ran, as its first info, so the
 compile log names its own passes. This is not decoration: `passes=` on the
 mode line REPLACES the default rather than adding to it, and a caller that
 wanted a reporter and wrote `passes=lir-dump` silently loses
 `fold-constants` and `inline-leaf-calls`. That is not a hypothetical --
 `build/lir-dump-test.ps1` did it for its whole existence and pinned IR
 nobody compiles, and the only symptom was a dump that disagreed with the
 emitted binary in a way nobody could explain from the artifact.

 An empty pipeline says so in words rather than printing nothing, because
 "no passes ran" and "the report did not run" look identical otherwise.

  pipeline-names-text : List Text, Integer, Integer, Text -> Text
  pipeline-names-text (names) (i) (n) (acc) =
   if i >= n then acc
   else pipeline-names-text names (i + 1) n (if acc == "" then list-at names i else acc & "," & list-at names i)

 Measured 2026-08-04 on the compiler's own source (2,999,659 bytes, CDX path):
 `fold-constants` +10,052,336, `inline-leaf-calls` +685,944,
 `inline-single-caller` +2,028,848 -- **12.2 MB for the whole pipeline.** So the
 passes are not where a gigabyte goes, and the C1 gap is not here. That is the
 third refuted hypothesis in this area after the deck floors and the IR text
 emitter, and like both of those it was refuted by measuring rather than by
 reasoning about the code's shape.

  run-ir-pipeline : List Text, IRChapter, Boolean -> IRPassResult
  run-ir-pipeline (names) (ch) (trace) =
   let n = list-length names
   in let line = "PIPELINE " & (if n == 0 then "(empty)" else pipeline-names-text names 0 n "")
   in run-ir-pipeline-loop names 0 n ch [] [line] trace

  pass-frontier-mark : Text, Integer, Integer -> Text
  pass-frontier-mark (name) (before) (after) =
   "PASS " & name & " frontier +" & integer-to-text (after - before) & " abs " & integer-to-text after

  run-ir-pipeline-loop : List Text, Integer, Integer, IRChapter, List Text, List Text, Boolean -> IRPassResult
  run-ir-pipeline-loop (names) (i) (len) (ch) (vs) (infos) (trace) =
   if i >= len then IRPassResult { chapter = ch, violations = vs, infos = infos }
   else let h-before = __heap-save
   in let r = run-ir-pass (list-at names i) ch
   in let h-after = __heap-save
   in let vs2 = tag-pass-violations vs i (r.violations) 0 (list-length (r.violations))
   in let infos2 = tag-pass-violations infos i (r.infos) 0 (list-length (r.infos))
   in let infos3 = if trace then list-push infos2 (pass-frontier-mark (list-at names i) h-before h-after) else infos2
   in run-ir-pipeline-loop names (i + 1) len (r.chapter) vs2 infos3 trace

  tag-pass-violations : List Text, Integer, List Text, Integer, Integer -> List Text
  tag-pass-violations (acc) (slot) (vs) (i) (len) =
   if i >= len then acc
   else tag-pass-violations (list-push acc ("pass " & integer-to-text slot & ": " & (list-at vs i))) slot vs (i + 1) len

Section: Configuration

  parse-pipeline-names : Text -> List Text
  parse-pipeline-names (names) = text-split names ","


Chapter: Parsmi--LirTargets
  cites Codex chapter Lir (LirTarget)

 Register-file descriptors that belong to no selector.

 The shipping descriptor, `lir-target-x86`, deliberately does not live
 here: it sits beside `lir-phys` in `Emit/X86_64Lir.codex` because
 `nregs` is the length of that mapping, and two files cannot be trusted
 to keep that true. A descriptor with a physical mapping belongs next to
 its mapping.

Section: The ARM64-Shaped Probe

 It is a SHAPE, not a machine. There is no `lir-phys` for it, nothing
 emits from it, and no ARM64 instruction is selected anywhere on its
 path. Naming it `a64-shape` rather than `a64` is deliberate: a real
 ARM64 descriptor arrives in a later retarget step with a mapping
 beside it, and the two must not be confused for one another.

 What it varies, and why each one is the interesting axis:

 **More registers.** Ten callee-saved against x86's four and eight
 argument registers against four, so the file is 19 wide where x86 is 9.
 x86-64 sits at the register count that is linear scan's
 hard case; a wider file exercises the arithmetic in the other
 direction, where the free-set walks and the occupant array are longer
 than anything the shipping target has ever handed them.

 **A different callee/arg split.** The pools are not merely bigger, they
 are cut in a different place. `[0, ncallee)` is callee-saved,
 `ncallee` alone is the scratch return register, and `[nargregs, nregs)`
 is the argument file -- so a helper that happened to be right because
 `nargregs` was `ncallee + 1` at four and five is right here for the
 same reason at ten and eleven, and one that had folded the two
 together is not.

 **No division-fixed pair.** This is the axis with a known trap behind
 it. ARM64 `sdiv` and RISC-V `div` are three-operand and fix nothing, so
 both indices are -1, and every consumer of the pair has to mean it: a
 bare `list-set-at occ (0 - 1)` is an out-of-range write, so a target
 with no fixed pair would corrupt the verifier's occupant map rather
 than exclude nothing. `Lir.codex` claims each of those sites is
 guarded. This descriptor is what asks.

  lir-target-a64-shape : LirTarget = LirTarget {
   ncallee = 10,
   nargregs = 11,
   nregs = 19,
   diva = 0 - 1,
   divb = 0 - 1,
   budget = 24
  }

Section: The Narrow Probe

 A wide file tests LESS than a narrow one, and the first run of the
 descriptor above is what showed it: with nineteen registers not one
 definition in the `lir-check` corpus spilled, so the crossing arm, the
 Belady eviction and the whole spill path never ran. The corpus was built
 to reach x86-64's pressure points at nine registers, and at nineteen it
 is all slack. A green from the wide probe alone would have been a green
 over paths nothing executed.

 So the second descriptor keeps the character that matters -- no
 division-fixed pair, a split that is not x86's -- and makes the file
 narrow enough to force the allocator into the corners: two callee-saved
 registers, one scratch return, two argument registers.

 This is the combination x86-64 can never present, and it is the one
 worth asking about: every spill and eviction the shipping target has
 ever taken was taken with a division-fixed pair to mask. Here the mask
 is empty and the file is full at the same time.

  lir-target-narrow-shape : LirTarget = LirTarget {
   ncallee = 2,
   nargregs = 3,
   nregs = 5,
   diva = 0 - 1,
   divb = 0 - 1,
   budget = 8
  }


Chapter: Parsmi--Codex Emitter
  cites Codex chapter Build Settings (max-recursion-depth)

Section: Type Definition Emission
  codex-emit-type-defs : List ATypeDef, Integer -> Text
  codex-emit-type-defs (tds) (i) =
   text-concat-list (for td in tds -> codex-emit-type-def td & "\n")

  codex-emit-type-def : ATypeDef -> Text
  codex-emit-type-def (td) =
   when td
    is ARecordTypeDef (name) (tparams) (fields) (is-mut) (s) ->
     let mut-prefix = if is-mut then "mutable " else ""
     in mut-prefix & name.value & codex-emit-tparams tparams 0 & " = record {" & codex-emit-record-field-defs fields 0 & "\n}\n"
    is AVariantTypeDef (name) (tparams) (ctors) (s) ->
     name.value & codex-emit-tparams tparams 0 & " =\n" & codex-emit-variant-ctors ctors 0
    is AUnitTypeDef (name) (base) (s) ->
     name.value & " = unit " & codex-emit-type-expr base

  codex-emit-tparams : List Name, Integer -> Text
  codex-emit-tparams (tparams) (i) =
   text-concat-list (for tp in tparams -> " (" & tp.value & ")")

  codex-emit-record-field-defs : List ARecordFieldDef, Integer -> Text
  codex-emit-record-field-defs (fields) (i) =
   text-concat-list (codex-emit-record-field-defs-acc fields i (list-length fields) [])

  codex-emit-record-field-defs-acc : List ARecordFieldDef, Integer, Integer, List Text -> List Text
  codex-emit-record-field-defs-acc (fields) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let comma = if i > 0 then "," else ""
   in codex-emit-record-field-defs-acc fields (i + 1) len (list-push acc (comma & "\n  " & f.name.value & " : " & codex-emit-type-expr (f.type-expr)))

  codex-emit-variant-ctors : List AVariantCtorDef, Integer -> Text
  codex-emit-variant-ctors (ctors) (i) =
   text-concat-list (codex-emit-variant-ctors-acc ctors i (list-length ctors) [])

  codex-emit-variant-ctors-acc : List AVariantCtorDef, Integer, Integer, List Text -> List Text
  codex-emit-variant-ctors-acc (ctors) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at ctors i
   in codex-emit-variant-ctors-acc ctors (i + 1) len (list-push acc ("  | " & c.name.value & codex-emit-ctor-fields (c.fields) 0 & "\n"))

  codex-emit-ctor-fields : List ATypeExpr, Integer -> Text
  codex-emit-ctor-fields (fields) (i) =
   text-concat-list (for f in fields -> " (" & codex-emit-type-expr f & ")")

  codex-emit-type-expr : ATypeExpr -> Text
  codex-emit-type-expr (te) =
   when te
    is ANamedType (name) (s) -> name.value
    is AFunType (p) (r) (s) -> codex-emit-fun-param-chain p r
    is AAppType (base) (args) (s) -> codex-emit-type-expr base & " " & codex-emit-type-expr-args args 0
    is AEffectType (effs) (scopes) (tail) (ret) (s) ->
     if list-length tail == 0 then "[" & codex-emit-effect-names effs 0 & "] " & codex-emit-type-expr ret
     else if list-length effs == 0 then "[" & (list-at tail 0).value & "] " & codex-emit-type-expr ret
     else "[" & codex-emit-effect-names effs 0 & ", " & (list-at tail 0).value & "] " & codex-emit-type-expr ret
    is ABoundedIntType (b) (lo) (hi) (mode) (s) -> codex-emit-type-expr b & " between " & integer-to-text lo & " and " & integer-to-text hi & codex-emit-overflow-mode mode
    is ALinearType (inner) (s) -> "linear " & codex-emit-type-expr inner
    is otherwise -> "Unknown"

  codex-emit-overflow-mode : OverflowMode -> Text
  codex-emit-overflow-mode (mode) =
   when mode
    is OvError -> ""
    is OvWrapping -> " wrapping"
    is OvClamping -> " clamping"

  codex-emit-integer-ty : Integer, Integer, OverflowMode -> Text
  codex-emit-integer-ty (lo) (hi) (mode) =
   if lo <= i64-min & hi >= i64-max then "Integer"
   else "Integer between " & integer-to-text lo & " and " & integer-to-text hi & codex-emit-overflow-mode mode

  codex-emit-fun-param-chain : ATypeExpr, ATypeExpr -> Text
  codex-emit-fun-param-chain (p) (r) =
   when r
    is AFunType (p2) (r2) (s2) -> codex-emit-fun-param p & ", " & codex-emit-fun-param-chain p2 r2
    is otherwise -> codex-emit-fun-param p & " -> " & codex-emit-type-expr r

  codex-emit-fun-param : ATypeExpr -> Text
  codex-emit-fun-param (te) =
   when te
    is AFunType (p) (r) (s) -> "(" & codex-emit-type-expr te & ")"
    is otherwise -> codex-emit-type-expr te

  codex-emit-type-expr-args : List ATypeExpr, Integer -> Text
  codex-emit-type-expr-args (args) (i) =
   text-concat-list (codex-emit-type-expr-args-acc args i (list-length args) [])

  codex-emit-type-expr-args-acc : List ATypeExpr, Integer, Integer, List Text -> List Text
  codex-emit-type-expr-args-acc (args) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then " " else ""
   in codex-emit-type-expr-args-acc args (i + 1) len (list-push acc (sep & codex-emit-type-expr-wrapped (list-at args i)))

  codex-emit-type-expr-wrapped : ATypeExpr -> Text
  codex-emit-type-expr-wrapped (te) =
   when te
    is AFunType (p) (r) (s) | AAppType (base) (args) (s) -> "(" & codex-emit-type-expr te & ")"
    is otherwise -> codex-emit-type-expr te

  codex-emit-effect-names : List Name, Integer -> Text
  codex-emit-effect-names (effs) (i) =
   text-concat-list (codex-emit-effect-names-acc effs i (list-length effs) [])

  codex-emit-effect-names-acc : List Name, Integer, Integer, List Text -> List Text
  codex-emit-effect-names-acc (effs) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then ", " else ""
   in codex-emit-effect-names-acc effs (i + 1) len (list-push acc (sep & (list-at effs i).value))

Section: TypeVar Normalization
  TypeVarMap = record {
   entries : List Integer,
   next-id : Integer between 0 and 65535
  }

  empty-tvar-map : TypeVarMap = TypeVarMap { entries = [], next-id = 0 }

  tvar-map-lookup : List Integer, Integer, Integer -> Integer
  tvar-map-lookup (entries) (id) (i) =
   if i >= list-length entries then -1
   else if list-at entries i == id then i
   else tvar-map-lookup entries id (i + 1)

  tvar-map-insert : TypeVarMap, Integer -> TypeVarMap
  tvar-map-insert (m) (id) =
   if tvar-map-lookup (m.entries) id 0 >= 0 then m
   else TypeVarMap { entries = list-push (m.entries) id, next-id = m.next-id + 1 }

  collect-tvars : CodexType, TypeVarMap -> TypeVarMap
  collect-tvars (ty) (m) =
   when ty
    is TypeVar (id) -> tvar-map-insert m id
    is ForAllTy (id) (body) -> collect-tvars body (tvar-map-insert m id)
    is ForAllEff (id) (body) -> collect-tvars body m
    is FunTy (p) (row) (r) -> collect-tvars r (collect-tvars p m)
    is ListTy (elem) | LinkedListTy (elem) -> collect-tvars elem m
    is EffectfulTy (effs) (sc) (ret) -> collect-tvars ret m
    is ConstructedTy (name) (args) -> collect-tvars-list args 0 m
    is LinearTy (linner) -> collect-tvars linner m
    is otherwise -> m

  collect-tvars-list : List CodexType, Integer, TypeVarMap -> TypeVarMap
  collect-tvars-list (args) (i) (m) =
   if i == list-length args then m
   else collect-tvars-list args (i + 1) (collect-tvars (list-at args i) m)

  normalize-type : CodexType, TypeVarMap -> CodexType
  normalize-type (ty) (m) =
   when ty
    is TypeVar (id) -> TypeVar (__narrow (tvar-map-lookup (m.entries) id 0))
    is ForAllTy (id) (body) -> ForAllTy (__narrow (tvar-map-lookup (m.entries) id 0)) (normalize-type body m)
    is ForAllEff (id) (body) -> ForAllEff id (normalize-type body m)
    is FunTy (p) (row) (r) -> FunTy (normalize-type p m) row (normalize-type r m)
    is ListTy (elem) -> ListTy (normalize-type elem m)
    is LinkedListTy (elem) -> LinkedListTy (normalize-type elem m)
    is EffectfulTy (effs) (sc) (ret) -> EffectfulTy effs sc (normalize-type ret m)
    is ConstructedTy (name) (args) -> ConstructedTy name (normalize-type-list args 0 m)
    is LinearTy (linner) -> LinearTy (normalize-type linner m)
    is otherwise -> ty

  normalize-type-list : List CodexType, Integer, TypeVarMap -> List CodexType
  normalize-type-list (args) (i) (m) =
   for a in args -> normalize-type a m

  normalize-type-vars : CodexType -> CodexType
  normalize-type-vars (ty) =
   let m = collect-tvars ty empty-tvar-map
   in if m.next-id == 0 then ty
      else normalize-type ty m

Section: CodexType Emission

  codex-emit-type : CodexType -> Text
  codex-emit-type (ty) =
   when ty
    is IntegerTy (lo) (hi) (mode) -> codex-emit-integer-ty lo hi mode
    is RealTy (w) (m) -> "Real" & real-width-suffix w & real-mode-suffix m
    is TextTy -> "Text"
    is BooleanTy -> "Boolean"
    is CharTy -> "Char"
    is VoidTy | NothingTy -> "Nothing"
    is ErrorTy -> "Unknown"
    is FunTy (p) (row) (r) -> codex-emit-fun-params p row r
    is ListTy (elem) -> "List " & wrap-complex elem
    is LinkedListTy (elem) -> "LinkedList " & wrap-complex elem
    is TypeVar (id) -> "a" & integer-to-text id
    is ForAllTy (id) (body) -> codex-emit-type body
    is ForAllEff (id) (body) -> codex-emit-type body
    is SumTy (name) (ty-args) (ctors) | RecordTy (name) (args) (fields) -> name.value
    is ConstructedTy (name) (args) ->
     if is-tup-type-name (name.value) (list-length args) then "(" & codex-emit-tuple-type-elems args 0 (list-length args) & ")"
     else if list-length args == 0 then name.value
     else name.value & codex-emit-type-args args 0
    is EffectfulTy (effs) (sc) (ret) -> "[" & codex-emit-type-effect-names effs 0 & "] " & codex-emit-type ret
    is UnitTy (name) (inner) -> name.value
    is VectorTy (n) (t) -> "Vector " & integer-to-text n & " " & wrap-complex t
    is VectorMaskTy (n) -> "VectorMask " & integer-to-text n
    is LinearTy (linner) -> "linear " & wrap-complex linner
    is otherwise -> "Unknown"

  codex-emit-fun-params : CodexType, EffectRow, CodexType -> Text
  codex-emit-fun-params (p) (row) (r) =
   when r
    is FunTy (p2) (row2) (r2) -> wrap-fun-param p & ", " & codex-emit-fun-params p2 row2 r2
    is otherwise -> wrap-fun-param p & " -> " & codex-emit-row-result row r

  codex-emit-row-result : EffectRow, CodexType -> Text
  codex-emit-row-result (row) (r) =
   let has-labels = list-length (row.labels) > 0
   in let has-tail = text-length (row.tail-name) > 0
   in if has-labels == False & has-tail == False then codex-emit-type r
   else let tail-part = if has-tail then (if has-labels then ", " else "") & row.tail-name else ""
   in "[" & codex-emit-row-labels (row.labels) 0 & tail-part & "] " & codex-emit-type r

  codex-emit-row-labels : List EffectLabel, Integer -> Text
  codex-emit-row-labels (ls) (i) =
   if i == list-length ls then ""
   else let l = list-at ls i
   in let sep = if i > 0 then ", " else ""
   in let scope-part = if text-length (l.scope) > 0 then " \"" & (l.scope) & "\"" else ""
   in sep & (l.name.value) & scope-part & codex-emit-row-labels ls (i + 1)

  wrap-fun-param : CodexType -> Text
  wrap-fun-param (ty) =
   when ty
    is FunTy (p) (row) (r) -> "(" & codex-emit-type ty & ")"
    is otherwise -> codex-emit-type ty

  wrap-complex : CodexType -> Text
  wrap-complex (ty) =
   when ty
    is FunTy (p) (row) (r) | ListTy (elem) | LinkedListTy (elem) -> "(" & codex-emit-type ty & ")"
    is ConstructedTy (name) (args) ->
     if list-length args == 0 then name.value
     else "(" & codex-emit-type ty & ")"
    is otherwise -> codex-emit-type ty

  codex-emit-type-args : List CodexType, Integer -> Text
  codex-emit-type-args (args) (i) =
   if i == list-length args then ""
   else " " & wrap-complex (list-at args i) & codex-emit-type-args args (i + 1)

  is-tup-type-name : Text, Integer -> Boolean
  is-tup-type-name (n) (arity) =
   if arity < 2 then False
   else if arity > 5 then False
   else n == ("Tup" & integer-to-text arity)

  codex-emit-tuple-type-elems : List CodexType, Integer, Integer -> Text
  codex-emit-tuple-type-elems (args) (i) (len) =
   if i >= len then ""
   else let sep = if i > 0 then ", " else ""
   in sep & codex-emit-type (list-at args i) & codex-emit-tuple-type-elems args (i + 1) len

  codex-emit-type-effect-names : List Name, Integer -> Text
  codex-emit-type-effect-names (effs) (i) =
   if i == list-length effs then ""
   else let sep = if i > 0 then ", " else ""
   in sep & (list-at effs i).value & codex-emit-type-effect-names effs (i + 1)

Section: Definition Emission
  codex-emit-def : IRDef, List Text, List RenameEntry -> Text
  codex-emit-def (d) (ctor-names) (renames) =
   if skip-def d ctor-names then ""
   else let norm-ty = normalize-type-vars (d.type-val)
   in let sig = d.name & " : " & codex-emit-type norm-ty & "\n" & d.name & codex-emit-def-params (d.params) 0
   in sig & " =\n  " & codex-emit-expr (d.body) ctor-names 2 & "\n"

  skip-def : IRDef, List Text -> Boolean
  skip-def (d) (ctor-names) =
   if text-set-has ctor-names (d.name) then True
   else if text-length (d.name) == 0 then True
   else let first = char-code-at (d.name) 0
   in if first < 13 then True
      else if first > 38 then True
      else False

  codex-emit-def-params : List IRParam, Integer -> Text
  codex-emit-def-params (params) (i) =
   text-concat-list (codex-emit-def-params-acc params i (list-length params) [])

  codex-emit-def-params-acc : List IRParam, Integer, Integer, List Text -> List Text
  codex-emit-def-params-acc (params) (i) (len) (acc) =
   if i == len then acc
   else let p = list-at params i
   in codex-emit-def-params-acc params (i + 1) len (list-push acc (" (" & p.name & ")"))

Section: Expression Emission
  codex-emit-expr : IRExpr, List Text, Integer -> Text
  codex-emit-expr (e) (ctors) (indent) = codex-emit-expr-at e ctors indent 0

  codex-emit-expr-at : IRExpr, List Text, Integer, Integer -> Text
  codex-emit-expr-at (e) (ctors) (indent) (depth) =
   if depth >= max-recursion-depth then "?fuel-exhausted"
   else when e
    is IrIntLit (n) (sp) | IrNumLit (n) (sp) -> integer-to-text n
    is IrTextLit (s) (sp) -> "\"" & escape-text s & "\""
    is IrBoolLit (b) (sp) -> if b then "True" else "False"
    is IrCharLit (n) (sp) -> "'" & escape-char n & "'"
    is IrName (n) (ty) (sp) -> n
    is IrBinary (op) (l) (r) (ty) (sp) -> codex-emit-binary op l r ctors indent
    is IrNegate (operand) (ty) (sp) -> "-(" & codex-emit-expr-at operand ctors indent (depth + 1) & ")"
    is IrIf (c) (t) (el) (ty) (sp) -> codex-emit-if c t el ctors indent 0
    is IrLet (name) (ty) (val) (body) (sp) -> codex-emit-let name val body ctors indent
    is IrApply (f) (a) (ty) (sp) -> codex-emit-apply e ctors indent
    is IrLambda (params) (body) (ty) (sp) -> codex-emit-lambda params body ctors indent
    is IrList (elems) (ty) (sp) -> codex-emit-list elems ctors indent
    is IrMatch (scrut) (branches) (ty) (sp) -> codex-emit-match scrut branches ctors indent
    is IrAct (stmts) (ty) (sp) -> codex-emit-act stmts ctors indent
    is IrRecord (name) (fields) (ty) (sp) -> codex-emit-record name fields ctors indent
    is IrFieldAccess (rec) (field) (ty) (sp) -> codex-emit-field-access rec field ctors indent
    is IrFieldStore (rec) (field) (val) (ty) (sp) -> codex-emit-field-access rec field ctors indent & " = " & codex-emit-expr val ctors indent
    is IrFork (body) (ty) (sp) -> "fork (" & codex-emit-expr-at body ctors indent (depth + 1) & ")"
    is IrAwait (task) (ty) (sp) -> "await (" & codex-emit-expr-at task ctors indent (depth + 1) & ")"
    is IrHandle (eff) (body) (clauses) (ty) (sp) -> codex-emit-handle eff body clauses ctors indent
    is IrWithTimeout (secs) (effs) (scopes) (body) (ty) (sp) -> codex-emit-with-timeout secs effs scopes body ctors indent
    is IrTry (max) (body) (fb) (fail) (ty) (sp) -> codex-emit-try max body fb fail ctors indent
    is IrError (msg) (ty) (sp) -> "0"

Section: Binary Operators
  codex-emit-binary : IRBinaryOp, IRExpr, IRExpr, List Text, Integer -> Text
  codex-emit-binary (op) (l) (r) (ctors) (indent) =
   wrap-binary-left op l ctors indent & " " & bin-op-text op & " " & wrap-binary-right op r ctors indent

 An application that prints as for-sugar must parenthesize as a
 binary operand: an unwrapped `for x in xs -> body & rest` re-parses
 with `& rest` inside the for-body -- a silently different program
 (FabledTreasureMap entry 9). Plain applications bind tighter than
 any operator and need no wrap.

  wrap-binary-left : IRBinaryOp, IRExpr, List Text, Integer -> Text
  wrap-binary-left (parent-op) (e) (ctors) (indent) =
   when e
    is IrBinary (child-op) (l2) (r2) (ty) (sp) -> if bin-op-prec child-op < bin-op-prec parent-op then "(" & codex-emit-expr e ctors indent & ")"
    else codex-emit-expr e ctors indent
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & codex-emit-expr e ctors indent & ")"
    is IrApply (f2) (a2) (ty) (sp) -> if apply-prints-as-for e then "(" & codex-emit-expr e ctors indent & ")"
    else codex-emit-expr e ctors indent
    is otherwise -> codex-emit-expr e ctors indent

  wrap-binary-right : IRBinaryOp, IRExpr, List Text, Integer -> Text
  wrap-binary-right (parent-op) (e) (ctors) (indent) =
   when e
    is IrBinary (child-op) (l2) (r2) (ty) (sp) -> if needs-right-wrap parent-op child-op then "(" & codex-emit-expr e ctors indent & ")"
    else codex-emit-expr e ctors indent
    is IrIf (c) (t) (el) (ty) (sp) -> "(" & codex-emit-expr e ctors indent & ")"
    is IrApply (f2) (a2) (ty) (sp) -> if apply-prints-as-for e then "(" & codex-emit-expr e ctors indent & ")"
    else codex-emit-expr e ctors indent
    is otherwise -> codex-emit-expr e ctors indent

  apply-prints-as-for : IRExpr -> Boolean
  apply-prints-as-for (e) =
   let chain = collect-apply-chain e []
   in is-for-expr (chain.root) (chain.args)

  needs-right-wrap : IRBinaryOp, IRBinaryOp -> Boolean
  needs-right-wrap (parent) (child) =
   if bin-op-prec child < bin-op-prec parent then True
   else if bin-op-prec child > bin-op-prec parent then False
   else if bin-op-text parent == bin-op-text child then if is-associative-op parent then False else True
   else True

  is-associative-op : IRBinaryOp -> Boolean
  is-associative-op (op) =
   when op
    is IrAddInt | IrAddNum | IrAddRealApprox | IrAddRealTrapping | IrAddRealSaturating | IrMulInt | IrMulNum | IrMulRealApprox | IrMulRealTrapping | IrMulRealSaturating | IrAddVec | IrMulVec | IrAppendText | IrAppendList | IrConsList | IrAnd | IrOr -> True
    is otherwise -> False

  bin-op-prec : IRBinaryOp -> Integer
  bin-op-prec (op) =
   when op
    is IrOr -> 2
    is IrAnd -> 3
    is IrEq | IrNotEq | IrLt | IrGt | IrLtEq | IrGtEq | IrApproxEq | IrApproxEqExact | IrLtVec | IrGtVec | IrLtEqVec | IrGtEqVec -> 4
    is IrAppendText | IrAppendList -> 3
    is IrConsList -> 5
    is IrAddInt | IrSubInt | IrAddNum | IrSubNum | IrAddRealApprox | IrSubRealApprox | IrAddRealTrapping | IrSubRealTrapping | IrAddRealSaturating | IrSubRealSaturating | IrAddVec | IrSubVec -> 6
    is IrMulInt | IrDivInt | IrMulNum | IrDivNum | IrMulRealApprox | IrDivRealApprox | IrMulRealTrapping | IrDivRealTrapping | IrMulRealSaturating | IrDivRealSaturating | IrMulVec | IrDivVec -> 7
    is IrPowInt -> 8
    is otherwise -> 0

  bin-op-text : IRBinaryOp -> Text
  bin-op-text (op) =
   when op
    is IrAddInt -> "+"
    is IrSubInt -> "-"
    is IrMulInt -> "*"
    is IrDivInt -> "/"
    is IrRemInt -> "__rem"
    is IrPowInt -> "^"
    is IrAddNum -> "+"
    is IrSubNum -> "-"
    is IrMulNum -> "*"
    is IrDivNum -> "/"
    is IrAddRealApprox -> "+"
    is IrSubRealApprox -> "-"
    is IrMulRealApprox -> "*"
    is IrDivRealApprox -> "/"
    is IrAddRealTrapping -> "+"
    is IrSubRealTrapping -> "-"
    is IrMulRealTrapping -> "*"
    is IrDivRealTrapping -> "/"
    is IrAddRealSaturating -> "+"
    is IrSubRealSaturating -> "-"
    is IrMulRealSaturating -> "*"
    is IrDivRealSaturating -> "/"
    is IrEq -> "=="
    is IrNotEq -> "/="
    is IrLt -> "<"
    is IrGt -> ">"
    is IrLtEq -> "<="
    is IrGtEq -> ">="
    is IrAnd -> "&"
    is IrOr -> "|"
    is IrAppendText | IrAppendList -> "&"
    is IrConsList -> "::"
    is IrAddVec -> "+"
    is IrSubVec -> "-"
    is IrMulVec -> "*"
    is IrDivVec -> "/"
    is IrLtVec -> "<"
    is IrGtVec -> ">"
    is IrLtEqVec -> "<="
    is IrGtEqVec -> ">="
    is IrApproxEq -> "~"
    is IrApproxEqExact -> "~0"

Section: If/Then/Else
  codex-emit-if : IRExpr, IRExpr, IRExpr, List Text, Integer, Integer -> Text
  codex-emit-if (c) (t) (el) (ctors) (indent) (else-offset) =
   text-concat-list (codex-emit-if-chain c t el ctors indent else-offset [])

  codex-emit-if-chain : IRExpr, IRExpr, IRExpr, List Text, Integer, Integer, List Text -> List Text
  codex-emit-if-chain (c) (t) (el) (ctors) (indent) (else-offset) (acc) =
   let acc2 = list-push acc ("if " & codex-emit-expr c ctors indent & " then " & codex-emit-expr t ctors indent)
   in when el
    is IrIf (c2) (t2) (el2) (ty) (sp) ->
     codex-emit-if-chain c2 t2 el2 ctors indent else-offset (list-push acc2 ("\n" & make-indent indent & pad-spaces else-offset & "else "))
    is otherwise ->
     list-push acc2 ("\n" & make-indent indent & pad-spaces else-offset & "else " & codex-emit-expr el ctors indent)

  pad-spaces : Integer -> Text
  pad-spaces (n) =
   if n <= 0 then ""
   else " " & pad-spaces (n - 1)

Section: Let
  codex-emit-let : Text, IRExpr, IRExpr, List Text, Integer -> Text
  codex-emit-let (name) (val) (body) (ctors) (indent) =
   text-concat-list (codex-emit-let-chain name val body ctors indent [])

  codex-emit-let-chain : Text, IRExpr, IRExpr, List Text, Integer, List Text -> List Text
  codex-emit-let-chain (name) (val) (body) (ctors) (indent) (acc) =
   let acc2 = list-push acc ("let " & name & " = " & codex-emit-expr val ctors (indent + 1))
   in when body
    is IrLet (name2) (ty2) (val2) (body2) (sp2) ->
     codex-emit-let-chain name2 val2 body2 ctors indent (list-push acc2 ("\n" & make-indent indent & "in "))
    is IrIf (c) (t) (el) (ty) (sp) ->
     list-push acc2 ("\n" & make-indent indent & "in " & codex-emit-if c t el ctors indent 3)
    is otherwise ->
     list-push acc2 ("\n" & make-indent indent & "in " & codex-emit-expr body ctors indent)

Section: Apply Chain
  ApplyChain = record {
   root : IRExpr,
   args : List IRExpr
  }

  collect-apply-chain : IRExpr, List IRExpr -> ApplyChain
  collect-apply-chain (e) (acc) =
   when e
    is IrApply (f) (a) (ty) (sp) -> collect-apply-chain f ([a] & acc)
    is otherwise -> ApplyChain {
     root = e,
     args = acc
    }

Section: Apply
  codex-emit-apply : IRExpr, List Text, Integer -> Text
  codex-emit-apply (e) (ctors) (indent) =
   let chain = collect-apply-chain e []
   in let func = chain.root
   in let args = chain.args
   in if is-tuple-ctor func (list-length args) then "(" & codex-emit-tuple-expr-elems args ctors indent 0 (list-length args) & ")"
   else if is-for-expr func args then codex-emit-for-expr args ctors indent
   else codex-emit-expr func ctors indent & codex-emit-apply-args args ctors indent 0 (list-length args) (is-ctor-name func ctors)

  is-for-expr : IRExpr, List IRExpr -> Boolean
  is-for-expr (func) (args) =
   if list-length args == 2 then when func
    is IrName (n) (ty) (sp) -> if n == "map-list" then when (list-at args 0)
      is IrLambda (ps) (b) (t) (s) -> list-length ps == 1
      is otherwise -> False
     else False
    is otherwise -> False
   else False

  codex-emit-for-expr : List IRExpr, List Text, Integer -> Text
  codex-emit-for-expr (args) (ctors) (indent) =
   when (list-at args 0)
    is IrLambda (ps) (body) (ty) (sp) ->
     let param-name = (list-at ps 0).name
     in "for " & param-name & " in " & codex-emit-expr (list-at args 1) ctors indent & " -> " & codex-emit-expr body ctors (indent + 1)
    is otherwise -> "for _ in [] -> 0"

  is-tuple-ctor : IRExpr, Integer -> Boolean
  is-tuple-ctor (e) (arity) =
   if arity < 2 then False
   else if arity > 5 then False
   else when e
    is IrName (n) (ty) (sp) -> n == ("MkTup" & integer-to-text arity)
    is otherwise -> False

  codex-emit-tuple-expr-elems : List IRExpr, List Text, Integer, Integer, Integer -> Text
  codex-emit-tuple-expr-elems (args) (ctors) (indent) (i) (len) =
   if i >= len then ""
   else let sep = if i > 0 then ", " else ""
   in sep & codex-emit-expr (list-at args i) ctors indent & codex-emit-tuple-expr-elems args ctors indent (i + 1) len

  codex-emit-apply-args : List IRExpr, List Text, Integer, Integer, Integer, Boolean -> Text
  codex-emit-apply-args (args) (ctors) (indent) (i) (len) (is-ctor) =
   if i == len then ""
   else let arg = list-at args i
   in " " & wrap-arg arg ctors indent is-ctor & codex-emit-apply-args args ctors indent (i + 1) len is-ctor

  wrap-arg : IRExpr, List Text, Integer, Boolean -> Text
  wrap-arg (e) (ctors) (indent) (is-ctor) =
   if needs-parens e is-ctor then "(" & codex-emit-expr e ctors indent & ")"
   else codex-emit-expr e ctors indent

  is-ctor-name : IRExpr, List Text -> Boolean
  is-ctor-name (e) (ctors) =
   when e
    is IrName (n) (ty) (sp) -> text-set-has ctors n
    is otherwise -> False

  needs-parens : IRExpr, Boolean -> Boolean
  needs-parens (e) (is-ctor) =
   when e
    is IrApply (f) (a) (ty) (sp) | IrBinary (op) (l) (r) (ty) (sp) | IrIf (c) (t) (el) (ty) (sp) | IrLet (name) (ty) (val) (body) (sp) | IrMatch (scrut) (branches) (ty) (sp) | IrNegate (operand) (nty) (sp) | IrLambda (params) (body) (ty) (sp) | IrFieldAccess (rec) (field) (ty) (sp) | IrFieldStore (rec) (field) (val) (ty) (sp) | IrRecord (name) (fields) (ty) (sp) -> True
    is IrIntLit (n) (sp) -> n < 0
    is otherwise -> False

Section: Lambda
  codex-emit-lambda : List IRParam, IRExpr, List Text, Integer -> Text
  codex-emit-lambda (params) (body) (ctors) (indent) =
   "\\" & codex-emit-lambda-params params 0 & " -> " & codex-emit-expr body ctors indent

  codex-emit-lambda-params : List IRParam, Integer -> Text
  codex-emit-lambda-params (params) (i) =
   if i == list-length params then ""
   else let p = list-at params i
   in let sep = if i > 0 then " " else ""
   in sep & p.name & codex-emit-lambda-params params (i + 1)

Section: List
  codex-emit-list : List IRExpr, List Text, Integer -> Text
  codex-emit-list (elems) (ctors) (indent) =
   "[" & codex-emit-list-elems elems ctors indent 0 & "]"

  codex-emit-list-elems : List IRExpr, List Text, Integer, Integer -> Text
  codex-emit-list-elems (elems) (ctors) (indent) (i) =
   text-concat-list (codex-emit-list-elems-acc elems ctors indent i (list-length elems) [])

  codex-emit-list-elems-acc : List IRExpr, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-list-elems-acc (elems) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then ", " else ""
   in codex-emit-list-elems-acc elems ctors indent (i + 1) len (list-push acc (sep & codex-emit-expr (list-at elems i) ctors indent))

Section: Match
  codex-emit-match : IRExpr, List IRBranch, List Text, Integer -> Text
  codex-emit-match (scrut) (branches) (ctors) (indent) =
   if is-let-tuple-match branches then codex-emit-let-tuple scrut (list-at branches 0) ctors indent
   else "when " & codex-emit-expr scrut ctors indent & codex-emit-branches branches ctors indent 0

  is-let-tuple-match : List IRBranch -> Boolean
  is-let-tuple-match (branches) =
   if list-length branches == 1 then is-tuple-pat-branch (list-at branches 0)
   else False

  is-tuple-pat-branch : IRBranch -> Boolean
  is-tuple-pat-branch (b) =
   when b.guard
    is IrBoolLit (v) (sp) -> if v then is-mktup-pat (b.pattern) else False
    is otherwise -> False

  is-mktup-pat : IRPat -> Boolean
  is-mktup-pat (p) =
   when p
    is IrCtorPat (name) (subs) (ty) (sp) -> text-starts-with name "MkTup"
    is otherwise -> False

  codex-emit-let-tuple : IRExpr, IRBranch, List Text, Integer -> Text
  codex-emit-let-tuple (scrut) (b) (ctors) (indent) =
   let pat-text = codex-emit-tuple-pat-names (b.pattern) 0
   in "let (" & pat-text & ") = " & codex-emit-expr scrut ctors (indent + 1)
   & "\n" & make-indent indent & "in " & codex-emit-expr (b.body) ctors indent

  codex-emit-tuple-pat-names : IRPat, Integer -> Text
  codex-emit-tuple-pat-names (p) (i) =
   when p
    is IrCtorPat (name) (subs) (ty) (sp) -> codex-emit-tuple-pat-name-list subs 0 (list-length subs)
    is otherwise -> codex-emit-pattern p

  codex-emit-tuple-pat-name-list : List IRPat, Integer, Integer -> Text
  codex-emit-tuple-pat-name-list (subs) (i) (len) =
   if i >= len then ""
   else let sep = if i > 0 then ", " else ""
   in sep & codex-emit-tuple-pat-elem (list-at subs i) & codex-emit-tuple-pat-name-list subs (i + 1) len

  codex-emit-tuple-pat-elem : IRPat -> Text
  codex-emit-tuple-pat-elem (p) =
   when p
    is IrWildPat (sp) -> "_"
    is otherwise -> codex-emit-pattern p

  codex-emit-branches : List IRBranch, List Text, Integer, Integer -> Text
  codex-emit-branches (branches) (ctors) (indent) (i) =
   text-concat-list (codex-emit-branches-acc branches ctors indent i (list-length branches) [])

  codex-emit-branches-acc : List IRBranch, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-branches-acc (branches) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let b = list-at branches i
   in let body-text = codex-emit-expr (b.body) ctors (indent + 1)
   in let guard-text = codex-emit-guard-suffix (b.guard) ctors (indent + 1)
   in let group-end = find-group-end branches ctors indent body-text guard-text (b.alt-group) (i + 1) len
   in let pat-text = codex-emit-group-pats-tail branches (i + 1) group-end (codex-emit-pattern (b.pattern))
   in codex-emit-branches-acc branches ctors indent group-end len (list-push acc ("\n" & make-indent (indent + 1) & "is " & pat-text & guard-text & " -> " & body-text))

  codex-emit-guard-suffix : IRExpr, List Text, Integer -> Text
  codex-emit-guard-suffix (guard) (ctors) (indent) =
   when guard
    is IrBoolLit (v) (sp) -> if v then "" else " when False"
    is otherwise -> " when " & codex-emit-expr guard ctors indent

  find-group-end : List IRBranch, List Text, Integer, Text, Text, Integer, Integer, Integer -> Integer
  find-group-end (branches) (ctors) (indent) (body-text) (guard-text) (group) (i) (len) =
   if i >= len then i
   else if group < 0 then i
   else let b = list-at branches i
   in if b.alt-group /= group then i
   else let next-body = codex-emit-expr (b.body) ctors (indent + 1)
   in let next-guard = codex-emit-guard-suffix (b.guard) ctors (indent + 1)
   in if next-body == body-text & next-guard == guard-text
      then find-group-end branches ctors indent body-text guard-text group (i + 1) len
      else i

  codex-emit-group-pats-tail : List IRBranch, Integer, Integer, Text -> Text
  codex-emit-group-pats-tail (branches) (i) (stop) (acc) =
   if i >= stop then acc
   else let b = list-at branches i
   in codex-emit-group-pats-tail branches (i + 1) stop (acc & " | " & codex-emit-pattern (b.pattern))

  codex-emit-pattern : IRPat -> Text
  codex-emit-pattern (p) =
   when p
    is IrVarPat (name) (ty) (sp) -> name
    is IrLitPat (text) (ty) (sp) -> text
    is IrCtorPat (name) (subs) (ty) (sp) -> name & codex-emit-sub-patterns subs 0
    is IrWildPat (sp) -> "otherwise"
    is IrVecPat (subs) (ty) (sp) -> "Vector [" & codex-emit-vec-pat-elems subs 0 (list-length subs) & "]"

  codex-emit-vec-pat-elems : List IRPat, Integer, Integer -> Text
  codex-emit-vec-pat-elems (subs) (i) (len) =
   if i >= len then ""
   else let sep = if i > 0 then ", " else ""
   in sep & codex-emit-pattern (list-at subs i) & codex-emit-vec-pat-elems subs (i + 1) len

  codex-emit-sub-patterns : List IRPat, Integer -> Text
  codex-emit-sub-patterns (subs) (i) =
   text-concat-list (for p in subs -> " (" & codex-emit-pattern p & ")")

Section: Act Blocks
  codex-emit-act : List IRActStmt, List Text, Integer -> Text
  codex-emit-act (stmts) (ctors) (indent) =
   "act" & codex-emit-act-stmts stmts ctors indent 0 & "\n" & make-indent indent & "end"

  codex-emit-act-stmts : List IRActStmt, List Text, Integer, Integer -> Text
  codex-emit-act-stmts (stmts) (ctors) (indent) (i) =
   text-concat-list (codex-emit-act-stmts-acc stmts ctors indent i (list-length stmts) [])

  codex-emit-act-stmts-acc : List IRActStmt, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-act-stmts-acc (stmts) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let s = list-at stmts i
   in codex-emit-act-stmts-acc stmts ctors indent (i + 1) len (list-push acc ("\n" & make-indent (indent + 1) & codex-emit-act-stmt s ctors (indent + 1)))

  codex-emit-act-stmt : IRActStmt, List Text, Integer -> Text
  codex-emit-act-stmt (s) (ctors) (indent) =
   when s
    is IrDoBind (name) (ty) (val) (sp) -> name & " <- " & codex-emit-expr val ctors indent
    is IrDoExec (e) (sp) -> codex-emit-expr e ctors indent

Section: Records
  codex-emit-record : Text, List IRFieldVal, List Text, Integer -> Text
  codex-emit-record (name) (fields) (ctors) (indent) =
   if list-length fields <= 1 then name & " {" & codex-emit-record-fields-inline fields ctors indent 0 & " }"
   else name & " {\n" & codex-emit-record-fields-multi fields ctors indent 0 & make-indent indent & "}"

  codex-emit-record-fields-inline : List IRFieldVal, List Text, Integer, Integer -> Text
  codex-emit-record-fields-inline (fields) (ctors) (indent) (i) =
   text-concat-list (codex-emit-record-fields-inline-acc fields ctors indent i (list-length fields) [])

  codex-emit-record-fields-inline-acc : List IRFieldVal, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-record-fields-inline-acc (fields) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let sep = if i > 0 then "," else ""
   in codex-emit-record-fields-inline-acc fields ctors indent (i + 1) len (list-push acc (sep & " " & f.name & " = " & codex-emit-expr (f.value) ctors indent))

  codex-emit-record-fields-multi : List IRFieldVal, List Text, Integer, Integer -> Text
  codex-emit-record-fields-multi (fields) (ctors) (indent) (i) =
   text-concat-list (codex-emit-record-fields-multi-acc fields ctors indent i (list-length fields) [])

  codex-emit-record-fields-multi-acc : List IRFieldVal, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-record-fields-multi-acc (fields) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let f = list-at fields i
   in let comma = if i < len - 1 then "," else ""
   in codex-emit-record-fields-multi-acc fields ctors indent (i + 1) len (list-push acc (make-indent (indent + 1) & f.name & " = " & codex-emit-expr (f.value) ctors (indent + 1) & comma & "\n"))

Section: Field Access
  codex-emit-field-access : IRExpr, Text, List Text, Integer -> Text
  codex-emit-field-access (rec) (field) (ctors) (indent) =
   when rec
    is IrName (n) (ty) (sp) -> n & "." & field
    is IrFieldAccess (r) (f) (ty) (sp) -> codex-emit-field-access r f ctors indent & "." & field
    is otherwise -> "(" & codex-emit-expr rec ctors indent & ")." & field

Section: Handle
  codex-emit-handle : Text, IRExpr, List IRHandleClause, List Text, Integer -> Text
  codex-emit-handle (eff) (body) (clauses) (ctors) (indent) =
   "handle " & codex-emit-expr body ctors indent & " with" & codex-emit-handle-clauses clauses ctors indent 0

  codex-emit-handle-clauses : List IRHandleClause, List Text, Integer, Integer -> Text
  codex-emit-handle-clauses (clauses) (ctors) (indent) (i) =
   text-concat-list (codex-emit-handle-clauses-acc clauses ctors indent i (list-length clauses) [])

  codex-emit-handle-clauses-acc : List IRHandleClause, List Text, Integer, Integer, Integer, List Text -> List Text
  codex-emit-handle-clauses-acc (clauses) (ctors) (indent) (i) (len) (acc) =
   if i == len then acc
   else let c = list-at clauses i
   in let param-text = codex-emit-clause-params (c.params) 0 (list-length (c.params))
   in let body-to-emit = unwrap-clause-lambda (c.body) (list-length (c.params))
   in codex-emit-handle-clauses-acc clauses ctors indent (i + 1) len (list-push acc ("\n" & make-indent (indent + 1) & c.op-name & param-text & " (" & c.resume-name & ") -> " & codex-emit-expr body-to-emit ctors (indent + 1)))

  codex-emit-clause-params : List Text, Integer, Integer -> Text
  codex-emit-clause-params (ps) (i) (len) =
   if i >= len then ""
   else " (" & list-at ps i & ")" & codex-emit-clause-params ps (i + 1) len

  unwrap-clause-lambda : IRExpr, Integer -> IRExpr
  unwrap-clause-lambda (e) (n) =
   if n == 0 then e
   else when e
    is IrLambda (ps) (b) (t) (s) -> b
    is otherwise -> e

Section: With-Timeout
  codex-emit-with-timeout : Integer, List Text, List Text, IRExpr, List Text, Integer -> Text
  codex-emit-with-timeout (secs) (effs) (scopes) (body) (ctors) (indent) =
   "with-timeout " & integer-to-text secs & " [" & codex-emit-effect-list effs 0 & "] " & codex-emit-expr body ctors indent

  codex-emit-effect-list : List Text, Integer -> Text
  codex-emit-effect-list (effs) (i) =
   if i == list-length effs then ""
   else if i > 0 then ", " & list-at effs i & codex-emit-effect-list effs (i + 1)
   else list-at effs i & codex-emit-effect-list effs (i + 1)

Section: Trying
  codex-emit-try : Integer, List IRActStmt, List IRActStmt, List IRActStmt, List Text, Integer -> Text
  codex-emit-try (max) (body) (fb) (fail) (ctors) (indent) =
   let body-text = codex-emit-act-stmts body ctors indent 0
   in let fb-text = if list-length fb > 0 then "\n" & make-indent indent & "falling back to" & codex-emit-act-stmts fb ctors indent 0 else ""
   in let fail-text = if list-length fail > 0 then "\n" & make-indent indent & "on failure" & codex-emit-act-stmts fail ctors indent 0 else ""
   in "trying " & integer-to-text max & " times" & body-text & fb-text & fail-text & "\n" & make-indent indent & "end"

Section: Utilities
  make-indent : Integer -> Text
  make-indent (n) =
   if n == 0 then ""
   else " " & make-indent (n - 1)

  escape-text : Text -> Text
  escape-text (s) =
   text-concat-list (escape-text-collect s 0 (text-length s) [])

  escape-text-collect : Text, Integer, Integer, List Text -> List Text
  escape-text-collect (s) (i) (len) (acc) =
   if i == len then acc
   else let c = char-code-at s i
   in escape-text-collect s (i + 1) len (list-push acc (escape-one-char c))

  escape-one-char : Integer -> Text
  escape-one-char (c) =
   if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "\"" 0 then "\\\""
   else if c == char-code-at "\n" 0 then "\\n"
   else char-to-text (code-to-char c)

  escape-char : Integer -> Text
  escape-char (c) =
   if c == char-code-at "\n" 0 then "\\n"
   else if c == char-code-at "\\" 0 then "\\\\"
   else if c == char-code-at "'" 0 then "\\'"
   else char-to-text (code-to-char c)

Section: Chapter Emission
  codex-grounds-seen : List Text, Text, Integer, Integer -> Boolean
  codex-grounds-seen (acc) (e) (i) (len) =
   if i == len then False
   else if list-at acc i == e then True
   else codex-grounds-seen acc e (i + 1) len

  codex-grounds-effects : List Text, Integer, Integer, List Text -> List Text
  codex-grounds-effects (gs) (i) (len) (acc) =
   if i == len then acc
   else let parts = text-split (list-at gs i) "\n"
   in let e = if list-length parts > 1 then list-at parts 1 else list-at gs i
   in codex-grounds-effects gs (i + 1) len (if codex-grounds-seen acc e 0 (list-length acc) then acc else list-push acc e)

  codex-grounds-join : List Text, Integer, Integer, List Text -> List Text
  codex-grounds-join (es) (i) (len) (acc) =
   if i == len then acc
   else let sep = if i > 0 then ", " else ""
   in codex-grounds-join es (i + 1) len (list-push acc (sep & list-at es i))

  codex-emit-grounds-line : List Text -> Text
  codex-emit-grounds-line (gs) =
   let effs = codex-grounds-effects gs 0 (list-length gs) []
   in if list-length effs == 0 then ""
      else "  grounds " & text-concat-list (codex-grounds-join effs 0 (list-length effs) []) & "\n"

  codex-emit-text-chapter : IRChapter, IRTextMeta, List ATypeDef, List RenameEntry -> Text
  codex-emit-text-chapter (m) (meta) (type-defs) (renames) =
   let header = if meta.chapter-title == "" then ""
      else "Chapter: " & meta.chapter-title & "\n"
        & codex-emit-grounds-line (meta.ground-effects) & "\n"
        & if meta.prose == "" then "" else " " & meta.prose & "\n\n"
   in header & codex-emit-type-defs type-defs 0 & codex-emit-all-defs (m.defs) (meta.ctor-names) 0 renames

  codex-emit-all-defs : List IRDef, List Text, Integer, List RenameEntry -> Text
  codex-emit-all-defs (defs) (ctor-names) (i) (renames) =
   text-concat-list (for d in defs -> codex-emit-def d ctor-names renames & "\n")

Page 1



Chapter: Parsmi--IR Text Parser

   1. ir-tokenize : Text -> List SExpToken
   2. build-tree : List SExpToken -> SExp
   3. walk-* : SExp -> {IRChapter, IRDef, IRExpr, ...}

Section: Token Types

  SExpToken =
   | TokOpen
   | TokClose
   | TokAtom (Text)
   | TokStr (Text)

Section: Tree Types

  SExp =
   | SAtom (Text)
   | SStr (Text)
   | SList (List SExp)

Section: Parse Result

  ParsedIR = record {
   chapter : IRChapter,
   meta : IRTextMeta,
   type-defs : List ATypeDef,
   effect-op-names : List Text
  }

Section: Tokenize

 Every recursion here is a SELF call, and that is load-bearing: the
 emitter turns only self tail calls into jumps (is-self-call gates the
 TCO), so a mutually tail-recursive loop pays one stack frame per hop.
 This tokenizer used to hop ir-tokenize-loop -> tokenize-atom ->
 ir-tokenize-loop per token and ir-scan-string-body <-> scan-string-escape
 per escaped character, which is one frame per token of input: on a
 48 MB IR payload (ui-orchestrator-test, 2026-07-28) the plug VM
 double-faulted with the stack exhausted inside tokenize-atom. The
 helpers now RETURN to the one loop instead of continuing it, and the
 loop alone recurses.

  ir-tokenize : Text -> List SExpToken
  ir-tokenize (s) = ir-tokenize-loop s 0 (text-length s) []

  ir-tokenize-loop : Text, Integer, Integer, List SExpToken -> List SExpToken
  ir-tokenize-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at s i
   in if is-sexp-space c then ir-tokenize-loop s (i + 1) len acc
   else if c == char-code-at "(" 0 then ir-tokenize-loop s (i + 1) len (list-push acc TokOpen)
   else if c == char-code-at ")" 0 then ir-tokenize-loop s (i + 1) len (list-push acc TokClose)
   else if c == char-code-at "\"" 0 then
    let r = ir-scan-string-body s (i + 1) len []
    in ir-tokenize-loop s (r.next) len (list-push acc (TokStr (r.value)))
   else
    let stop = scan-atom-end s i len
    in ir-tokenize-loop s stop len (list-push acc (TokAtom (substring s i (stop - i))))

  is-sexp-space : Integer -> Boolean
  is-sexp-space (c) =
   if c == char-code-at " " 0 then True
   else if c == char-code-at "\n" 0 then True
   else False

  is-atom-char : Integer -> Boolean
  is-atom-char (c) =
   if c == char-code-at "(" 0 then False
   else if c == char-code-at ")" 0 then False
   else if c == char-code-at "\"" 0 then False
   else if is-sexp-space c then False
   else True

  scan-atom-end : Text, Integer, Integer -> Integer
  scan-atom-end (s) (i) (len) =
   if i >= len then i
   else if is-atom-char (char-code-at s i) then scan-atom-end s (i + 1) len
   else i

  StringScanResult = record {
   value : Text,
   next : Integer
  }

 The escape arm advances TWO characters inside the one self loop
 rather than handing off to a second function: a hop per escaped
 character is a frame per escaped character (see the tokenizer prose).

  ir-scan-string-body : Text, Integer, Integer, List Text -> StringScanResult
  ir-scan-string-body (s) (i) (len) (acc) =
   if i >= len then StringScanResult { value = text-concat-list acc, next = i }
   else let c = char-code-at s i
   in if c == char-code-at "\"" 0 then StringScanResult { value = text-concat-list acc, next = i + 1 }
   else if c == char-code-at "\\" 0 then
    (if i + 1 >= len then StringScanResult { value = text-concat-list acc, next = i + 1 }
     else ir-scan-string-body s (i + 2) len (list-push acc (unescape-char-text (char-code-at s (i + 1)))))
   else ir-scan-string-body s (i + 1) len (list-push acc (char-to-text (code-to-char c)))

  unescape-char-text : Integer -> Text
  unescape-char-text (c) =
   if c == char-code-at "\\" 0 then "\\"
   else if c == char-code-at "\"" 0 then "\""
   else if c == char-code-at "n" 0 then "\n"
   else char-to-text (code-to-char c)

Section: Tree Builder

  TreeResult = record {
   tree : SExp,
   next : Integer
  }

  build-tree : List SExpToken -> SExp
  build-tree (tokens) =
   let r = parse-sexp tokens 0 (list-length tokens)
   in r.tree

  parse-sexp : List SExpToken, Integer, Integer -> TreeResult
  parse-sexp (tokens) (i) (len) =
   if i >= len then TreeResult { tree = SAtom "", next = i }
   else let t = list-at tokens i
   in when t
    is TokOpen -> parse-list-body tokens (i + 1) len []
    is TokClose -> TreeResult { tree = SAtom "", next = i + 1 }
    is TokAtom (a) -> TreeResult { tree = SAtom a, next = i + 1 }
    is TokStr (s) -> TreeResult { tree = SStr s, next = i + 1 }

  parse-list-body : List SExpToken, Integer, Integer, List SExp -> TreeResult
  parse-list-body (tokens) (i) (len) (acc) =
   if i >= len then TreeResult { tree = SList acc, next = i }
   else let t = list-at tokens i
   in when t
    is TokClose -> TreeResult { tree = SList acc, next = i + 1 }
    is otherwise -> let r = parse-sexp tokens i len
     in parse-list-body tokens (r.next) len (list-push acc (r.tree))

Section: Tree Helpers

  sexp-atom : SExp -> Text
  sexp-atom (e) =
   when e
    is SAtom (a) -> a
    is otherwise -> ""

  sexp-str : SExp -> Text
  sexp-str (e) =
   when e
    is SStr (s) -> s
    is otherwise -> ""

  sexp-int : SExp -> Integer
  sexp-int (e) =
   when e
    is SAtom (a) -> sexp-atom-to-int a
    is otherwise -> 0

  sexp-atom-to-int : Text -> Integer
  sexp-atom-to-int (a) =
   if a == "i64-min" then i64-min else parse-int-text a

  sexp-list : SExp -> List SExp
  sexp-list (e) =
   when e
    is SList (xs) -> xs
    is otherwise -> []

  sexp-head : SExp -> Text
  sexp-head (e) =
   when e
    is SList (xs) -> if list-length xs == 0 then "" else sexp-atom (list-at xs 0)
    is SAtom (a) -> a
    is otherwise -> ""

  parse-int-text : Text -> Integer
  parse-int-text (s) =
   let len = text-length s
   in if len == 0 then 0
   else let first = char-code-at s 0
   in if first == char-code-at "-" 0 then 0 - parse-int-loop s 1 len 0
   else parse-int-loop s 0 len 0

  parse-int-loop : Text, Integer, Integer, Integer -> Integer
  parse-int-loop (s) (i) (len) (acc) =
   if i >= len then acc
   else let c = char-code-at s i
   in let zero = char-code-at "0" 0
   in let nine = char-code-at "9" 0
   in if c >= zero then if c <= nine then parse-int-loop s (i + 1) len (acc * 10 + (c - zero))
                                       else acc
   else acc

Section: OverflowMode + BinaryOp

  parse-ov-mode : Text -> OverflowMode
  parse-ov-mode (a) =
   if a == "ov-error" then OvError
   else if a == "ov-wrap" then OvWrapping
   else if a == "ov-clamp" then OvClamping
   else OvError

  parse-bin-op : Text -> IRBinaryOp
  parse-bin-op (a) =
   if a == "add-int" then IrAddInt
   else if a == "sub-int" then IrSubInt
   else if a == "mul-int" then IrMulInt
   else if a == "mul-int-wrapping" then IrMulInt
   else if a == "add-int-wrapping" then IrAddInt
   else if a == "sub-int-wrapping" then IrSubInt
   else if a == "div-int" then IrDivInt
   else if a == "rem-int" then IrRemInt
   else if a == "pow-int" then IrPowInt
   else if a == "add-num" then IrAddNum
   else if a == "sub-num" then IrSubNum
   else if a == "mul-num" then IrMulNum
   else if a == "div-num" then IrDivNum
   else if a == "add-real-approx" then IrAddRealApprox
   else if a == "sub-real-approx" then IrSubRealApprox
   else if a == "mul-real-approx" then IrMulRealApprox
   else if a == "div-real-approx" then IrDivRealApprox
   else if a == "add-real-trapping" then IrAddRealTrapping
   else if a == "sub-real-trapping" then IrSubRealTrapping
   else if a == "mul-real-trapping" then IrMulRealTrapping
   else if a == "div-real-trapping" then IrDivRealTrapping
   else if a == "add-real-saturating" then IrAddRealSaturating
   else if a == "sub-real-saturating" then IrSubRealSaturating
   else if a == "mul-real-saturating" then IrMulRealSaturating
   else if a == "div-real-saturating" then IrDivRealSaturating
   else if a == "add-vec" then IrAddVec
   else if a == "sub-vec" then IrSubVec
   else if a == "mul-vec" then IrMulVec
   else if a == "div-vec" then IrDivVec
   else if a == "lt-vec" then IrLtVec
   else if a == "gt-vec" then IrGtVec
   else if a == "le-vec" then IrLtEqVec
   else if a == "ge-vec" then IrGtEqVec
   else if a == "eq" then IrEq
   else if a == "ne" then IrNotEq
   else if a == "lt" then IrLt
   else if a == "gt" then IrGt
   else if a == "le" then IrLtEq
   else if a == "ge" then IrGtEq
   else if a == "and" then IrAnd
   else if a == "or" then IrOr
   else if a == "append-text" then IrAppendText
   else if a == "append-list" then IrAppendList
   else if a == "cons-list" then IrConsList
   else if a == "approx-eq" then IrApproxEq
   else if a == "approx-eq-exact" then IrApproxEqExact
   else if a == "add-vec" then IrAddVec
   else if a == "sub-vec" then IrSubVec
   else if a == "mul-vec" then IrMulVec
   else if a == "div-vec" then IrDivVec
   else IrAddInt

Section: CodexType

  ir-parse-type : SExp -> CodexType
  ir-parse-type (e) =
   when e
    is SAtom (a) -> ir-parse-type-atom a
    is SList (xs) -> ir-parse-type-list xs
    is otherwise -> ErrorTy

  ir-parse-type-atom : Text -> CodexType
  ir-parse-type-atom (a) =
   if a == "int-default" then int-ty-default
   else if a == "real" then real-f64
   else if a == "real-approx" then real-f32
   else if a == "real-trapping" then real-f64-trapping
   else if a == "real-saturating" then real-f64-saturating
   else if a == "real-approx-trapping" then RealTy RwF32 RmTrapping
   else if a == "real-approx-saturating" then RealTy RwF32 RmSaturating
   else if a == "text" then TextTy
   else if a == "boolean" then BooleanTy
   else if a == "char" then CharTy
   else if a == "void" then VoidTy
   else if a == "nothing" then NothingTy
   else if a == "error" then ErrorTy
   else if a == "noexpect" then NoExpectTy
   else if a == "proof" then ProofTy
   else ErrorTy

  ir-parse-type-list : List SExp -> CodexType
  ir-parse-type-list (xs) =
   if list-length xs == 0 then ErrorTy
   else let head = sexp-atom (list-at xs 0)
   in if head == "int" then ir-parse-type-int xs
   else if head == "fn" then ir-parse-type-fn xs
   else if head == "list" then ListTy (ir-parse-type (list-at xs 1))
   else if head == "llist" then LinkedListTy (ir-parse-type (list-at xs 1))
   else if head == "tvar" then TypeVar (__narrow (sexp-int (list-at xs 1)))
   else if head == "forall" then ForAllTy (__narrow (sexp-int (list-at xs 1))) (ir-parse-type (list-at xs 2))
   else if head == "sum" then ir-parse-type-sum xs
   else if head == "record-ty" then ir-parse-type-record xs
   else if head == "ctd" then ir-parse-type-ctd xs
   else if head == "effectful" then ir-parse-type-effectful xs
   else if head == "vector" then VectorTy (sexp-int (list-at xs 1)) (ir-parse-type (list-at xs 2))
   else if head == "unit" then UnitTy (make-name (sexp-str (list-at xs 1))) (ir-parse-type (list-at xs 2))
   else if head == "vector-mask" then VectorMaskTy (sexp-int (list-at xs 1))
   else if head == "propeq" then PropEqTy (ir-parse-type (list-at xs 1)) (ir-parse-type (list-at xs 2))
   else if head == "tycon" then TypeCon (make-name (sexp-str (list-at xs 1)))
   else if head == "tyapply" then TypeApply (ir-parse-type (list-at xs 1)) (ir-parse-type (list-at xs 2))
   else ErrorTy

  ir-parse-type-fn : List SExp -> CodexType
  ir-parse-type-fn (xs) =
   let row = if list-length xs > 3 then parse-row (list-at xs 3) else empty-row
   in FunTy (ir-parse-type (list-at xs 1)) row (ir-parse-type (list-at xs 2))

  parse-row : SExp -> EffectRow
  parse-row (e) =
   let xs = sexp-list e
   in if list-length xs < 4 then empty-row
   else let labels = parse-row-labels (sexp-list (list-at xs 1)) 1 []
   in EffectRow { labels = labels, tail-name = sexp-str (list-at xs 2), tail-id = __narrow (sexp-int (list-at xs 3)) }

  parse-row-labels : List SExp, Integer, List EffectLabel -> List EffectLabel
  parse-row-labels (xs) (i) (acc) =
   if i >= list-length xs then acc
   else let l = sexp-list (list-at xs i)
   in let lab = EffectLabel { name = make-name (sexp-str (list-at l 1)), scope = sexp-str (list-at l 2) }
   in parse-row-labels xs (i + 1) (list-push acc lab)

  ir-parse-type-int : List SExp -> CodexType
  ir-parse-type-int (xs) =
   IntegerTy (sexp-int (list-at xs 1)) (sexp-int (list-at xs 2)) (parse-ov-mode (sexp-atom (list-at xs 3)))

  ir-parse-type-sum : List SExp -> CodexType
  ir-parse-type-sum (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = ir-parse-type-args (sexp-list (list-at xs 2))
   in let ctors = if list-length xs > 3 then parse-sum-ctors (sexp-list (list-at xs 3)) else []
   in SumTy name args ctors

  ir-parse-type-record : List SExp -> CodexType
  ir-parse-type-record (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = ir-parse-type-args (sexp-list (list-at xs 2))
   in let fields = if list-length xs > 3 then parse-record-fields (sexp-list (list-at xs 3)) else []
   in RecordTy name args fields

  ir-parse-type-ctd : List SExp -> CodexType
  ir-parse-type-ctd (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let args = ir-parse-type-args (sexp-list (list-at xs 2))
   in ConstructedTy name args

  ir-parse-type-effectful : List SExp -> CodexType
  ir-parse-type-effectful (xs) =
   let effs = parse-name-list (sexp-list (list-at xs 1))
   in let scopes = parse-text-list (sexp-list (list-at xs 2))
   in let ret = ir-parse-type (list-at xs 3)
   in EffectfulTy effs scopes ret

  ir-parse-type-args : List SExp -> List CodexType
  ir-parse-type-args (xs) = ir-parse-type-args-loop xs 1 (list-length xs) []

  ir-parse-type-args-loop : List SExp, Integer, Integer, List CodexType -> List CodexType
  ir-parse-type-args-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else ir-parse-type-args-loop xs (i + 1) len (list-push acc (ir-parse-type (list-at xs i)))

  parse-sum-ctors : List SExp -> List SumCtor
  parse-sum-ctors (xs) = parse-sum-ctors-loop xs 1 (list-length xs) []

  parse-sum-ctors-loop : List SExp, Integer, Integer, List SumCtor -> List SumCtor
  parse-sum-ctors-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let fields = ir-parse-type-args (sexp-list (list-at inner 2))
   in parse-sum-ctors-loop xs (i + 1) len (list-push acc (SumCtor { name = name, fields = fields, return-type = [] }))

  parse-record-fields : List SExp -> List RecordField
  parse-record-fields (xs) = ir-parse-record-fields-loop xs 1 (list-length xs) []

  ir-parse-record-fields-loop : List SExp, Integer, Integer, List RecordField -> List RecordField
  ir-parse-record-fields-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let ty = ir-parse-type (list-at inner 2)
   in ir-parse-record-fields-loop xs (i + 1) len (list-push acc (RecordField { name = name, type-val = ty }))

Section: Type Def Resolution

 The recovery is exact for an explicitly bounded integer and an
 approximation otherwise: a bare `Integer` and an unrecognised form both
 answer the default width, so a consumer can tell a declared band from a
 default one only by the band being present.

  is-real-atom-name : Text -> Boolean
  is-real-atom-name (n) =
   n == "real" | n == "real-approx" | n == "real-trapping" | n == "real-saturating"
   | n == "real-approx-trapping" | n == "real-approx-saturating"

  atype-to-codex-type : ATypeExpr -> CodexType
  atype-to-codex-type (at) =
   when at
    is ABoundedIntType (base) (lo) (hi) (mode) (sp) -> IntegerTy lo hi mode
    is ALinearType (inner) (sp) -> atype-to-codex-type inner
    is AAppType (ctor) (args) (sp) -> atype-app-to-codex-type ctor args
    is ANamedType (n) (sp) ->
     if is-real-atom-name (n.value) then ir-parse-type-atom (n.value)
     else if n.value == "Boolean" then BooleanTy
     else if n.value == "Text" then TextTy
     else if n.value == "Integer" then int-ty-default
     else if n.value == "Real" then real-f64
     else if n.value == "Char" then CharTy
     else if n.value == "Nothing" then NothingTy
     else if n.value == "Proof" then ProofTy
     else ConstructedTy n []
    is otherwise -> int-ty-default

 A qualifier on a Real is an application ARGUMENT in the surface syntax, not a
 distinct node: `Real approximate` parses to `a-app (a-named "Real") (args
 (a-named "approximate"))`, and the words are interpreted only by
 `resolve-real-quals` in the type checker. This is the mirror of that
 interpretation, and it has to exist because the surface form is ambiguous on
 its own -- `approximate` is spelled exactly like a type variable, and the
 declaration even carries it as one. Keep the arms below in step with
 `TypeChecker.codex` `resolve-applied-type` / `resolve-real-quals`; the two
 are a pair, and drift between them is a silent wrong type rather than an error.

  atype-app-to-codex-type : ATypeExpr, List ATypeExpr -> CodexType
  atype-app-to-codex-type (ctor) (args) =
   when ctor
    is ANamedType (name) (s) ->
     if name.value == "List" then
      (if list-length args == 1 then ListTy (atype-to-codex-type (list-at args 0)) else ListTy ErrorTy)
     else if name.value == "LinkedList" then
      (if list-length args == 1 then LinkedListTy (atype-to-codex-type (list-at args 0)) else LinkedListTy ErrorTy)
     else if name.value == "Real" then atype-real-quals name args 0 RwF64 RmDefault True
     else if name.value == "Vector" then
      (if list-length args == 2 then VectorTy (atype-vector-len (list-at args 0)) (atype-to-codex-type (list-at args 1))
       else VectorTy 2 ErrorTy)
     else ConstructedTy name (atypes-to-codex-types args 0 [])
    is AAppType (inner-ctor) (inner-args) (s) -> atype-app-to-codex-type inner-ctor (inner-args & args)
    is otherwise -> atype-to-codex-type ctor

  atype-real-quals : Name, List ATypeExpr, Integer, RealWidth, RealMode, Boolean -> CodexType
  atype-real-quals (name) (args) (i) (w) (m) (all-quals) =
   if list-length args == 0 then real-f64
   else if i >= list-length args then
    (if all-quals then RealTy w m else ConstructedTy name (atypes-to-codex-types args 0 []))
   else let word = when (list-at args i) is ANamedType (qt) (qs) -> qt.value is otherwise -> ""
    in if word == "approximate" then atype-real-quals name args (i + 1) RwF32 m all-quals
    else if word == "trapping" then atype-real-quals name args (i + 1) w RmTrapping all-quals
    else if word == "saturating" then atype-real-quals name args (i + 1) w RmSaturating all-quals
    else atype-real-quals name args (i + 1) w m False

  atype-vector-len : ATypeExpr -> Integer
  atype-vector-len (a) =
   when a
    is ANamedType (n) (s) -> text-to-integer (n.value)
    is otherwise -> 0

  atypes-to-codex-types : List ATypeExpr, Integer, List CodexType -> List CodexType
  atypes-to-codex-types (as) (i) (acc) =
   if i >= list-length as then acc
   else atypes-to-codex-types as (i + 1) (list-push acc (atype-to-codex-type (list-at as i)))

  arec-fields-to-rfields : List ARecordFieldDef, Integer, List RecordField -> List RecordField
  arec-fields-to-rfields (afs) (i) (acc) =
   if i >= list-length afs then acc
   else let af = list-at afs i
   in arec-fields-to-rfields afs (i + 1) (list-push acc (RecordField { name = af.name, type-val = atype-to-codex-type (af.type-expr) }))

  record-fields-by-name : List ATypeDef, Text, Integer -> List RecordField
  record-fields-by-name (tds) (name) (i) =
   if i >= list-length tds then []
   else when list-at tds i
    is ARecordTypeDef (dn) (tparams) (afields) (recmut) (sp) ->
     if dn.value == name then arec-fields-to-rfields afields 0 []
     else record-fields-by-name tds name (i + 1)
    is otherwise -> record-fields-by-name tds name (i + 1)

  avar-ctors-to-sumctors : List AVariantCtorDef, Integer, List SumCtor -> List SumCtor
  avar-ctors-to-sumctors (acs) (i) (acc) =
   if i >= list-length acs then acc
   else let ac = list-at acs i
   in avar-ctors-to-sumctors acs (i + 1) (list-push acc (SumCtor { name = ac.name, fields = atypes-to-codex-types (ac.fields) 0 [], return-type = [] }))

  sum-ctors-by-name : List ATypeDef, Text, Integer -> List SumCtor
  sum-ctors-by-name (tds) (name) (i) =
   if i >= list-length tds then []
   else when list-at tds i
    is AVariantTypeDef (tn) (tps) (ctors) (sp) ->
     if tn.value == name then avar-ctors-to-sumctors ctors 0 []
     else sum-ctors-by-name tds name (i + 1)
    is otherwise -> sum-ctors-by-name tds name (i + 1)

  parse-text-list : List SExp -> List Text
  parse-text-list (xs) = parse-text-list-loop xs 1 (list-length xs) []

  parse-text-list-loop : List SExp, Integer, Integer, List Text -> List Text
  parse-text-list-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-text-list-loop xs (i + 1) len (list-push acc (sexp-str (list-at xs i)))

  parse-name-list : List SExp -> List Name
  parse-name-list (xs) = parse-name-list-loop xs 1 (list-length xs) []

  parse-name-list-loop : List SExp, Integer, Integer, List Name -> List Name
  parse-name-list-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-name-list-loop xs (i + 1) len (list-push acc (make-name (sexp-str (list-at xs i))))

Section: Prose Blocks and Annotations

  parse-prose-blocks : List SExp -> List ProseBlock
  parse-prose-blocks (xs) = parse-prose-blocks-loop xs 1 (list-length xs) []

  parse-prose-blocks-loop : List SExp, Integer, Integer, List ProseBlock -> List ProseBlock
  parse-prose-blocks-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-prose-blocks-loop xs (i + 1) len (list-push acc (parse-prose-block (list-at xs i)))

  parse-prose-block : SExp -> ProseBlock
  parse-prose-block (e) =
   let ys = sexp-list e
   in if list-length ys < 3 then ProseBlock { text = "", transition = PtNone, template = PtNoTemplate, anchor = "", offset = 0 }
   else ProseBlock {
     text = sexp-str (list-at ys 2),
     transition = PtNone,
     template = PtNoTemplate,
     anchor = sexp-str (list-at ys 1),
     offset = 0
    }

  parse-annotations : List SExp -> List AnnotationNode
  parse-annotations (xs) = parse-annotations-loop xs 1 (list-length xs) []

  parse-annotations-loop : List SExp, Integer, Integer, List AnnotationNode -> List AnnotationNode
  parse-annotations-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-annotations-loop xs (i + 1) len (list-push acc (parse-annotation (list-at xs i)))

  parse-annotation : SExp -> AnnotationNode
  parse-annotation (e) =
   let ys = sexp-list e
   in if list-length ys < 4 then AnnotationNode { kind = "", target = "", body = "" }
   else AnnotationNode {
     kind = sexp-str (list-at ys 1),
     target = sexp-str (list-at ys 2),
     body = sexp-str (list-at ys 3)
    }

Section: ATypeExpr

  parse-atype-expr : SExp -> ATypeExpr
  parse-atype-expr (e) =
   let xs = sexp-list e
   in if list-length xs == 0 then ANamedType (make-name "Unknown") synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in if head == "a-named" then ANamedType (make-name (sexp-str (list-at xs 1))) synthetic-span
   else if head == "a-fun" then AFunType (parse-atype-expr (list-at xs 1)) (parse-atype-expr (list-at xs 2)) synthetic-span
   else if head == "a-app" then AAppType (parse-atype-expr (list-at xs 1)) (parse-atype-args (sexp-list (list-at xs 2))) synthetic-span
   else if head == "a-eff" then parse-atype-eff xs
   else if head == "a-bounded" then ABoundedIntType (parse-atype-expr (list-at xs 1)) (sexp-int (list-at xs 2)) (sexp-int (list-at xs 3)) (parse-ov-mode (sexp-atom (list-at xs 4))) synthetic-span
   else if head == "a-linear" then ALinearType (parse-atype-expr (list-at xs 1)) synthetic-span
   else if head == "a-propeq" then APropEqType (parse-atype-expr (list-at xs 1)) (parse-atype-expr (list-at xs 2)) synthetic-span
   else if head == "a-forall" then AForallType (make-name "") (ANamedType (make-name "Unknown") synthetic-span) (ANamedType (make-name "Unknown") synthetic-span) synthetic-span
   else ANamedType (make-name "Unknown") synthetic-span

  parse-atype-eff : List SExp -> ATypeExpr
  parse-atype-eff (xs) =
   let effs = parse-name-list (sexp-list (list-at xs 1))
   in let scopes = parse-text-list (sexp-list (list-at xs 2))
   in let r = parse-atype-expr (list-at xs 3)
   in AEffectType effs scopes [] r synthetic-span

  parse-atype-args : List SExp -> List ATypeExpr
  parse-atype-args (xs) = parse-atype-args-loop xs 1 (list-length xs) []

  parse-atype-args-loop : List SExp, Integer, Integer, List ATypeExpr -> List ATypeExpr
  parse-atype-args-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-atype-args-loop xs (i + 1) len (list-push acc (parse-atype-expr (list-at xs i)))

Section: ATypeDef

  parse-atype-defs : List SExp -> List ATypeDef
  parse-atype-defs (xs) = parse-atype-defs-loop xs 1 (list-length xs) []

  parse-atype-defs-loop : List SExp, Integer, Integer, List ATypeDef -> List ATypeDef
  parse-atype-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-atype-defs-loop xs (i + 1) len (list-push acc (parse-atype-def (list-at xs i)))

  parse-atype-def : SExp -> ATypeDef
  parse-atype-def (e) =
   let xs = sexp-list e
   in let head = sexp-atom (list-at xs 0)
   in if head == "rec-def" then parse-rec-def xs
   else if head == "var-def" then parse-var-def xs
   else if head == "unit-def" then AUnitTypeDef (make-name (sexp-str (list-at xs 1))) (parse-atype-expr (list-at xs 2)) synthetic-span
   else ARecordTypeDef (make-name "Unknown") [] [] False synthetic-span

  parse-rec-def : List SExp -> ATypeDef
  parse-rec-def (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let tparams = parse-name-list (sexp-list (list-at xs 2))
   in let fields = parse-rec-field-defs (sexp-list (list-at xs 3))
   in ARecordTypeDef name tparams fields (rec-def-mutable-p xs 4 (list-length xs)) synthetic-span

  rec-def-mutable-p : List SExp, Integer, Integer -> Boolean
  rec-def-mutable-p (xs) (i) (len) =
   if i >= len then False
   else if sexp-head (list-at xs i) == "mutable" then True
   else rec-def-mutable-p xs (i + 1) len

  parse-var-def : List SExp -> ATypeDef
  parse-var-def (xs) =
   let name = make-name (sexp-str (list-at xs 1))
   in let tparams = parse-name-list (sexp-list (list-at xs 2))
   in let ctors = parse-var-ctor-defs (sexp-list (list-at xs 3))
   in AVariantTypeDef name tparams ctors synthetic-span

  parse-rec-field-defs : List SExp -> List ARecordFieldDef
  parse-rec-field-defs (xs) = parse-rec-field-defs-loop xs 1 (list-length xs) []

  parse-rec-field-defs-loop : List SExp, Integer, Integer, List ARecordFieldDef -> List ARecordFieldDef
  parse-rec-field-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let te = parse-atype-expr (list-at inner 2)
   in parse-rec-field-defs-loop xs (i + 1) len (list-push acc (ARecordFieldDef { name = name, type-expr = te, span = synthetic-span }))

  parse-var-ctor-defs : List SExp -> List AVariantCtorDef
  parse-var-ctor-defs (xs) = parse-var-ctor-defs-loop xs 1 (list-length xs) []

  parse-var-ctor-defs-loop : List SExp, Integer, Integer, List AVariantCtorDef -> List AVariantCtorDef
  parse-var-ctor-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = make-name (sexp-str (list-at inner 1))
   in let fields = parse-atype-args (sexp-list (list-at inner 2))
   in parse-var-ctor-defs-loop xs (i + 1) len (list-push acc (AVariantCtorDef { name = name, fields = fields, return-type = [], span = synthetic-span }))

Section: IRPattern

  parse-pat : SExp -> IRPat
  parse-pat (e) =
   when e
    is SAtom (a) -> if a == "wild-pat" then IrWildPat synthetic-span
                    else IrWildPat synthetic-span
    is SList (xs) -> parse-pat-list xs
    is otherwise -> IrWildPat synthetic-span

  parse-pat-list : List SExp -> IRPat
  parse-pat-list (xs) =
   if list-length xs == 0 then IrWildPat synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in if head == "var-pat" then IrVarPat (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "lit-pat" then IrLitPat (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "ctor-pat" then parse-ctor-pat xs
   else if head == "vec-pat" then parse-vec-pat xs
   else IrWildPat synthetic-span

  parse-ctor-pat : List SExp -> IRPat
  parse-ctor-pat (xs) =
   let name = sexp-str (list-at xs 1)
   in let subs = parse-pat-subs (sexp-list (list-at xs 2))
   in let ty = ir-parse-type (list-at xs 3)
   in IrCtorPat name subs ty synthetic-span

  parse-vec-pat : List SExp -> IRPat
  parse-vec-pat (xs) =
   let lane-pats = parse-vec-lane-pats xs 1 (list-length xs) []
   in IrVecPat lane-pats ErrorTy synthetic-span

  parse-vec-lane-pats : List SExp, Integer, Integer, List IRPat -> List IRPat
  parse-vec-lane-pats (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-vec-lane-pats xs (i + 1) len (list-push acc (parse-pat (list-at xs i)))

  parse-pat-subs : List SExp -> List IRPat
  parse-pat-subs (xs) = parse-pat-subs-loop xs 1 (list-length xs) []

  parse-pat-subs-loop : List SExp, Integer, Integer, List IRPat -> List IRPat
  parse-pat-subs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-pat-subs-loop xs (i + 1) len (list-push acc (parse-pat (list-at xs i)))

Section: IRExpr

  ir-parse-expr : SExp -> IRExpr
  ir-parse-expr (e) =
   let xs = sexp-list e
   in if list-length xs == 0 then IrError "empty-expr" ErrorTy synthetic-span
   else let head = sexp-atom (list-at xs 0)
   in dispatch-expr head xs

  dispatch-expr : Text, List SExp -> IRExpr
  dispatch-expr (head) (xs) =
   if head == "int-lit" then IrIntLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "num-lit" then IrNumLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "text-lit" then IrTextLit (sexp-str (list-at xs 1)) synthetic-span
   else if head == "bool-lit" then IrBoolLit (sexp-atom (list-at xs 1) == "true") synthetic-span
   else if head == "char-lit" then IrCharLit (sexp-int (list-at xs 1)) synthetic-span
   else if head == "name" then IrName (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "binary" then ir-parse-expr-binary xs
   else if head == "negate" then IrNegate (ir-parse-expr (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "if" then IrIf (ir-parse-expr (list-at xs 1)) (ir-parse-expr (list-at xs 2)) (ir-parse-expr (list-at xs 3)) (ir-parse-type (list-at xs 4)) synthetic-span
   else if head == "let" then IrLet (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) (ir-parse-expr (list-at xs 3)) (ir-parse-expr (list-at xs 4)) synthetic-span
   else if head == "apply" then IrApply (ir-parse-expr (list-at xs 1)) (ir-parse-expr (list-at xs 2)) (ir-parse-type (list-at xs 3)) synthetic-span
   else if head == "lambda" then ir-parse-expr-lambda xs
   else if head == "list-expr" then ir-parse-expr-list xs
   else if head == "match" then ir-parse-expr-match xs
   else if head == "act" then ir-parse-expr-act xs
   else if head == "handle" then ir-parse-expr-handle xs
   else if head == "with-timeout" then ir-parse-expr-timeout xs
   else if head == "record" then ir-parse-expr-record xs
   else if head == "field-access" then IrFieldAccess (ir-parse-expr (list-at xs 1)) (sexp-str (list-at xs 2)) (ir-parse-type (list-at xs 3)) synthetic-span
   else if head == "field-store" then IrFieldStore (ir-parse-expr (list-at xs 1)) (sexp-str (list-at xs 2)) (ir-parse-expr (list-at xs 3)) (ir-parse-type (list-at xs 4)) synthetic-span
   else if head == "try" then ir-parse-expr-try xs
   else if head == "fork" then IrFork (ir-parse-expr (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "await" then IrAwait (ir-parse-expr (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else if head == "error" then IrError (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) synthetic-span
   else IrError "unknown-form" ErrorTy synthetic-span

  ir-parse-expr-binary : List SExp -> IRExpr
  ir-parse-expr-binary (xs) =
   IrBinary (parse-bin-op (sexp-atom (list-at xs 1))) (ir-parse-expr (list-at xs 2)) (ir-parse-expr (list-at xs 3)) (ir-parse-type (list-at xs 4)) synthetic-span

  ir-parse-expr-lambda : List SExp -> IRExpr
  ir-parse-expr-lambda (xs) =
   let params = parse-params (sexp-list (list-at xs 1))
   in let body = ir-parse-expr (list-at xs 2)
   in let ty = ir-parse-type (list-at xs 3)
   in IrLambda params body ty synthetic-span

  ir-parse-expr-list : List SExp -> IRExpr
  ir-parse-expr-list (xs) =
   let elems = ir-parse-expr-elems (sexp-list (list-at xs 1))
   in let ty = ir-parse-type (list-at xs 2)
   in IrList elems ty synthetic-span

  ir-parse-expr-elems : List SExp -> List IRExpr
  ir-parse-expr-elems (xs) = ir-parse-expr-elems-loop xs 1 (list-length xs) []

  ir-parse-expr-elems-loop : List SExp, Integer, Integer, List IRExpr -> List IRExpr
  ir-parse-expr-elems-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else ir-parse-expr-elems-loop xs (i + 1) len (list-push acc (ir-parse-expr (list-at xs i)))

  ir-parse-expr-match : List SExp -> IRExpr
  ir-parse-expr-match (xs) =
   let scrut = ir-parse-expr (list-at xs 1)
   in let branches = parse-branches (sexp-list (list-at xs 2))
   in let ty = ir-parse-type (list-at xs 3)
   in IrMatch scrut branches ty synthetic-span

  parse-branches : List SExp -> List IRBranch
  parse-branches (xs) = parse-branches-loop xs 1 (list-length xs) []

  parse-branches-loop : List SExp, Integer, Integer, List IRBranch -> List IRBranch
  parse-branches-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let pat = parse-pat (list-at inner 1)
   in let body = ir-parse-expr (list-at inner 2)
   in let guard = if list-length inner > 3 then ir-parse-expr (list-at inner 3) else IrBoolLit True synthetic-span
   in parse-branches-loop xs (i + 1) len (list-push acc (IRBranch { pattern = pat, body = body, guard = guard, span = synthetic-span, alt-group = 0 }))

  ir-parse-expr-act : List SExp -> IRExpr
  ir-parse-expr-act (xs) =
   let stmts = ir-parse-act-stmts (sexp-list (list-at xs 1))
   in let ty = ir-parse-type (list-at xs 2)
   in IrAct stmts ty synthetic-span

  ir-parse-act-stmts : List SExp -> List IRActStmt
  ir-parse-act-stmts (xs) = ir-parse-act-stmts-loop xs 1 (list-length xs) []

  ir-parse-act-stmts-loop : List SExp, Integer, Integer, List IRActStmt -> List IRActStmt
  ir-parse-act-stmts-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else ir-parse-act-stmts-loop xs (i + 1) len (list-push acc (parse-act-stmt (list-at xs i)))

  parse-act-stmt : SExp -> IRActStmt
  parse-act-stmt (e) =
   let xs = sexp-list e
   in let head = sexp-atom (list-at xs 0)
   in if head == "do-bind" then IrDoBind (sexp-str (list-at xs 1)) (ir-parse-type (list-at xs 2)) (ir-parse-expr (list-at xs 3)) synthetic-span
   else if head == "do-exec" then IrDoExec (ir-parse-expr (list-at xs 1)) synthetic-span
   else IrDoExec (IrError "bad-stmt" ErrorTy synthetic-span) synthetic-span

  ir-parse-expr-handle : List SExp -> IRExpr
  ir-parse-expr-handle (xs) =
   let eff = sexp-str (list-at xs 1)
   in let body = ir-parse-expr (list-at xs 2)
   in let clauses = ir-parse-handle-clauses (sexp-list (list-at xs 3))
   in let ty = ir-parse-type (list-at xs 4)
   in IrHandle eff body clauses ty synthetic-span

  ir-parse-handle-clauses : List SExp -> List IRHandleClause
  ir-parse-handle-clauses (xs) = ir-parse-handle-clauses-loop xs 1 (list-length xs) []

  ir-parse-handle-clauses-loop : List SExp, Integer, Integer, List IRHandleClause -> List IRHandleClause
  ir-parse-handle-clauses-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let op = sexp-str (list-at inner 1)
   in let params = parse-text-list (sexp-list (list-at inner 2))
   in let resume = sexp-str (list-at inner 3)
   in let body = ir-parse-expr (list-at inner 4)
   in ir-parse-handle-clauses-loop xs (i + 1) len (list-push acc (IRHandleClause { op-name = op, params = params, resume-name = resume, body = body, span = synthetic-span }))

  ir-parse-expr-timeout : List SExp -> IRExpr
  ir-parse-expr-timeout (xs) =
   let secs = sexp-int (list-at xs 1)
   in let effs = parse-text-list (sexp-list (list-at xs 2))
   in let scopes = parse-text-list (sexp-list (list-at xs 3))
   in let body = ir-parse-expr (list-at xs 4)
   in let ty = ir-parse-type (list-at xs 5)
   in IrWithTimeout secs effs scopes body ty synthetic-span

  ir-parse-expr-record : List SExp -> IRExpr
  ir-parse-expr-record (xs) =
   let name = sexp-str (list-at xs 1)
   in let fields = parse-field-vals (sexp-list (list-at xs 2))
   in let ty = ir-parse-type (list-at xs 3)
   in IrRecord name fields ty synthetic-span

  ir-parse-expr-try : List SExp -> IRExpr
  ir-parse-expr-try (xs) =
   let max = sexp-int (list-at xs 1)
   in let body = ir-parse-act-stmts (sexp-list (list-at xs 2))
   in let fb = ir-parse-act-stmts (sexp-list (list-at xs 3))
   in let fail = ir-parse-act-stmts (sexp-list (list-at xs 4))
   in let ty = ir-parse-type (list-at xs 5)
   in IrTry max body fb fail ty synthetic-span

  parse-field-vals : List SExp -> List IRFieldVal
  parse-field-vals (xs) = parse-field-vals-loop xs 1 (list-length xs) []

  parse-field-vals-loop : List SExp, Integer, Integer, List IRFieldVal -> List IRFieldVal
  parse-field-vals-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = sexp-str (list-at inner 1)
   in let val = ir-parse-expr (list-at inner 2)
   in parse-field-vals-loop xs (i + 1) len (list-push acc (IRFieldVal { name = name, value = val, span = synthetic-span }))

Section: Params

  parse-params : List SExp -> List IRParam
  parse-params (xs) = parse-params-loop xs 1 (list-length xs) []

  parse-params-loop : List SExp, Integer, Integer, List IRParam -> List IRParam
  parse-params-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else let inner = sexp-list (list-at xs i)
   in let name = sexp-str (list-at inner 1)
   in let ty = ir-parse-type (list-at inner 2)
   in parse-params-loop xs (i + 1) len (list-push acc (IRParam { name = name, type-val = ty, span = synthetic-span }))

Section: IRDef + Chapter

  parse-defs : List SExp -> List IRDef
  parse-defs (xs) = parse-defs-loop xs 1 (list-length xs) []

  parse-defs-loop : List SExp, Integer, Integer, List IRDef -> List IRDef
  parse-defs-loop (xs) (i) (len) (acc) =
   if i >= len then acc
   else parse-defs-loop xs (i + 1) len (list-push acc (parse-def (list-at xs i)))

  parse-def : SExp -> IRDef
  parse-def (e) =
   let xs = sexp-list e
   in let name = sexp-str (list-at xs 1)
   in let slug = sexp-str (list-at xs 2)
   in let params = parse-params (sexp-list (list-at xs 3))
   in let ty = ir-parse-type (list-at xs 4)
   in let body = ir-parse-expr (list-at xs 5)
   in let punct = if list-length xs > 6 then sexp-int (list-at xs 6) > 0 else False
   in let budget = if list-length xs > 7 then sexp-int (list-at xs 7) else 0
   in let uniq = if list-length xs > 8 then parse-unique (sexp-list (list-at xs 8)) 1 [] else []
   in IRDef { name = name, params = params, type-val = ty, body = body, chapter-slug = slug, is-punctual = punct, wcet-budget = budget, unique-params = uniq, span = synthetic-span }

  parse-unique : List SExp, Integer, List Text -> List Text
  parse-unique (xs) (i) (acc) =
   if i >= list-length xs then acc
   else parse-unique xs (i + 1) (list-push acc (sexp-str (list-at xs i)))

  parse-ir-chapter : Text -> ParsedIR
  parse-ir-chapter (s) =
   let tokens = ir-tokenize s
   in let tree = build-tree tokens
   in walk-chapter tree

  walk-chapter : SExp -> ParsedIR
  walk-chapter (e) =
   let xs = sexp-list e
   in let chap-name = make-name (sexp-str (list-at xs 1))
   in let title = walk-named-text xs "title"
   in let prose = walk-named-text xs "prose"
   in let sections = walk-named-strs xs "sections"
   in let ctors = walk-named-strs xs "ctors"
   in let eff-ops = walk-named-strs xs "eff-ops"
   in let ground-tbl = walk-named-strs xs "grounds"
   in let pblocks = parse-prose-blocks (walk-named-list xs "pblocks")
   in let anns = parse-annotations (walk-named-list xs "anns")
   in let type-defs = walk-named-list xs "type-defs"
   in let defs = walk-named-list xs "defs"
   in let parsed-tdefs = parse-atype-defs type-defs
   in let parsed-defs = parse-defs defs
   in let chapter = IRChapter {
       name = chap-name,
       defs = parsed-defs,
       effect-op-names = eff-ops,
       span = synthetic-span
      }
   in let meta = IRTextMeta {
       chapter-title = title,
       prose = prose,
       section-titles = sections,
       ctor-names = ctors,
       prose-blocks = pblocks,
       annotations = anns,
       ground-effects = ground-tbl
      }
   in ParsedIR { chapter = chapter, meta = meta, type-defs = parsed-tdefs, effect-op-names = eff-ops }

  walk-named-text : List SExp, Text -> Text
  walk-named-text (xs) (key) =
   let f = find-named-form xs key
   in if list-length f == 0 then "" else sexp-str (list-at f 1)

  walk-named-strs : List SExp, Text -> List Text
  walk-named-strs (xs) (key) =
   let f = find-named-form xs key
   in parse-text-list f

  walk-named-list : List SExp, Text -> List SExp
  walk-named-list (xs) (key) =
   find-named-form xs key

  find-named-form : List SExp, Text -> List SExp
  find-named-form (xs) (key) =
   find-named-form-loop xs key 0 (list-length xs)

  find-named-form-loop : List SExp, Text, Integer, Integer -> List SExp
  find-named-form-loop (xs) (key) (i) (len) =
   if i >= len then []
   else let inner = list-at xs i
   in when inner
    is SList (ys) -> if list-length ys == 0 then find-named-form-loop xs key (i + 1) len
                     else if sexp-atom (list-at ys 0) == key then ys
                     else find-named-form-loop xs key (i + 1) len
    is otherwise -> find-named-form-loop xs key (i + 1) len

