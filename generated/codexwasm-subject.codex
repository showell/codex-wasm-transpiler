  is-let-keyword : TokenKind -> Boolean
  is-let-keyword (k) =
   when k
    is LetKeyword -> True
    is otherwise -> False

  is-for-keyword : TokenKind -> Boolean
  is-for-keyword (k) =
   when k
    is ForKeyword -> True
    is otherwise -> False

  is-when-keyword : TokenKind -> Boolean
  is-when-keyword (k) =
   when k
    is WhenKeyword -> True
    is otherwise -> False

  is-induction-keyword : TokenKind -> Boolean
  is-induction-keyword (k) =
