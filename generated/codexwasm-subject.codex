Section: __list_insert_at

 The index bound here is LOOSER than `list-at`'s and `list-set-at`'s by
 one, in the opposite direction to the one `char-at` is tighter by.
 Inserting at index length is an append and is legal on every path: the
 shift loop starts at len-1 and stops as soon as it is below the index,
 so index == len shifts nothing and stores into the slot the length is
 about to grow into. `0 <= i` and `i <= len`.

  emit-list-insert-at-prologue : CodegenState -> HelpResult2
  emit-list-insert-at-prologue (st) =
    let st0 = record-func-offset st "__list_insert_at"
   in let st1 = st-append-code st0 (push-r reg-rbx)
   in let st2 = st-append-code st1 (push-r reg-r12)
   in let st3 = st-append-code st2 (push-r reg-r13)
   in let st4 = st-append-code st3 (push-r reg-r14)
   in let st5 = st-append-code st4 (mov-rr reg-rbx reg-rdi)
   in let st6 = st-append-code st5 (mov-rr reg-r12 reg-rsi)
   in let st7 = st-append-code st6 (mov-rr reg-r13 reg-rdx)
   in let st8 = st-append-code st7 (mov-load reg-r14 reg-rbx 0)
   in let trap = [15, 11]
   in let g1 = st-append-code st8 (cmp-ri reg-r12 0 & jcc cc-ge (list-length trap) & trap)
   in let g2 = st-append-code g1 (cmp-rr reg-r12 reg-r14 & jcc cc-le (list-length trap) & trap)
   in let st9 = st-append-code g2 (mov-load reg-rcx reg-rbx (-8))
   in let st10 = st-append-code st9 (cmp-rr reg-r14 reg-rcx)
   in let in-place-pos = st10.code-len
   in let st11 = st-append-code st10 (jcc cc-l 0)
   in let st12 = st-append-code st11 (mov-rr reg-rax reg-rcx)
   in let st13 = st-append-code st12 (add-ri reg-rax 1)
   in let st14 = st-append-code st13 (shl-ri reg-rax 3)
   in let st15 = st-append-code st14 (add-rr reg-rax reg-rbx)
   in let st16 = st-append-code st15 (cmp-rr reg-rax reg-r10)
   in let path3-pos = st16.code-len
   in let st17 = st-append-code st16 (jcc cc-ne 0)
   in HelpResult2 {
    cg = st17,
    p1 = in-place-pos,
    p2 = path3-pos
   }

