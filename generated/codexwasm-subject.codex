Section: __text_to_double

 Ten to the power k is exact as a double for k up to 22, so accumulating it
 by repeated multiplication and dividing once is correctly rounded over the
 whole range a literal can usefully name. Beyond 22 the divisor is itself
 inexact, but that is still one rounding against k of them.

 The numerator is a separate and untouched limit: `cvtsi2sd` of the digit
 integer is exact only below 2^53, so a literal carrying more than about
 sixteen significant digits loses precision before the scaling ever runs.

  emit-text-to-double-setup : CodegenState -> HelpResult1
  emit-text-to-double-setup (st) =
    let st0 = record-func-offset st "__text_to_double"
   in let st1 = st-append-code st0 (mov-load reg-rcx reg-rdi 0)
   in let st2 = st-append-code st1 (lea reg-rdi reg-rdi 8)
   in let st3 = st-append-code st2 (li reg-rax 0)
   in let st4 = st-append-code st3 (li reg-r11 0)
   in let st5 = st-append-code st4 (li reg-rsi 0)
   in let st6 = st-append-code st5 (li reg-r8 0)
   in let st7 = st-append-code st6 (li reg-r9 0)
   in let st8 = st-append-code st7 (test-rr reg-rcx reg-rcx)
   in let empty-pos = st8.code-len
   in let st9 = st-append-code st8 (jcc cc-e 0)
   in let st10 = st-append-code st9 (movzx-byte reg-rdx reg-rdi 0)
   in let st11 = st-append-code st10 (cmp-ri reg-rdx 73)
   in let not-minus-pos = st11.code-len
   in let st12 = st-append-code st11 (jcc cc-ne 0)
   in let st13 = st-append-code st12 (li reg-rsi 1)
   in let st14 = st-append-code st13 (add-ri reg-r11 1)
   in let st15 = patch-jcc-at st14 not-minus-pos (st14.code-len)
   in HelpResult1 {
    cg = st15,
    p1 = empty-pos
   }

  emit-text-to-double-parse : CodegenState -> CodegenState
  emit-text-to-double-parse (st) =
    let parse-loop = st.code-len
   in let st0 = st-append-code st (cmp-rr reg-r11 reg-rcx)
   in let parse-done-pos = st0.code-len
   in let st1 = st-append-code st0 (jcc cc-ge 0)
   in let st2 = st-append-code st1 (mov-rr reg-rdx reg-rdi)
   in let st3 = st-append-code st2 (add-rr reg-rdx reg-r11)
   in let st4 = st-append-code st3 (movzx-byte reg-rdx reg-rdx 0)
   in let st5 = st-append-code st4 (cmp-ri reg-rdx 65)
   in let not-dot-pos = st5.code-len
   in let st6 = st-append-code st5 (jcc cc-ne 0)
   in let st7 = st-append-code st6 (li reg-r9 1)
   in let st8 = st-append-code st7 (add-ri reg-r11 1)
   in let st9 = st-append-code st8 (jmp (parse-loop - (st8.code-len + 5)))
   in let st10 = patch-jcc-at st9 not-dot-pos (st9.code-len)
   in let st11 = st-append-code st10 (sub-ri reg-rdx 3)
   in let st12 = st-append-code st11 (push-r reg-rdx)
   in let st13 = st-append-code st12 (mov-rr reg-rdx reg-rax)
   in let st14 = st-append-code st13 (shl-ri reg-rax 3)
   in let st15 = st-append-code st14 (add-rr reg-rax reg-rdx)
   in let st16 = st-append-code st15 (add-rr reg-rax reg-rdx)
   in let st17 = st-append-code st16 (pop-r reg-rdx)
   in let st18 = st-append-code st17 (add-rr reg-rax reg-rdx)
   in let st19 = st-append-code st18 (add-rr reg-r8 reg-r9)
   in let st20 = st-append-code st19 (add-ri reg-r11 1)
   in let st21 = st-append-code st20 (jmp (parse-loop - (st20.code-len + 5)))
   in patch-jcc-at st21 parse-done-pos (st21.code-len)

  emit-text-to-double : CodegenState -> CodegenState
  emit-text-to-double (st) =
    let setup = emit-text-to-double-setup st
   in let st0 = emit-text-to-double-parse (setup.cg)
   in let st1 = st-append-code st0 (test-rr reg-rsi reg-rsi)
   in let no-neg-pos = st1.code-len
   in let st2 = st-append-code st1 (jcc cc-e 0)
   in let st3 = st-append-code st2 (neg-r reg-rax)
