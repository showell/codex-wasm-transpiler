    is otherwise -> False

  is-grounds-keyword : TokenKind -> Boolean
  is-grounds-keyword (k) =
   when k
    is GroundsKeyword -> True
    is otherwise -> False

  is-quotes-keyword : TokenKind -> Boolean
  is-quotes-keyword (k) =
   when k
    is QuotesKeyword -> True
    is otherwise -> False

  is-trusting-keyword : TokenKind -> Boolean
  is-trusting-keyword (k) =
   when k
    is TrustingKeyword -> True
    is otherwise -> False

  is-above-keyword : TokenKind -> Boolean
  is-above-keyword (k) =
   when k
    is AboveKeyword -> True
    is otherwise -> False

  is-where-keyword : TokenKind -> Boolean
  is-where-keyword (k) =
   when k
    is WhereKeyword -> True
    is otherwise -> False

  is-in-keyword : TokenKind -> Boolean
  is-in-keyword (k) =
   when k
    is InKeyword -> True
    is otherwise -> False

  is-between-keyword : TokenKind -> Boolean
  is-between-keyword (k) =
   when k
    is BetweenKeyword -> True
    is otherwise -> False

  is-else-keyword : TokenKind -> Boolean
  is-else-keyword (k) =
   when k
