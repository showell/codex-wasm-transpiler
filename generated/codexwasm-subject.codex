   in let st26 = st-append-code st25 (mov-store reg-rbx reg-rcx 0)
   in let st27 = st-append-code st26 (mov-rr reg-rax reg-rcx)
   in let st28 = st-append-code st27 (add-ri reg-rax 15)
   in let st29 = st-append-code st28 (and-ri reg-rax (-8))
   in let st30 = heap-bump-reg st29 reg-rax
   in let st31 = st-append-code st30 (mov-rr reg-rax reg-r10)
   in let st32 = st-append-code st31 (li reg-rdi 0)
   in let st33 = st-append-code st32 (mov-store reg-rax reg-rdi 0)
